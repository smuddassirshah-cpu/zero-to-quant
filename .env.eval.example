# The eval environment (docs/AI-TUTOR.md 9; docs/PLAN.md 7.1): a separate key, token and signing key that
# work only against the eval proxy on 127.0.0.1. Copy to .env.eval on the owner's machine only; never in CI.
ANTHROPIC_API_KEY=replace-me
TUTOR_TOKEN=replace-me
CALL_SIGNING_KEY=replace-me
MODEL=claude-opus-5-5
JUDGE_MODEL=replace-me
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_INFLIGHT=4
MAX_PER_MINUTE=60
MAX_PER_DAY=2000
MAX_USD_DAY=60
MAX_USD_MONTH=500
