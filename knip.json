{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/entries/*.ts", "src/html/*.html", "vite.config.ts"],
      "project": ["src/**/*.ts", "*.config.{ts,js}"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    }
  },
  "vite": false,
  "ignoreBinaries": ["uv"]
}
