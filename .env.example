# Build-time variables for the app (Vite inlines every VITE_* value into the bundle, so none is secret;
# CI fails any VITE_* name containing KEY, TOKEN or SECRET). Copy to .env, which git ignores.
VITE_BASE=/
VITE_ZQ_TUTOR_URL=http://127.0.0.1:8787
VITE_ZQ_WEB_APP_URL=http://localhost:5173

# Local Node tutor proxy (npm run proxy:local, from stage 62). Dummy values only.
ANTHROPIC_API_KEY=replace-me
TUTOR_TOKEN=replace-me
CALL_SIGNING_KEY=replace-me
MODEL=claude-opus-5-5
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_INFLIGHT=2
MAX_PER_MINUTE=20
MAX_PER_DAY=600
MAX_USD_DAY=3
MAX_USD_MONTH=30
