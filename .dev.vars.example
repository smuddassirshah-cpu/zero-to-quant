# Local secrets for `wrangler dev` (from stage 62). Copy to .dev.vars, which git ignores.
# Deployed Workers take these as secrets through `wrangler secret put`, never from a file.
ANTHROPIC_API_KEY=replace-with-your-key
TUTOR_TOKEN=replace-with-43-or-more-base64url-characters
CALL_SIGNING_KEY=replace-with-32-random-bytes-base64url
