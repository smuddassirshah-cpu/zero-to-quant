{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": ["dist/**", "prototype/**", "spikes/**", "coverage/**", "node_modules/**", ".claude/**"],
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "function-disallowed-list": [
      "rgb",
      "rgba",
      "hsl",
      "hsla",
      "hwb",
      "lab",
      "lch",
      "oklab",
      "oklch",
      "color",
      "color-mix",
      "light-dark",
      "contrast-color",
      "device-cmyk"
    ],
    "function-url-scheme-disallowed-list": ["data"],
    "declaration-property-value-disallowed-list": {
      "/^(color|.+-color|background|background-image|border|border-(top|right|bottom|left|block|inline)(-(start|end))?|outline|fill|stroke|box-shadow|text-shadow|text-decoration|column-rule|filter|--.+)$/": [
        "/(^|[\\s,(])(canvas|canvastext|linktext|visitedtext|activetext|buttonface|buttontext|buttonborder|buttonshadow|buttonhighlight|field|fieldtext|highlight|highlighttext|selecteditem|selecteditemtext|mark|marktext|graytext|accentcolor|accentcolortext|activeborder|activecaption|appworkspace|background|captiontext|inactiveborder|inactivecaption|inactivecaptiontext|infobackground|infotext|menu|menutext|scrollbar|threeddarkshadow|threedface|threedhighlight|threedlightshadow|threedshadow|window|windowframe|windowtext|-webkit-[a-z-]+|-moz-[a-z-]+)(?=$|[\\s,)])/i"
      ]
    }
  },
  "overrides": [
    {
      "files": ["src/styles/tokens.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null,
        "declaration-property-value-disallowed-list": null,
        "function-url-scheme-disallowed-list": null
      }
    }
  ],
  "reportNeedlessDisables": true,
  "reportDescriptionlessDisables": true,
  "reportInvalidScopeDisables": true
}
