{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": ["dist/**", "prototype/**", "spikes/**", "coverage/**", "node_modules/**", ".claude/**"],
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "function-disallowed-list": [
      "rgb",
      "rgba",
      "hsl",
      "hsla",
      "hwb",
      "lab",
      "lch",
      "oklab",
      "oklch",
      "color",
      "color-mix",
      "light-dark",
      "contrast-color",
      "device-cmyk"
    ],
    "function-url-scheme-disallowed-list": ["data"],
    "declaration-property-value-disallowed-list": {
      "/.*/": [
        "/\\b(canvas|canvastext|linktext|visitedtext|activetext|buttonface|buttontext|buttonborder|field|fieldtext|highlight|highlighttext|selecteditem|selecteditemtext|mark|marktext|graytext|accentcolor|accentcolortext)\\b/i"
      ]
    }
  },
  "overrides": [
    {
      "files": ["src/styles/tokens.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null,
        "declaration-property-value-disallowed-list": null,
        "function-url-scheme-disallowed-list": null
      }
    }
  ],
  "reportNeedlessDisables": true,
  "reportDescriptionlessDisables": true,
  "reportInvalidScopeDisables": true
}
