 "cpp-mean-ranks": [
  {
   "test": {
    "call": "[]{ std::vector<int> s(100000); for (int i = 0; i < 100000; ++i) s[i] = (i * 7919) % 1000; std::vector<double> r = mean_ranks(s); return std::vector<double>{r[0], r[1], r[99999]}; }()",
    "expect": [
     50.5,
     91950.5,
     8150.5
    ],
    "compare": "isclose"
   },
   "fails": [
    "leq_comparator",
    "quadratic"
   ]
  },
  {
   "test": {
    "call": "[]{ std::vector<double> r = mean_ranks(std::vector<int>(3000, 7)); return std::vector<double>{r[0], r[2999]}; }()",
    "expect": [
     1500.5,
     1500.5
    ],
    "compare": "isclose"
   },
   "fails": [
    "leq_comparator"
   ]
  }
 ],
