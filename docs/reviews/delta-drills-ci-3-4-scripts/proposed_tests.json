   "expect": "[1, 0, 0, 0]",
   "compare": "equal"
  },
  {
   "call": "(lambda r: (len(r), sum(r), r.count(-1)))(find_in_ring([10000 * ((i + 61729) % 100000) for i in range(100000)], [(i * 104729) % 1000000000 for i in range(100000)]))",
   "expect": "(100000, 5053688078, 1)",
   "compare": "equal"
  }
 ],
