    "expect": "6",
    "group": "small",
    "second": "exhaustive method"
   },
   {
    "call": "count_products_below([7, 8], 1)",
    "expect": "0",
    "group": "small",
    "second": "exhaustive method"
   },
   {
    "call": "count_products_below([2, 3, 4], 100)",
    "expect": "6",
    "group": "small",
    "second": "exhaustive method"
   },
