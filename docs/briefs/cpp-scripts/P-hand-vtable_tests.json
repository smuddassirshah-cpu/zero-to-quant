{
 "prelude": "",
 "tests": [
  {
   "call": "value_of(&c, 110.0)",
   "expect": 10.0,
   "setup": "Payoff c = make_call(100);"
  },
  {
   "call": "value_of(&c, 90.0)",
   "expect": 0.0,
   "setup": "Payoff c = make_call(100);"
  },
  {
   "call": "value_of(&p, 90.0)",
   "expect": 10.0,
   "setup": "Payoff p = make_put(100);"
  },
  {
   "call": "value_of(&p, 110.0)",
   "expect": 0.0,
   "setup": "Payoff p = make_put(100);"
  },
  {
   "call": "value_of(&d, 101.0)",
   "expect": 1.0,
   "setup": "Payoff d = make_digital(100);"
  },
  {
   "call": "value_of(&d, 100.0)",
   "expect": 0.0,
   "setup": "Payoff d = make_digital(100);"
  },
  {
   "call": "value_of(&c, 100.0)",
   "expect": 20.0,
   "setup": "Payoff c = make_call(80);"
  },
  {
   "call": "a.table == b.table",
   "expect": true,
   "setup": "Payoff a = make_call(100); Payoff b = make_call(90);"
  },
  {
   "call": "a.table != b.table",
   "expect": true,
   "setup": "Payoff a = make_call(100); Payoff b = make_put(100);"
  },
  {
   "call": "total",
   "expect": 6.0,
   "setup": "Payoff c = make_call(100); Payoff p = make_put(100); Payoff d = make_digital(100); const Payoff* book[3] = {&c, &p, &d}; double total = 0.0; for (const Payoff* x : book) total += value_of(x, 105.0);"
  },
  {
   "call": "value_of(&d, 99.0)",
   "expect": 0.0,
   "setup": "Payoff d = make_digital(100);"
  }
 ],
 "alloc": true,
 "leak": true
}