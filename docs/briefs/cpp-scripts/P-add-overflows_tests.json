{
 "prelude": "#include <climits>\n",
 "tests": [
  {
   "call": "add_overflows(INT_MAX, 1)",
   "expect": true
  },
  {
   "call": "add_overflows(INT_MAX, 0)",
   "expect": false
  },
  {
   "call": "add_overflows(INT_MIN, -1)",
   "expect": true
  },
  {
   "call": "add_overflows(INT_MIN, 0)",
   "expect": false
  },
  {
   "call": "add_overflows(2000000000, 2000000000)",
   "expect": true
  },
  {
   "call": "add_overflows(1000, 2000)",
   "expect": false
  },
  {
   "call": "add_overflows(-2000000000, -2000000000)",
   "expect": true
  },
  {
   "call": "add_overflows(INT_MAX, -1)",
   "expect": false
  },
  {
   "call": "add_overflows(INT_MIN, 1)",
   "expect": false
  },
  {
   "call": "add_overflows(1073741824, 1073741824)",
   "expect": true
  },
  {
   "call": "add_overflows(1073741823, 1073741824)",
   "expect": false
  },
  {
   "call": "add_overflows(INT_MAX, INT_MAX)",
   "expect": true
  },
  {
   "call": "add_overflows(INT_MIN, INT_MIN)",
   "expect": true
  }
 ]
}