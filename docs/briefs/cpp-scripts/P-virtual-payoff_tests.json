{
 "prelude": "#include <type_traits>\n",
 "tests": [
  {
   "call": "book_value(book, 110.0)",
   "expect": 10.0,
   "setup": "Call c(100); Put p(100); std::vector<const Payoff*> book{&c, &p};"
  },
  {
   "call": "book_value(book, 90.0)",
   "expect": 10.0,
   "setup": "Call c(100); Put p(100); std::vector<const Payoff*> book{&c, &p};"
  },
  {
   "call": "book_value(book, 110.0)",
   "expect": 15.0,
   "setup": "Call c1(100); Call c2(105); std::vector<const Payoff*> book{&c1, &c2};"
  },
  {
   "call": "book_value(book, 80.0)",
   "expect": 20.0,
   "setup": "Put p(100); std::vector<const Payoff*> book{&p};"
  },
  {
   "call": "book_value(book, 100.0)",
   "expect": 0.0,
   "setup": "Put p(100); Call c(100); std::vector<const Payoff*> book{&p, &c};"
  },
  {
   "call": "r.value(130.0)",
   "expect": 30.0,
   "setup": "Call c(100); const Payoff& r = c;"
  },
  {
   "call": "std::has_virtual_destructor_v<Payoff>",
   "expect": true
  },
  {
   "call": "std::is_abstract_v<Payoff>",
   "expect": true
  },
  {
   "call": "std::is_abstract_v<Call>",
   "expect": false
  },
  {
   "call": "std::is_polymorphic_v<Put>",
   "expect": true
  },
  {
   "compiles": "Payoff p(100);",
   "expect": false
  }
 ]
}