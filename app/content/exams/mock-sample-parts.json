      "parts": [
        {
          "question": "Write `spread(xs)`: the largest value minus the smallest.",
          "widget": {
            "kind": "code",
            "language": "python",
            "starter": "def spread(xs):\n    \"\"\"Return the largest value minus the smallest.\"\"\"\n    return 0\n",
            "examples": [
              {
                "call": "spread([3, 9, 5])",
                "expect": "6",
                "compare": "isclose"
              }
            ],
            "tests": [
              {
                "call": "spread([3, 9, 5])",
                "expect": "6",
                "compare": "isclose"
              },
              {
                "call": "spread([4])",
                "expect": "0",
                "compare": "isclose"
              },
              {
                "call": "spread([-2, 2])",
                "expect": "4",
                "compare": "isclose"
              },
              {
                "call": "spread([1.5, 0.5])",
                "expect": "1.0",
                "compare": "isclose"
              }
            ],
            "how": "Submit runs 4 hidden tests.",
            "solution": "def spread(xs):\n    return max(xs) - min(xs)\n"
          },
          "feedback": {
            "correct": "All four tests pass.",
            "generic": "A hidden test failed."
          }
        },
        {
          "question": "What is `spread([2, 8, 5])`?",
          "widget": {
            "kind": "numeric",
            "answer": 6,
            "tol": {
              "abs": 0
            },
            "placeholder": "a number"
          },
          "feedback": {
            "correct": "8 - 2 is 6.",
            "generic": "Take the largest minus the smallest."
          }
        },
        {
          "question": "Now skip `None`, and return `0` when nothing is left.",
          "widget": {
            "kind": "code",
            "language": "python",
            "starter": "def spread(xs):\n    # Part 1 reference. Now skip None, and return 0 when nothing is left.\n    return max(xs) - min(xs)\n",
            "examples": [
              {
                "call": "spread([1, None, 7])",
                "expect": "6",
                "compare": "isclose"
              }
            ],
            "tests": [
              {
                "call": "spread([1, None, 7])",
                "expect": "6",
                "compare": "isclose"
              },
              {
                "call": "spread([])",
                "expect": "0",
                "compare": "isclose"
              },
              {
                "call": "spread([None])",
                "expect": "0",
                "compare": "isclose"
              }
            ],
            "how": "Submit runs the 3 tests of this part and the 4 of part 1, 7 in all.",
            "solution": "def spread(xs):\n    kept = [x for x in xs if x is not None]\n    return max(kept) - min(kept) if kept else 0\n"
