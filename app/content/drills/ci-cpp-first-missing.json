      "args": [
        [
          3,
          4,
          -1,
          1
        ]
      ],
      "types": [
        "std::vector<int>"
      ],
      "expect": 2,
      "compare": "equal",
      "note": "The numbers 1, 3 and 4 are present, and 2 is the smallest positive missing."
    },
    {
      "call": "first_missing_positive",
      "args": [
