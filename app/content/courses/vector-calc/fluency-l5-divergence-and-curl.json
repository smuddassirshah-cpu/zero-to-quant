{
  "id": "fluency-l5-divergence-and-curl",
  "lesson": "l5-divergence-and-curl",
  "title": "Fluency: divergence and curl",
  "n": 20,
  "pass": 0.9,
  "minutes": 12,
  "families": [
    {
      "id": "divergence",
      "weight": 2,
      "skill": "find the divergence of a planar field",
      "vars": {
        "a": { "int": [-5, 5], "not": [0] },
        "b": { "int": [-5, 5], "not": [0] },
        "c": { "int": [-5, 5], "not": [0] },
        "d": { "int": [-5, 5], "not": [0] }
      },
      "let": {
        "a2": "2*a",
        "d2": "2*d",
        "b2": "-2*b"
      },
      "prompt": "Take $\\mathbf F = ({a:c}x^2y{b:+c}y^2,\\ {c:c}x{d:+c}y^2)$. Find $\\nabla \\cdot \\mathbf F$.",
      "widget": { "kind": "expression", "answer": "{a2}xy{d2:+}y", "keyboard": "calculus" },
      "wrong": [
        { "id": "curl-instead", "tex": "{mono(x; -a, 2)}{b2:+}y{c:+}", "line": "That is the curl, $Q_x - P_y$. The divergence is $P_x + Q_y$." },
        { "id": "stopped-at-px", "tex": "{a2}xy", "line": "You stopped at $P_x$. Add $Q_y = {d2}y$." }
      ],
      "solution": [
        "$P_x = {a2}xy$ and $Q_y = {d2}y$.",
        "So $\\nabla \\cdot \\mathbf F = {a2}xy{d2:+}y$."
      ]
    },
    {
      "id": "curl",
      "weight": 2,
      "skill": "find the curl of a planar field",
      "vars": {
        "a": { "int": [-5, 5], "not": [0] },
        "b": { "int": [-5, 5], "not": [0] },
        "c": { "int": [-5, 5], "not": [0] },
        "d": { "int": [-5, 5], "not": [0] }
      },
      "let": {
        "c2": "2*c",
        "a2": "2*a",
        "d2": "2*d"
      },
      "prompt": "Take $\\mathbf F = ({a:c}x^2y{b:+c}x,\\ {c:c}x^2{d:+c}y^2)$. Find $\\operatorname{{curl}}\\mathbf F = Q_x - P_y$.",
      "widget": { "kind": "expression", "answer": "{c2}x{-a:+c}x^2", "keyboard": "calculus" },
      "wrong": [
        { "id": "reversed", "tex": "{-c2}x{a:+c}x^2", "line": "You took $P_y - Q_x$. The curl is $Q_x - P_y$." },
        { "id": "divergence-instead", "tex": "{a2}xy{b:+}{d2:+}y", "line": "That is the divergence. The curl takes $Q_x - P_y$." }
      ],
      "solution": [
        "$Q_x = {c2}x$ and $P_y = {mono(x; a, 2)}$.",
        "So $\\operatorname{{curl}}\\mathbf F = {c2}x{-a:+c}x^2$."
      ]
    },
    {
      "id": "at-a-point",
      "weight": 1,
      "skill": "evaluate divergence or curl at a point",
      "vars": {
        "qq": { "pick": [["div", "\\nabla \\cdot \\mathbf F"], ["curl", "\\operatorname{curl}\\mathbf F"]], "as": ["w", "qt"] },
        "a": { "int": [-3, 3], "not": [0] },
        "b": { "int": [-3, 3], "not": [0] },
        "c": { "int": [-5, 5], "not": [0] },
        "d": { "int": [-3, 3], "not": [0] },
        "x0": { "int": [-3, 3], "not": [0] },
        "y0": { "int": [-3, 3], "not": [0] }
      },
      "let": {
        "dv": "2*a*x0*y0 + 2*d*y0",
        "cu": "c - a*x0^2 - 2*b*y0",
        "key": "if(w == 'div', 2*a*x0*y0 + 2*d*y0, c - a*x0^2 - 2*b*y0)",
        "other": "if(w == 'div', c - a*x0^2 - 2*b*y0, 2*a*x0*y0 + 2*d*y0)"
      },
      "prompt": "Take $\\mathbf F = ({a:c}x^2y{b:+c}y^2,\\ {c:c}x{d:+c}y^2)$. Find ${qt}$ at $({x0}, {y0})$.",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0 }, "placeholder": "For example -3" },
      "wrong": [
        { "id": "other-quantity", "value": "{other}", "line": "That is the other quantity. Divergence is $P_x + Q_y$; curl is $Q_x - P_y$.", "when": "other != key" },
        { "id": "curl-reversed", "value": "{-cu}", "line": "You took $P_y - Q_x$. The curl is $Q_x - P_y$.", "when": "w == 'curl' and cu != 0 and other != -cu" }
      ],
      "solution": [
        "The divergence is ${2*a}xy{2*d:+}y$ and the curl is ${mono(x; -a, 2)}{-2*b:+}y{c:+}$.",
        "At $({x0}, {y0})$: ${qt} = {key}$."
      ]
    },
    {
      "id": "curl-in-space",
      "weight": 1,
      "skill": "find a curl in space at a point",
      "vars": {
        "a": { "int": [-3, 3], "not": [0] },
        "b": { "int": [-3, 3], "not": [0] },
        "c": { "int": [-3, 3], "not": [0] },
        "d": { "int": [-2, 2], "not": [0] },
        "x0": { "int": [-3, 3], "not": [0] },
        "y0": { "int": [-3, 3], "not": [0] },
        "z0": { "int": [-3, 3], "not": [0] }
      },
      "let": {
        "e": "2*d - c",
        "u": "-b*y0",
        "m": "(2*d - c)*z0",
        "w": "-a*x0",
        "d2": "2*d"
      },
      "where": ["2*d - c != 0", "a*x0 != b*y0"],
      "prompt": "Take $\\mathbf F = ({a:c}xy{d:+c}z^2,\\ {b:c}yz,\\ {c:c}zx)$. Find $\\nabla \\times \\mathbf F$ at $({x0}, {y0}, {z0})$, as three components.",
      "widget": { "kind": "expression", "answer": "({u}, {m}, {w})", "keyboard": "algebra" },
      "wrong": [
        { "id": "each-reversed", "tex": "({-u}, {-m}, {-w})", "line": "Each entry is a difference in a fixed order: $R_y - Q_z$, $P_z - R_x$, $Q_x - P_y$." },
        { "id": "order-reversed", "tex": "({w}, {m}, {u})", "line": "You put the entries in the wrong order. The first is $R_y - Q_z$, from the $yz$ plane." }
      ],
      "solution": [
        "$R_y - Q_z = {mono(y; -b, 1)}$, $P_z - R_x = {d2}z{-c:+c}z = {mono(z; e, 1)}$ and $Q_x - P_y = {mono(x; -a, 1)}$.",
        "At $({x0}, {y0}, {z0})$ the curl is $({u}, {m}, {w})$."
      ]
    }
  ]
}
