{
  "id": "fluency-l2-back-substitution",
  "course": "elimination",
  "lesson": "l2-back-substitution",
  "title": "Fluency: back substitution",
  "n": 20,
  "pass": 0.9,
  "minutes": 15,
  "families": [
    {
      "id": "bottom-up",
      "weight": 2,
      "skill": "solve an upper triangular system from the bottom up",
      "vars": {
        "a": { "int": [-3, 3], "not": [0] },
        "b": { "int": [-3, 3], "not": [0] },
        "c": { "int": [-3, 3], "not": [0] },
        "e": { "int": [-3, 3], "not": [0] },
        "f": { "int": [-3, 3], "not": [0] },
        "g": { "int": [-4, 4], "not": [0] },
        "x0": { "int": [-4, 4], "not": [0] },
        "y0": { "int": [-4, 4], "not": [0] },
        "z0": { "int": [-4, 4], "not": [0] }
      },
      "let": {
        "r1": "a*x0 + b*y0 + c*z0",
        "r2": "e*y0 + f*z0",
        "r3": "g*z0",
        "fz": "f*z0",
        "known": "b*y0 + c*z0",
        "ax": "a*x0",
        "ys": "(e*y0 + 2*f*z0)/e",
        "xs": "(a*x0 + b*y0 + c*z0 - b*(e*y0 + 2*f*z0)/e - c*z0)/a"
      },
      "where": ["known != 0", "abs(r1) <= 30", "abs(r2) <= 20"],
      "prompt": "Solve ${a:c}x{b:+c}y{c:+c}z = {r1}$, ${e:c}y{f:+c}z = {r2}$ and ${g:c}z = {r3}$ by back substitution, giving $(x, y, z)$.",
      "widget": { "kind": "expression", "answer": "({x0}, {y0}, {z0})", "keyboard": "algebra" },
      "wrong": [
        { "id": "pivot-not-divided", "tex": "({ax}, {y0}, {z0})", "line": "You found ${a:c}x = {ax}$ and stopped. Divide by the pivot ${a}$.", "when": "a != 1" },
        { "id": "found-order", "tex": "({z0}, {y0}, {x0})", "line": "You listed the values in the order you found them. The answer is $(x, y, z)$, with $x$ first.", "when": "x0 != z0" },
        { "id": "sign-not-changed", "tex": "({xs:frac}, {ys:frac}, {z0})", "line": "In row 2, moving ${fz}$ across the equals sign changes its sign." }
      ],
      "solution": [
        "Row 3: ${g:c}z = {r3}$, so $z = {z0}$.",
        "Row 2: ${e:c}y{fz:+} = {r2}$, so $y = {y0}$.",
        "Row 1: ${a:c}x{known:+} = {r1}$, so $x = {x0}$. The solution is $({x0}, {y0}, {z0})$."
      ]
    },
    {
      "id": "top-down",
      "weight": 1,
      "skill": "solve a lower triangular system from the top down",
      "vars": {
        "a": { "int": [-3, 3], "not": [0] },
        "b": { "int": [-3, 3], "not": [0] },
        "c": { "int": [-3, 3], "not": [0] },
        "e": { "int": [-3, 3], "not": [0] },
        "f": { "int": [-3, 3], "not": [0] },
        "g": { "int": [-3, 3], "not": [0] },
        "x0": { "int": [-4, 4], "not": [0] },
        "y0": { "int": [-4, 4], "not": [0] },
        "z0": { "int": [-4, 4], "not": [0] }
      },
      "let": {
        "r1": "a*x0",
        "r2": "b*x0 + e*y0",
        "r3": "c*x0 + f*y0 + g*z0",
        "bx": "b*x0",
        "known": "c*x0 + f*y0",
        "gz": "g*z0",
        "ys": "(b*x0 + e*y0 + b*x0)/e",
        "zs": "(c*x0 + f*y0 + g*z0 - c*x0 - f*(b*x0 + e*y0 + b*x0)/e)/g"
      },
      "where": ["known != 0", "abs(r2) <= 20", "abs(r3) <= 30"],
      "prompt": "Solve ${a:c}x = {r1}$, ${b:c}x{e:+c}y = {r2}$ and ${c:c}x{f:+c}y{g:+c}z = {r3}$ from the top down, giving $(x, y, z)$.",
      "widget": { "kind": "expression", "answer": "({x0}, {y0}, {z0})", "keyboard": "algebra" },
      "wrong": [
        { "id": "pivot-not-divided", "tex": "({x0}, {y0}, {gz})", "line": "You found ${g:c}z = {gz}$ and stopped. Divide by the pivot ${g}$.", "when": "g != 1" },
        { "id": "sign-not-changed", "tex": "({x0}, {ys:frac}, {zs:frac})", "line": "In row 2, moving ${bx}$ across the equals sign changes its sign." }
      ],
      "solution": [
        "Row 1 has one unknown: ${a:c}x = {r1}$, so $x = {x0}$.",
        "Row 2: ${bx}{e:+c}y = {r2}$, so $y = {y0}$.",
        "Row 3: ${known}{g:+c}z = {r3}$, so $z = {z0}$. The solution is $({x0}, {y0}, {z0})$."
      ]
    }
  ]
}
