{
  "id": "fluency-l6-undoing-in-reverse",
  "course": "equations",
  "lesson": "l6-undoing-in-reverse",
  "title": "Fluency: undoing in reverse",
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "multiply-then-add",
      "weight": 2,
      "skill": "solve a two-step equation",
      "vars": {
        "a": { "int": [2, 9] },
        "x0": { "int": [-9, 9], "not": [0] },
        "b": { "int": [-15, 15], "not": [0] },
        "v": { "pick": ["x", "n", "y", "t"] }
      },
      "let": { "c": "a*x0 + b", "ax": "a*x0" },
      "prompt": "Solve ${a}{v}{b:+} = {c}$.",
      "widget": { "kind": "numeric", "answer": "{x0}", "tol": { "abs": 0 }, "label": "{v}", "placeholder": "use − for below zero" },
      "wrong": [
        { "id": "divided-first", "value": "{c/a - b}", "tol": { "abs": 0.01 }, "line": "Clear the ${b:+}$ before you divide; dividing first must reach every term." },
        { "id": "sign-of-number", "value": "{(c + b)/a}", "tol": { "abs": 0.01 }, "line": "Undo ${b:+}$ with its opposite, ${-b:+}$, on both sides." }
      ],
      "solution": [
        "Undo the ${b:+}$ first: ${a}{v} = {c} {-b:+} = {ax}$.",
        "Then divide by ${a}$: ${v} = {ax} \\div {a} = {x0}$."
      ]
    },
    {
      "id": "divide-then-add",
      "weight": 1,
      "skill": "solve a two-step equation with a fraction",
      "vars": {
        "a": { "int": [2, 6] },
        "m": { "int": [-9, 9], "not": [0] },
        "b": { "int": [-9, 9], "not": [0] },
        "v": { "pick": ["x", "n", "y", "t"] }
      },
      "let": { "x0": "a*m", "c": "m + b" },
      "prompt": "Solve $\\dfrac{{{v}}}{{{a}}} {b:+} = {c}$.",
      "widget": { "kind": "numeric", "answer": "{x0}", "tol": { "abs": 0 }, "label": "{v}", "placeholder": "use − for below zero" },
      "wrong": [
        { "id": "multiplied-first", "value": "{a*c - b}", "tol": { "abs": 0.01 }, "line": "Clear the ${b:+}$ before you multiply by ${a}$; the last step done comes off first." },
        { "id": "divided-instead", "value": "{(c - b)/a}", "tol": { "abs": 0.01 }, "line": "The ${v}$ is divided by ${a}$, so undo it by multiplying by ${a}$." }
      ],
      "solution": [
        "Undo the ${b:+}$ first: $\\dfrac{{{v}}}{{{a}}} = {c} {-b:+} = {m}$.",
        "Then multiply by ${a}$: ${v} = {a} \\times {m:()} = {x0}$."
      ]
    }
  ]
}
