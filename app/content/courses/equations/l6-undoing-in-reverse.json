          "s1": {
            "tex": "5x = 25",
            "ops": [
              {
                "label": "Divide both sides by 5",
                "to": "s2"
              },
              {
                "label": "Subtract 5 from both sides",
                "to": "m3",
                "why": "$5x$ means 5 times $x$. Undo a multiplication by dividing."
              }
            ]
          },
          "m1": {
            "tex": "x - \\tfrac{7}{5} = \\tfrac{18}{5}",
            "ops": [
              {
                "label": "Add $\\tfrac{7}{5}$ to both sides",
                "to": "m1b"
