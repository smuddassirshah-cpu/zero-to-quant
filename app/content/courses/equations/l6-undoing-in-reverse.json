        "target": "s2",
        "states": {
          "s0": {
            "tex": "5x - 7 = 18",
            "ops": [
              {
                "label": "Add 7 to both sides",
                "to": "s1"
              },
              {
                "label": "Divide both sides by 5",
                "to": "m1",
                "why": "Dividing first leaves fractions: $x - \\tfrac{7}{5} = \\tfrac{18}{5}$. Clear the $-7$ first, then divide."
