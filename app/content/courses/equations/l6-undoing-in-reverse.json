            ]
          },
          "m1b": {
            "tex": "x = \\tfrac{25}{5}",
            "ops": [
              {
                "label": "Simplify the fraction",
                "to": "s2"
              }
            ]
          },
          "m2": {
            "tex": "5x - 14 = 11"
          },
          "m3": {
            "tex": "5x - 5 = 20"
          },
          "s2": {
            "tex": "x = 5"
          }
        }
