{
  "id": "fluency-l7-unknowns-both-sides",
  "course": "equations",
  "lesson": "l7-unknowns-both-sides",
  "title": "Fluency: unknowns on both sides",
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "bracket-one-side",
      "skill": "solve with the unknown on both sides",
      "vars": {
        "c": { "int": [1, 4] },
        "k": { "int": [2, 4] },
        "b": { "int": [-6, 6], "not": [0] },
        "x0": { "int": [-6, 6], "not": [0] },
        "v": { "pick": ["x", "n", "y", "t"] }
      },
      "let": { "a": "c + k", "ab": "a*b", "d": "a*(x0 + b) - c*x0", "rhs": "d - a*b" },
      "where": ["d != 0", "abs(d) <= 40"],
      "prompt": "Solve ${a}({v}{b:+}) = {c:c}{v}{d:+}$.",
      "widget": { "kind": "numeric", "answer": "{x0}", "tol": { "abs": 0 }, "label": "{v}", "placeholder": "use − for below zero" },
      "wrong": [
        { "id": "bracket-first-term", "value": "{(d - b)/(a - c)}", "tol": { "abs": 0.01 }, "line": "The ${a}$ multiplies the ${b}$ as well: ${a}({v}{b:+}) = {poly(v; a, ab)}$." },
        { "id": "added-unknown", "value": "{(d - a*b)/(a + c)}", "tol": { "abs": 0.01 }, "line": "Take ${c:c}{v}$ from both sides; adding it does not clear it from the right." }
      ],
      "solution": [
        "Expand the bracket: ${poly(v; a, ab)} = {poly(v; c, d)}$.",
        "Collect the ${v}$ terms on the left and the numbers on the right: ${k}{v} = {rhs}$.",
        "So ${v} = {rhs} \\div {k} = {x0}$."
      ]
    },
    {
      "id": "brackets-both-sides",
      "skill": "solve with brackets on both sides",
      "vars": {
        "a": { "int": [2, 4] },
        "k": { "int": [2, 3] },
        "m": { "pick": [-1, 1, 2] },
        "x0": { "int": [-5, 6], "not": [0] },
        "v": { "pick": ["x", "n", "y", "t"] }
      },
      "let": { "c": "a + k", "b": "c*m - x0", "d": "a*m - x0", "ab": "a*b", "cd": "c*d", "lhs": "a*b - c*d" },
      "where": ["b != 0", "d != 0", "abs(b) <= 12", "abs(d) <= 12", "b - d != a*b - c*d", "b - d != a*b + c*d"],
      "prompt": "Solve ${a}({v}{b:+}) = {c}({v}{d:+})$.",
      "widget": { "kind": "numeric", "answer": "{x0}", "tol": { "abs": 0 }, "label": "{v}", "placeholder": "use − for below zero" },
      "wrong": [
        { "id": "bracket-first-term", "value": "{(b - d)/(c - a)}", "tol": { "abs": 0.01 }, "line": "Each outside number multiplies its whole bracket: ${a}({v}{b:+}) = {poly(v; a, ab)}$." },
        { "id": "number-sign-kept", "value": "{(a*b + c*d)/(c - a)}", "tol": { "abs": 0.01 }, "line": "When ${cd:+}$ moves to the left it becomes ${-cd:+}$." }
      ],
      "solution": [
        "Expand both brackets: ${poly(v; a, ab)} = {poly(v; c, cd)}$.",
        "Collect the ${v}$ terms on the right, where there are more, and the numbers on the left: ${lhs} = {k}{v}$.",
        "So ${v} = {lhs} \\div {k} = {x0}$."
      ]
    }
  ]
}
