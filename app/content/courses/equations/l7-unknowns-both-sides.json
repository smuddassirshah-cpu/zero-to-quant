      "question": "Solve $6x - 5 = 2x + 11$.",
      "widget": {
        "kind": "manipulate",
        "start": "s0",
        "target": "s3",
        "states": {
          "s0": {
            "tex": "6x - 5 = 2x + 11",
            "ops": [
              {
                "label": "Subtract $2x$ from both sides",
                "to": "s1"
              },
              {
                "label": "Add $2x$ to both sides",
                "to": "m1",
                "why": "Adding $2x$ puts more $x$ on both sides. Subtract $2x$ to clear it from the right."
              },
              {
                "label": "Subtract $2x$ from the right side only",
                "to": "m2",
                "why": "You changed one side only, so the sides no longer balance. Take $2x$ from the left too."
              }
            ]
          },
          "s1": {
            "tex": "4x - 5 = 11",
            "ops": [
              {
                "label": "Add 5 to both sides",
                "to": "s2"
              },
              {
                "label": "Divide both sides by 4",
                "to": "m3",
                "why": "Dividing first leaves fractions. Clear the $-5$ first."
              }
            ]
          },
          "s2": {
            "tex": "4x = 16",
            "ops": [
              {
                "label": "Divide both sides by 4",
                "to": "s3"
              }
            ]
          },
          "m3": {
            "tex": "x - \\tfrac{5}{4} = \\tfrac{11}{4}",
            "ops": [
              {
                "label": "Add $\\tfrac{5}{4}$ to both sides",
                "to": "m3b"
              }
            ]
          },
          "m3b": {
            "tex": "x = \\tfrac{16}{4}",
            "ops": [
              {
                "label": "Simplify the fraction",
                "to": "s3"
              }
            ]
          },
          "m1": {
            "tex": "8x - 5 = 4x + 11"
          },
          "m2": {
            "tex": "6x - 5 = 11"
          },
          "s3": {
            "tex": "x = 4"
          }
        }
      },
      "hints": [
