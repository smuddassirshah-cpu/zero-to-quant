      "type": "problem",
      "difficulty": 3,
      "prose": "Brackets on both sides: $3(x + 4) = 5(x - 2)$. Open them first, then collect the unknowns.",
      "question": "Solve $3(x + 4) = 5(x - 2)$.",
      "widget": {
        "kind": "manipulate",
        "start": "s0",
        "target": "s4",
        "states": {
          "s0": {
            "tex": "3(x + 4) = 5(x - 2)",
            "ops": [
              {
                "label": "Expand both brackets",
                "to": "s1"
              },
              {
                "label": "Expand as $3x + 4$ and $5x - 2$",
                "to": "m1",
                "why": "You multiplied only the first term in each bracket. The 3 multiplies the 4 too, and the 5 multiplies the 2."
              }
            ]
          },
          "s1": {
            "tex": "3x + 12 = 5x - 10",
            "ops": [
              {
                "label": "Subtract $3x$ from both sides",
                "to": "s2"
              },
              {
                "label": "Subtract $5x$ from both sides",
                "to": "t2"
              }
            ]
          },
          "s2": {
            "tex": "12 = 2x - 10",
            "ops": [
              {
                "label": "Add 10 to both sides",
                "to": "s3"
              }
            ]
          },
          "s3": {
            "tex": "22 = 2x",
            "ops": [
              {
                "label": "Divide both sides by 2",
                "to": "s4"
              }
            ]
          },
          "t2": {
            "tex": "-2x + 12 = -10",
            "ops": [
              {
                "label": "Subtract 12 from both sides",
                "to": "t3"
              }
            ]
          },
          "t3": {
            "tex": "-2x = -22",
            "ops": [
              {
                "label": "Divide both sides by $-2$",
                "to": "s4"
              }
            ]
          },
          "m1": {
            "tex": "3x + 4 = 5x - 2",
            "ops": [
              {
                "label": "Subtract $3x$ from both sides",
                "to": "m2"
              }
            ]
          },
          "m2": {
            "tex": "4 = 2x - 2",
            "ops": [
              {
                "label": "Add 2 to both sides",
                "to": "m3"
              }
            ]
          },
          "m3": {
            "tex": "6 = 2x",
            "ops": [
              {
                "label": "Divide both sides by 2",
                "to": "m4"
              }
            ]
          },
          "m4": {
            "tex": "x = 3",
            "why": "Check $x = 3$: $3(3 + 4) = 21$ but $5(3 - 2) = 5$. Start over and expand fully."
          },
          "s4": {
            "tex": "x = 11"
          }
        }
      },
      "hints": [
        {
          "rung": "nudge",
          "text": "What does the 3 outside the bracket multiply?"
        },
        {
          "rung": "point",
          "text": "Expand each bracket fully: the 3 multiplies both $x$ and 4."
        },
        {
          "rung": "step",
          "text": "$3x + 12 = 5x - 10$. Subtract $3x$: $12 = 2x - 10$. Add 10: $22 = 2x$, so $x = 11$."
        }
      ],
      "feedback": {
        "correct": "$x = 11$. Both sides are 45.",
        "generic": "Not quite right. Expand both brackets fully, then collect the $x$ terms."
      },
      "explain": {
        "text": "Expanding gave $3x + 12 = 5x - 10$. Subtracting $3x$ kept the $x$ term positive: $22 = 2x$, so $x = 11$. Check: $3 \\times 15 = 45$ and $5 \\times 9 = 45$."
      }
