{
  "id": "fluency-l2-like-terms",
  "course": "equations",
  "lesson": "l2-like-terms",
  "title": "Fluency: collecting like terms",
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "collect-one-letter",
      "skill": "collect like terms",
      "vars": {
        "a": { "int": [1, 9] },
        "b": { "int": [-9, 9], "not": [0] },
        "c": { "int": [-9, 9], "not": [0] },
        "d": { "int": [-9, 9], "not": [0] },
        "v": { "pick": ["x", "n", "y", "t", "m"] }
      },
      "let": { "k": "a + c", "r": "b + d", "all": "a + b + c + d" },
      "where": ["k != 0", "r != 0", "all != 0"],
      "prompt": "Simplify ${a:c}{v}{b:+}{c:+c}{v}{d:+}$.",
      "widget": { "kind": "expression", "answer": "{poly(v; k, r)}", "form": "simplified", "keyboard": "algebra" },
      "wrong": [
        { "id": "flipped-sign", "tex": "{poly(v; a - c, r)}", "line": "A sign belongs to the term after it, so that term is ${c:+c}{v}$." },
        { "id": "combined-all", "tex": "{poly(v; all, 0)}", "line": "You added the number terms to the ${v}$ terms; they are not like terms." }
      ],
      "solution": [
        "The ${v}$ terms: ${a:c}{v} {c:+c}{v} = {poly(v; k, 0)}$.",
        "The numbers: ${b} {d:+} = {r}$.",
        "So the expression simplifies to ${poly(v; k, r)}$."
      ]
    }
  ]
}
