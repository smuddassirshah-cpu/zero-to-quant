{
  "id": "fluency-l13-changing-the-subject",
  "course": "equations",
  "lesson": "l13-changing-the-subject",
  "title": "Fluency: changing the subject",
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "subject-from-linear",
      "skill": "rearrange a linear formula",
      "vars": {
        "a": { "int": [2, 9] },
        "b": { "int": [-9, 9], "not": [0] },
        "u": { "pick": ["y", "C", "P", "W"] },
        "v": { "pick": ["x", "n", "t", "m"] }
      },
      "prompt": "Make ${v}$ the subject of ${u} = {a}{v}{b:+}$.",
      "widget": { "kind": "expression", "answer": "\\frac{{{u}{-b:+}}}{{{a}}}", "accept": ["({u}{-b:+})/{a}"], "keyboard": "algebra" },
      "wrong": [
        { "id": "divided-one-term", "tex": "\\frac{{{u}}}{{{a}}}{-b:+}", "line": "Undo the ${b:+}$ first, then divide the whole of ${u}{-b:+}$ by ${a}$." },
        { "id": "sign-kept", "tex": "\\frac{{{u}{b:+}}}{{{a}}}", "line": "Undo ${b:+}$ with its opposite: ${-b:+}$ on both sides." }
      ],
      "solution": [
        "Undo the ${b:+}$ first: ${u}{-b:+} = {a}{v}$.",
        "Then divide both sides by ${a}$: ${v} = \\dfrac{{{u}{-b:+}}}{{{a}}}$."
      ]
    },
    {
      "id": "subject-from-product",
      "skill": "rearrange a product formula",
      "vars": {
        "a": { "int": [2, 9] },
        "u": { "pick": ["V", "A", "I", "F"] },
        "v": { "pick": ["b", "k", "r", "p"] },
        "w": { "pick": ["h", "t", "n", "m"] }
      },
      "prompt": "Make ${w}$ the subject of ${u} = {a}{v}{w}$.",
      "widget": { "kind": "expression", "answer": "\\frac{{{u}}}{{{a}{v}}}", "accept": ["{u}/({a}{v})"], "keyboard": "algebra" },
      "wrong": [
        { "id": "upside-down", "tex": "\\frac{{{a}{v}}}{{{u}}}", "line": "${w}$ is multiplied by ${a}{v}$, so divide ${u}$ by ${a}{v}$, with ${u}$ on top." },
        { "id": "number-left", "tex": "\\frac{{{u}}}{{{v}}}", "line": "Divide by the ${a}$ as well as by ${v}$." }
      ],
      "solution": [
        "${w}$ is multiplied by ${a}$ and by ${v}$, so divide both sides by ${a}{v}$.",
        "That gives ${w} = \\dfrac{{{u}}}{{{a}{v}}}$."
      ]
    },
    {
      "id": "subject-from-bottom",
      "skill": "rearrange when the letter is on the bottom",
      "vars": {
        "a": { "int": [2, 9] },
        "u": { "pick": ["s", "R", "P", "M"] },
        "v": { "pick": ["k", "q", "b", "c"] },
        "w": { "pick": ["t", "h", "n", "r"] }
      },
      "prompt": "Make ${w}$ the subject of ${u} = \\dfrac{{{a}{v}}}{{{w}}}$.",
      "widget": { "kind": "expression", "answer": "\\frac{{{a}{v}}}{{{u}}}", "accept": ["{a}{v}/{u}"], "keyboard": "algebra" },
      "wrong": [
        { "id": "upside-down", "tex": "\\frac{{{u}}}{{{a}{v}}}", "line": "Multiply both sides by ${w}$ first: ${u}{w} = {a}{v}$. Then divide by ${u}$." },
        { "id": "multiplied", "tex": "{a}{u}{v}", "line": "After ${u}{w} = {a}{v}$, divide by ${u}$ to free ${w}$; do not multiply." }
      ],
      "solution": [
        "Multiply both sides by ${w}$ to lift it off the bottom: ${u}{w} = {a}{v}$.",
        "Then divide both sides by ${u}$: ${w} = \\dfrac{{{a}{v}}}{{{u}}}$."
      ]
    }
  ]
}
