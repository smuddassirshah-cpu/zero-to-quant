  "items": [
    {
      "id": "r1-reverse-slope",
      "difficulty": 2,
      "skills": [
        "rq-stats"
      ],
      "tags": [
        "two-regressions"
      ],
      "pace": 60,
      "prose": "$s_x = 2$, $s_y = 3$ and $r = 0.6$.",
      "question": "What is the least squares slope of $x$ on $y$?",
      "widget": {
        "kind": "numeric",
        "answer": 0.4,
        "tol": {
          "abs": 0.0005
        },
        "placeholder": "a number",
        "accept": "0.4",
        "wrong": [
          {
            "id": "swapped",
            "value": 0.9,
            "tol": {
              "abs": 0.0005
            }
          },
          {
            "id": "reciprocal",
            "value": 1.1111,
            "tol": {
              "abs": 0.0005
            }
          }
        ]
      },
      "feedback": {
        "correct": "0.4.",
        "generic": "Not quite right. Use $r\\,s_x/s_y$.",
        "byKey": {
          "swapped": "You gave the slope of $y$ on $x$, $0.6 \\times 3/2$. The reverse flips the spreads.",
          "reciprocal": "You inverted 0.9. The reverse slope is $r\\,s_x/s_y$, not $1/b_{y\\mid x}$."
        }
      },
      "explain": {
        "text": "$b_{x\\mid y} = 0.6 \\times 2/3 = 0.4$. With $b_{y\\mid x} = 0.9$ the product is $0.36 = r^2$."
      }
    },
    {
      "id": "r1-slopes-then-copies",
      "difficulty": 3,
      "skills": [
        "rq-stats"
      ],
      "tags": [
        "duplicated-data",
        "two-regressions"
      ],
      "pace": 120,
      "prose": "An analyst fits $y$ on $x$ and then $x$ on $y$. Three follow-ups.",
      "parts": [
        {
          "question": "The two slopes are 0.5 and 1.2. What is $|r|$?",
          "widget": {
            "kind": "numeric",
            "answer": 0.7746,
            "tol": {
              "abs": 0.0005
            },
            "placeholder": "a number",
            "accept": "0.7746 ± 0.0005",
            "wrong": [
              {
                "id": "noroot",
                "value": 0.6,
                "tol": {
                  "abs": 0.0005
                }
              }
            ]
          },
          "feedback": {
            "correct": "$\\sqrt{0.6} = 0.7746$.",
            "generic": "Not quite right. The slopes multiply to $r^2$.",
            "byKey": {
              "noroot": "You stopped at $r^2 = 0.6$. Take the square root."
            }
          },
          "explain": {
            "text": "$0.5 \\times 1.2 = 0.6 = r^2$, so $|r| = 0.7746$."
          }
        },
        {
          "question": "Then every row of the file is written twice. Select all that apply: which of these change?",
          "widget": {
            "kind": "multi",
            "layout": "stack",
            "options": [
              {
                "id": "se",
                "text": "The standard error",
                "correct": true
              },
              {
                "id": "t",
                "text": "The $t$ statistic",
                "correct": true
              },
              {
                "id": "slope",
                "text": "The fitted slope",
                "why": "Every point is copied, so the best line is the same line."
              },
              {
                "id": "r2",
                "text": "$R^2$ of the fit",
                "why": "Both sums of squares double, so their ratio stays put."
              }
            ],
            "shuffle": true
          },
          "feedback": {
            "correct": "The standard error falls and $t$ rises; the fit stays the same.",
            "generic": "Not quite right. Copies move no point.",
            "byKey": {
              "slope": "Copied points give the same best line, so the slope does not change."
            }
          },
          "explain": {
            "text": "The slope and $R^2$ are unchanged, since every point is merely copied. The standard error shrinks, because the software counts twice the rows. So $t$ rises with no new evidence."
          }
        },
        {
          "question": "The file had $n = 20$ rows before copying. What is the new standard error over the old?",
          "widget": {
            "kind": "numeric",
            "answer": 0.6882,
            "tol": {
              "abs": 0.0005
            },
            "placeholder": "a number",
            "accept": "0.6882 ± 0.0005",
            "wrong": [
              {
                "id": "half",
                "value": 0.7071,
                "tol": {
                  "abs": 0.0005
                }
              },
              {
                "id": "same",
                "value": 1,
                "tol": {
                  "abs": 0
                }
              }
            ]
          },
          "feedback": {
            "correct": "$\\sqrt{18/38} = 0.6882$.",
            "generic": "Not quite right. Track the residual degrees of freedom.",
            "byKey": {
              "half": "You halved the variance and ignored the degrees of freedom. They go from 18 to 38.",
              "same": "The slope stays put, but its standard error shrinks."
            }
          },
          "explain": {
            "text": "The ratio is $\\sqrt{(n - 2)/(2n - 2)} = \\sqrt{18/38} = 0.6882$. The doubled residual sum is divided by 38, and $S_{xx}$ doubles."
          }
        }
      ]
    },
    {
      "id": "r1-floor-06-08",
      "difficulty": 3,
      "skills": [
        "rq-stats",
        "rq-linalg"
      ],
      "tags": [
        "correlation-bounds"
      ],
      "pace": 45,
      "prose": "corr$(X, Y) = 0.6$ and corr$(Y, Z) = 0.8$.",
      "question": "What is the smallest possible corr$(X, Z)$?",
      "widget": {
        "kind": "numeric",
        "answer": 0,
        "tol": {
          "abs": 0.0005
        },
        "placeholder": "a number",
        "accept": "0",
        "wrong": [
          {
            "id": "product",
            "value": 0.48,
            "tol": {
              "abs": 0.0005
            }
          }
        ]
      },
      "feedback": {
        "correct": "0.",
        "generic": "Not quite right. Take the half-width off the product.",
        "byKey": {
          "product": "You gave the product, the centre of the range. Subtract $\\sqrt{0.64 \\times 0.36} = 0.48$."
        }
      },
      "explain": {
        "text": "$0.48 - \\sqrt{(1 - 0.36)(1 - 0.64)} = 0.48 - 0.48 = 0$. So corr$(X, Z)$ lies in $[0, 0.96]$."
      }
    },
    {
      "id": "r1-valid-triples",
      "difficulty": 3,
      "skills": [
        "rq-stats",
        "rq-linalg"
      ],
      "tags": [
        "psd-check"
      ],
      "pace": 75,
      "question": "Select all that apply. Which triples (corr $XY$, corr $YZ$, corr $XZ$) can be a correlation matrix?",
      "widget": {
        "kind": "multi",
        "layout": "stack",
        "options": [
          {
            "id": "a",
            "text": "(0.9, 0.9, 0.7)",
            "correct": true
          },
          {
            "id": "b",
            "text": "(0.9, 0.9, 0.5)",
            "why": "With 0.9 and 0.9 the floor is 0.62, so 0.5 is too low. Its determinant is $-0.06$."
          },
          {
            "id": "c",
            "text": "(0.9, $-0.9$, $-0.7$)",
            "correct": true
          },
          {
            "id": "d",
            "text": "(0.6, 0.6, 0.1)",
            "correct": true
          },
          {
            "id": "e",
            "text": "(0.6, 0.6, $-0.3$)",
            "why": "With 0.6 and 0.6 the floor is $0.36 - 0.64 = -0.28$, so $-0.3$ is too low."
          }
        ],
        "shuffle": true
      },
      "feedback": {
        "correct": "Three of them.",
        "generic": "Not quite right. Compare each third value with $ab \\pm \\sqrt{(1 - a^2)(1 - b^2)}$."
      },
      "explain": {
        "text": "The determinants are 0.024, $-0.06$, 0.024, 0.342 and $-0.026$. The two negative ones fail. Each failure sits just below its floor."
      }
    },
    {
      "id": "r1-cap-from-max",
      "difficulty": 3,
      "skills": [
        "rq-stats"
      ],
      "tags": [
        "max-of-uniform"
      ],
      "pace": 45,
      "prose": "Nine draws are uniform on 0 to $\\theta$. The largest is 8.1.",
      "question": "What is the unbiased estimate of $\\theta$?",
      "widget": {
        "kind": "numeric",
        "answer": 9,
        "tol": {
          "abs": 0.005
        },
        "placeholder": "a number",
        "accept": "9",
        "wrong": [
          {
            "id": "plugin",
            "value": 8.1,
            "tol": {
              "abs": 0.005
            }
          },
          {
            "id": "down",
            "value": 7.2,
            "tol": {
              "abs": 0.01
            }
          }
        ]
      },
      "feedback": {
        "correct": "9.0.",
        "generic": "Not quite right. Multiply by $(n + 1)/n$.",
        "byKey": {
          "plugin": "You gave the largest draw itself. It is biased low.",
          "down": "You scaled down by $8/9$. Scale up by $10/9$."
        }
      },
      "explain": {
        "text": "$8.1 \\times 10/9 = 9.0$."
      }
    },
    {
      "id": "r1-best-divisor",
      "difficulty": 3,
      "skills": [
        "rq-stats"
      ],
      "tags": [
        "variance-divisor"
      ],
      "pace": 45,
      "question": "Fifteen normal draws. Which divisor of the sum of squared deviations gives the smallest mean squared error?",
      "widget": {
        "kind": "numeric",
        "answer": 16,
        "tol": {
          "abs": 0
        },
        "placeholder": "a number",
        "accept": "16",
        "wrong": [
          {
            "id": "unbiased",
            "value": 14,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "n",
            "value": 15,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "16, which is $n + 1$.",
        "generic": "Not quite right. Bias squared plus variance is smallest at $n + 1$.",
        "byKey": {
          "unbiased": "That is the unbiased divisor. Its MSE is the largest of the three: 0.1429.",
          "n": "Dividing by $n$ gives 0.1289, but $n + 1$ gives 0.125."
        }
      },
      "explain": {
        "text": "The MSEs for 14, 15 and 16 are 0.1429, 0.1289 and 0.125. A little bias buys a larger fall in variance."
      }
    },
    {
      "id": "r1-twenty-tests",
      "difficulty": 3,
      "skills": [
        "rq-stats"
      ],
      "tags": [
        "multiple-testing"
      ],
      "pace": 45,
      "question": "Fifteen independent tests at 5%, and no real effect anywhere. What is the chance of at least one false positive?",
      "widget": {
        "kind": "numeric",
        "answer": 0.5367,
        "tol": {
          "abs": 0.0005
        },
        "placeholder": "a number",
        "accept": "0.5367 ± 0.0005",
        "wrong": [
          {
            "id": "sum",
            "value": 0.75,
            "tol": {
              "abs": 0.0005
            }
          },
          {
            "id": "one",
            "value": 0.05,
            "tol": {
              "abs": 0.0005
            }
          }
        ]
      },
      "feedback": {
        "correct": "About 0.5367.",
        "generic": "Not quite right. Use $1 - 0.95^{15}$.",
        "byKey": {
          "sum": "You added fifteen chances of 5%. That counts overlaps twice.",
          "one": "That is one test. Fifteen looks pile up."
        }
      },
      "explain": {
        "text": "$1 - 0.95^{15} = 0.5367$. Bonferroni would test each at $0.05/15 = 0.0033$."
      }
    },
    {
      "id": "r1-bh-count",
      "difficulty": 3,
      "skills": [
        "rq-stats"
      ],
      "tags": [
        "multiple-testing"
      ],
      "pace": 60,
      "prose": "Five p-values: 0.001, 0.011, 0.014, 0.038 and 0.3.",
      "question": "How many does Benjamini-Hochberg reject at 5%?",
      "widget": {
        "kind": "numeric",
        "answer": 4,
        "tol": {
          "abs": 0
        },
        "placeholder": "a number",
        "accept": "4",
        "wrong": [
          {
            "id": "bonf",
            "value": 1,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "holm",
            "value": 3,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "all",
            "value": 5,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "4.",
        "generic": "Not quite right. Find the largest rank $k$ with $p_{(k)} \\le 0.01k$.",
        "byKey": {
          "bonf": "That is Bonferroni: only 0.001 is below 0.01.",
          "holm": "That is Holm: 0.038 is above its bar of 0.025.",
          "all": "Rank 5 needs $p \\le 0.05$, and 0.3 is above it."
        }
      },
      "explain": {
        "text": "The BH bars are 0.01, 0.02, 0.03, 0.04 and 0.05. Rank 4 has $0.038 \\le 0.04$, so the first four are rejected."
      }
    },
    {
      "id": "r1-equicorr-top",
      "difficulty": 3,
      "skills": [
        "rq-linalg"
      ],
      "tags": [
        "equicorrelation"
      ],
      "pace": 45,
      "question": "Six assets have pairwise correlation 0.4. What is the largest eigenvalue of their correlation matrix?",
      "widget": {
        "kind": "numeric",
        "answer": 3,
        "tol": {
          "abs": 0.0005
        },
        "placeholder": "a number",
        "accept": "3",
        "wrong": [
          {
            "id": "one",
            "value": 1.4,
            "tol": {
              "abs": 0.0005
            }
          },
          {
            "id": "nrho",
            "value": 2.4,
            "tol": {
              "abs": 0.0005
            }
          }
        ]
      },
      "feedback": {
        "correct": "3.",
        "generic": "Not quite right. Use $1 + (n - 1)\\rho$.",
        "byKey": {
          "one": "You gave $1 + \\rho$. The all-ones direction collects $n - 1$ correlations.",
          "nrho": "You gave $n\\rho$. Add the diagonal 1 and use $n - 1$."
        }
      },
      "explain": {
        "text": "$1 + 5 \\times 0.4 = 3$. The other five eigenvalues are $1 - 0.4 = 0.6$, and the trace is $3 + 5 \\times 0.6 = 6$."
      }
    },
    {
      "id": "r1-det-rank-one",
      "difficulty": 3,
      "skills": [
        "rq-linalg"
      ],
      "tags": [
        "rank-one"
      ],
      "pace": 45,
      "prose": "$A = I + uu^\\top$, a $4 \\times 4$ matrix, with $u = (2, 1, 2, 4)$.",
      "question": "What is $\\det A$?",
      "widget": {
        "kind": "numeric",
        "answer": 26,
        "tol": {
          "abs": 0
        },
        "placeholder": "a number",
        "accept": "26: eigenvalues 26, 1, 1, 1",
        "wrong": [
          {
            "id": "no-identity",
            "value": 25,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "trace",
            "value": 29,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "26.",
        "generic": "Not quite right. Find the eigenvalues of $uu^\\top$ first, then add 1 to each.",
        "byKey": {
          "no-identity": "You gave $u \\cdot u$, the eigenvalue of $uu^\\top$. The identity adds 1 to it.",
          "trace": "That is the trace, the sum of the eigenvalues. The determinant is their product."
        }
      },
      "explain": {
        "text": "$uu^\\top$ has rank one, with eigenvalue $u \\cdot u = 25$ and three zeros. Adding $I$ gives 26, 1, 1 and 1, whose product is 26."
      }
    }
  ]
