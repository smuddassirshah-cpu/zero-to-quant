    {
      "id": "r1-trie-nodes",
      "difficulty": 2,
      "skills": [
        "ci-patterns"
      ],
      "tags": [
        "trie"
      ],
      "prose": "We insert `car`, `card`, `care`, `cat` and `dog` into an empty trie.",
      "question": "How many nodes does it have, not counting the root?",
      "widget": {
        "kind": "numeric",
        "answer": 9,
        "tol": {
          "abs": 0
        },
        "accept": "9: c, ca, car, card, care, cat, d, do, dog.",
        "label": "Nodes",
        "wrong": [
          {
            "id": "letters",
            "value": 17,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "words",
            "value": 5,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "root",
            "value": 10,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "One node per distinct prefix: 9.",
        "generic": "Not quite right. Count shared beginnings once.",
        "byKey": {
          "letters": "You counted every letter of every word. c, ca and car are shared.",
          "words": "Each word needs a node per letter, minus what it shares.",
          "root": "Leave out the root."
        }
      },
      "explain": {
        "text": "The distinct prefixes are c, ca, car, card, care, cat, d, do and dog. Each is one node. Counting by inserting gives the same 9."
      },
      "pace": 90
    },
    {
      "id": "r1-count-prefix",
      "difficulty": 3,
      "skills": [
        "ci-patterns"
      ],
      "tags": [
        "prefix-count"
      ],
      "prose": "We insert `car`, `card`, `care`, `cat`, `dog` and then `car` again, with counts raised once per new word.",
      "question": "What does `count_prefix('car')` return?",
      "widget": {
        "kind": "numeric",
        "answer": 3,
        "tol": {
          "abs": 0
        },
        "accept": "3: car, card and care; the repeat counts once.",
        "label": "Count",
        "wrong": [
          {
            "id": "repeat",
            "value": 4,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "one",
            "value": 1,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "car, card and care.",
        "generic": "Not quite right. Count distinct words that start with car.",
        "byKey": {
          "repeat": "You counted the second car. Its end mark was already set, so no count changed.",
          "one": "card and care start with car too."
        }
      },
      "explain": {
        "text": "car, card and care pass through the node car. The second car finds its end mark set and adds nothing. So the count is 3."
      },
      "pace": 90
    },
    {
      "id": "r1-window-sum",
      "difficulty": 3,
      "skills": [
        "ci-patterns"
      ],
      "tags": [
        "monotonic-deque"
      ],
      "prose": "Windows of $k = 3$ slide over `[4, 2, 12, 3, 8, 5, 1, 7]`.",
      "canvas": {
        "kind": "array",
        "params": {
          "cells": [
            4,
            2,
            12,
            3,
            8,
            5,
            1,
            7
          ]
        },
        "state": {}
      },
      "question": "What do the window maxima add up to?",
      "widget": {
        "kind": "numeric",
        "answer": 59,
        "tol": {
          "abs": 0
        },
        "accept": "59: the maxima are 12, 12, 12, 8, 8, 7.",
        "label": "Sum",
        "wrong": [
          {
            "id": "all",
            "value": 42,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "five",
            "value": 52,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "$12 + 12 + 12 + 8 + 8 + 7 = 59$.",
        "generic": "Not quite right. There are six windows; take the maximum of each.",
        "byKey": {
          "all": "You added the eight values. Add one maximum per window.",
          "five": "You missed the last window, [5, 1, 7], whose maximum is 7."
        }
      },
      "explain": {
        "text": "12 is in the first three windows. Then [3, 8, 5] and [8, 5, 1] give 8, and [5, 1, 7] gives 7. The sum is 59, by the deque or by slicing."
      },
      "pace": 90
    },
    {
      "id": "r1-deque-size",
      "difficulty": 3,
      "skills": [
        "ci-patterns"
      ],
      "tags": [
        "monotonic-deque"
      ],
      "prose": "Run the max deque of indices on the same list, `[4, 2, 12, 3, 8, 5, 1, 7]`, with $k = 3$.",
      "canvas": {
        "kind": "array",
        "params": {
          "cells": [
            4,
            2,
            12,
            3,
            8,
            5,
            1,
            7
          ]
        },
        "state": {
          "highlight": {
            "range": [
              3,
              5
            ],
            "label": "window ending at 5"
          }
        }
      },
      "question": "How many indices does the deque hold after processing index 5?",
      "widget": {
        "kind": "numeric",
        "answer": 2,
        "tol": {
          "abs": 0
        },
        "accept": "2: indices 4 and 5, values 8 and 5.",
        "label": "Indices",
        "wrong": [
          {
            "id": "three",
            "value": 3,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "one",
            "value": 1,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "Indices 4 and 5 remain: 8, then 5.",
        "generic": "Not quite right. Keep only indices in the window that no later value beats.",
        "byKey": {
          "three": "Index 3 holds 3, which 8 popped off the back at index 4.",
          "one": "5 is smaller than 8 but arrived later, so it stays behind 8."
        }
      },
      "explain": {
        "text": "At index 4, 8 pops 3; index 2 then leaves the window at index 5. At index 5, 5 joins behind 8. Only values that can still win remain: 8 and 5."
      },
      "pace": 90
    },
    {
      "id": "r1-kth-stream",
      "difficulty": 3,
      "skills": [
        "ci-patterns"
      ],
      "tags": [
        "stream-kth"
      ],
      "prose": "`kth_largest_stream(3, [6, 1, 9, 5], [2, 7, 12, 8, 3])` records the 3rd largest after each add.",
      "question": "What is the sum of the five answers?",
      "widget": {
        "kind": "numeric",
        "answer": 34,
        "tol": {
          "abs": 0
        },
        "accept": "34: the answers are 5, 6, 7, 8, 8.",
        "label": "Sum",
        "wrong": [
          {
            "id": "max",
            "value": 54,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "second",
            "value": 40,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "$5 + 6 + 7 + 8 + 8 = 34$.",
        "generic": "Not quite right. After each add, find the 3rd largest of everything so far.",
        "byKey": {
          "max": "You recorded the largest each time. The question asks for the 3rd largest.",
          "second": "You recorded the 2nd largest. Count three down from the top."
        }
      },
      "explain": {
        "text": "The top three go 9, 6, 5, then 9, 7, 6, then 12, 9, 7. After 8 and 3 the 3rd largest is 8. A size-3 heap and re-sorting agree on 5, 6, 7, 8, 8."
      },
      "pace": 90
    },
    {
      "id": "r1-heap-choice",
      "difficulty": 3,
      "skills": [
        "ci-patterns"
      ],
      "tags": [
        "heap-top-k"
      ],
      "prose": "We keep the 3 largest values of a stream.",
      "question": "Which heap, and when do we pop?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "a",
            "text": "A min-heap; pop when its size reaches 4",
            "correct": true
          },
          {
            "id": "b",
            "text": "A max-heap; pop when its size reaches 4",
            "why": "A max-heap's top is the largest value, so popping it drops the best one."
          },
          {
            "id": "c",
            "text": "A min-heap; pop when its size reaches 3",
            "why": "Popping at 3 leaves only 2 values."
          },
          {
            "id": "d",
            "text": "A sorted list, re-sorted after each value",
            "why": "That is correct but costs a sort per value. The heap costs $O(\\log 3)$."
          }
        ],
        "shuffle": true
      },
      "feedback": {
        "correct": "The smallest kept value sits on top and goes when a fourth arrives.",
        "generic": "Not quite right. The popped value must be the smallest of the four."
      },
      "explain": {
        "text": "After each push the heap holds 4 values, and the smallest of them no longer belongs. A min-heap keeps it on top, so one pop removes it. The top is then the 3rd largest."
      },
      "pace": 90
    },
    {
      "id": "r1-and",
      "difficulty": 2,
      "skills": [
        "ci-patterns"
      ],
      "tags": [
        "bit-count"
      ],
      "prose": "108 is 1101100 and 107 is 1101011 in binary.",
      "question": "What is `108 & 107`?",
      "widget": {
        "kind": "numeric",
        "answer": 104,
        "tol": {
          "abs": 0
        },
        "accept": "104: $1101100 \\,\\&\\, 1101011 = 1101000$.",
        "label": "Value",
        "wrong": [
          {
            "id": "or",
            "value": 111,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "xor",
            "value": 7,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "The lowest set bit of 108 is cleared: 104.",
        "generic": "Not quite right. Keep the bits set in both.",
        "byKey": {
          "or": "That is `108 | 107`. AND keeps only the bits set in both.",
          "xor": "That is `108 ^ 107`. AND keeps the shared bits."
        }
      },
      "explain": {
        "text": "`n & (n - 1)` clears the lowest set bit. 108 is 1101100, whose lowest set bit is worth 4. So the result is $108 - 4 = 104$."
      },
      "pace": 90
    },
    {
      "id": "r1-xor",
      "difficulty": 3,
      "skills": [
        "ci-patterns"
      ],
      "tags": [
        "bit-xor"
      ],
      "prose": "`9 ^ 14 ^ 9 ^ 3 ^ 14`",
      "question": "What is it?",
      "widget": {
        "kind": "numeric",
        "answer": 3,
        "tol": {
          "abs": 0
        },
        "accept": "3: the 9s and the 14s cancel.",
        "label": "Value",
        "wrong": [
          {
            "id": "zero",
            "value": 0,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "sum",
            "value": 49,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "Only 3 has no partner.",
        "generic": "Not quite right. Cancel the equal pairs first.",
        "byKey": {
          "zero": "3 appears once, so it survives.",
          "sum": "You added them. XOR cancels equal values."
        }
      },
      "explain": {
        "text": "XOR is order-free, so pair up `9 ^ 9 = 0` and `14 ^ 14 = 0`. What is left is `0 ^ 3 = 3`."
      },
      "pace": 90
    }
  ]
}
