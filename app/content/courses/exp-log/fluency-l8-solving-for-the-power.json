{
  "id": "fluency-l8-solving-for-the-power",
  "course": "exp-log",
  "lesson": "l8-solving-for-the-power",
  "title": "Fluency: solving for the power",
  "n": 20,
  "pass": 0.9,
  "minutes": 15,
  "families": [
    {
      "id": "exact-power",
      "weight": 2,
      "skill": "solve for the power exactly",
      "vars": {
        "a": { "int": [2, 9] },
        "b": { "int": [3, 99] },
        "v": { "pick": ["x", "n", "t"] }
      },
      "let": {
        "la": "ln(a)",
        "lb": "ln(b)",
        "r": "lb/la", "flip": "la/lb", "ratio": "b/a"
      },
      "where": ["abs(r - round(r)) > 0.001", "b > a", "abs(ratio - r) > 0.01"],
      "prompt": "Solve ${a}^{v} = {b}$, giving ${v}$ exactly.",
      "widget": { "kind": "expression", "answer": "\\frac{{\\log {b}}}{{\\log {a}}}", "accept": ["\\frac{{\\ln {b}}}{{\\ln {a}}}", "\\log_{{{a}}} {b}", "\\log_{{{a}}}({b})"], "keyboard": "calculus" },
      "wrong": [
        { "id": "upside-down", "tex": "\\frac{{\\log {a}}}{{\\log {b}}}", "line": "That is upside down: $\\log {b}$, the log of the answer side, goes on top." },
        { "id": "divided-the-numbers", "tex": "{b/a:frac}", "line": "You divided {b} by {a}: take logs first, then divide the logs." }
      ],
      "solution": [
        "Take $\\log$ of both sides: ${v} \\log {a} = \\log {b}$.",
        "Divide by $\\log {a}$: ${v} = \\dfrac{{\\log {b}}}{{\\log {a}}}$."
      ]
    },
    {
      "id": "power-to-3-sf",
      "weight": 2,
      "skill": "solve for the power to 3 significant figures",
      "vars": {
        "a": { "pick": [1.5, 2, 2.5, 3, 4, 5, 6, 7] },
        "b": { "int": [3, 200] },
        "v": { "pick": ["x", "n", "t"] }
      },
      "let": {
        "la": "ln(a)",
        "lb": "ln(b)",
        "r": "lb/la", "flip": "la/lb", "ratio": "b/a",
        "e": "floor(log10(r)) - 2", "m": "r/10^e"
      },
      "where": ["abs(m - round(m)) > 0.01", "abs(ratio - r) > 0.02", "abs(flip - r) > 0.02"],
      "prompt": "Solve ${a}^{v} = {b}$, to 3 significant figures.",
      "widget": { "kind": "numeric", "answer": "{round(r, 6)}", "tol": { "abs": "{0.51*10^e}" }, "placeholder": "a decimal", "accept": "{r:sf3}" },
      "wrong": [
        { "id": "upside-down", "value": "{round(flip, 6)}", "tol": { "abs": "{0.51*10^e}" }, "line": "That is upside down: $\\log {b}$, the log of the answer side, goes on top." },
        { "id": "divided-the-numbers", "value": "{ratio}", "tol": { "abs": "{0.51*10^e}" }, "line": "You divided {b} by {a}: take logs first, then divide the logs." }
      ],
      "solution": [
        "Take $\\log$ of both sides: ${v} \\log {a} = \\log {b}$.",
        "So ${v} = \\dfrac{{\\log {b}}}{{\\log {a}}} = {r:sf3}$ to 3 significant figures."
      ]
    },
    {
      "id": "power-alone-first",
      "weight": 1,
      "skill": "get the power alone, then solve",
      "vars": {
        "c": { "int": [2, 9] },
        "a": { "int": [2, 5] },
        "n": { "int": [2, 6] },
        "v": { "pick": ["x", "n", "t"] }
      },
      "let": {
        "an": "a^n", "d": "c*a^n", "ca": "c*a",
        "ld": "ln(d)",
        "lca": "ln(ca)",
        "joined": "ld/lca"
      },
      "where": ["an <= 625", "c != a", "abs(joined - n) > 0.05"],
      "prompt": "Solve ${c} \\times {a}^{v} = {d}$.",
      "widget": { "kind": "numeric", "answer": "{n}", "tol": { "abs": 0 }, "placeholder": "a whole number" },
      "wrong": [
        { "id": "stopped-early", "value": "{an}", "line": "That is ${a}^{v}$: one more step finds the power ${v}$ itself." },
        { "id": "joined-the-base", "value": "{round(joined, 6)}", "tol": { "abs": 0.01 }, "line": "${c} \\times {a}^{v}$ is not ${ca}^{v}$: divide by {c} first." }
      ],
      "solution": [
        "Divide both sides by {c}: ${a}^{v} = {an}$.",
        "${an} = {a}^{{{n}}}$, so ${v} = {n}$."
      ]
    },
    {
      "id": "money-target",
      "weight": 1,
      "skill": "get the power alone, then solve to 3 significant figures",
      "vars": {
        "p": { "int": [100, 900], "step": 100 },
        "g": { "pick": [1.02, 1.03, 1.04, 1.05, 1.06, 1.08] },
        "q": { "pick": [1.5, 2, 2.5, 3, 4] },
        "v": { "pick": ["n", "t"] }
      },
      "let": {
        "t": "p*q",
        "lq": "ln(q)",
        "lg": "ln(g)",
        "lt": "ln(t)",
        "lpg": "ln(p*g)",
        "r": "lq/lg", "joined": "lt/lpg", "early": "lt/lg",
        "e": "floor(log10(r)) - 2", "m": "r/10^e"
      },
      "where": ["abs(m - round(m)) > 0.01", "abs(joined - r) > 0.2"],
      "prompt": "Solve ${p} \\times {g}^{v} = {t}$, to 3 significant figures.",
      "widget": { "kind": "numeric", "answer": "{round(r, 6)}", "tol": { "abs": "{0.51*10^e}" }, "placeholder": "a decimal", "accept": "{r:sf3}" },
      "wrong": [
        { "id": "joined-the-base", "value": "{round(joined, 6)}", "tol": { "abs": "{0.51*10^e}" }, "line": "${p} \\times {g}^{v}$ is not $({p} \\times {g})^{v}$: divide by {p} first." },
        { "id": "logs-too-soon", "value": "{round(early, 6)}", "tol": { "abs": "{0.51*10^e}" }, "line": "You took logs before getting the power alone: divide by {p} first." }
      ],
      "solution": [
        "Divide both sides by {p}: ${g}^{v} = {q}$.",
        "Take $\\log$ of both sides: ${v} = \\dfrac{{\\log {q}}}{{\\log {g}}} = {r:sf3}$ to 3 significant figures."
      ]
    }
  ]
}
