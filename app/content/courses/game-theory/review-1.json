    {
      "id": "rv1-mix-dominance",
      "difficulty": 3,
      "skills": [
        "gm-normal"
      ],
      "tags": [
        "dominance-mixed"
      ],
      "prose": "Only Ana's payoffs are shown, in £, against Ben's columns L and R.",
      "canvas": {
        "kind": "grid",
        "params": {
          "rows": 3,
          "cols": 2,
          "rowHeads": [
            "U",
            "M",
            "D"
          ],
          "colHeads": [
            "L",
            "R"
          ],
          "rowLabel": "Ana",
          "colLabel": "Ben",
          "cells": [
            [
              "5",
              "0"
            ],
            [
              "0",
              "5"
            ],
            [
              "2",
              "2"
            ]
          ]
        },
        "state": {}
      },
      "question": "Which statement is true?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "a",
            "text": "D is strictly dominated by half U and half M",
            "correct": true
          },
          {
            "id": "b",
            "text": "No row is dominated, since each is best somewhere",
            "why": "You compared rows one at a time. Half U and half M pays 2.5 in each column, more than D's 2."
          },
          {
            "id": "c",
            "text": "D dominates U",
            "why": "D pays 2 against L, less than U's 5."
          },
          {
            "id": "d",
            "text": "D is dominated by U alone",
            "why": "U pays 0 against R, less than D's 2."
          }
        ],
        "shuffle": true
      },
      "feedback": {
        "correct": "Half U and half M pays 2.5 against each column, more than 2.",
        "generic": "Not quite right. Try averaging two rows."
      },
      "explain": {
        "text": "Half U and half M pays $\\tfrac12(5 + 0) = 2.5$ against L and the same against R. D pays 2 in both. So D is strictly dominated by the mix."
      },
      "pace": 60
    },
