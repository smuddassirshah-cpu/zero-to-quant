  "summary": {
    "ideas": [
      "Imagine a crowd, split it by the base rate, then apply each test rate inside its own group.",
      "The chance given a positive is the true positives over all positives: a count over a count.",
      "Choose a crowd big enough, such as 10,000, that every count is whole."
    ],
    "formula": {
      "name": "Bayes in counts",
      "tex": "P(H \\mid E) = \\dfrac{\\#(H \\text{ and } E)}{\\#(H \\text{ and } E) + \\#(\\text{not } H \\text{ and } E)}",
      "note": "The same answer as Bayes' rule, written in people instead of probabilities."
    },
    "trap": "A false-positive rate is a share of the healthy group, not of everyone. Taking it of the whole crowd counts the ill as false alarms."
  },
