      "tol": {
       "abs": 0.0001
      },
      "wrong": [
       {
        "id": "mean",
        "value": 0.6667,
        "tol": {
         "abs": 0.0001
        }
       }
      ]
     },
     "feedback": {
      "correct": "$0.2483 \\times 1 + 0.2483 \\times 0 + 0.5035 \\times 1 \\approx 0.7517$.",
      "generic": "Not quite. Weight the first entries 1, 0, 1.",
      "byKey": {
       "mean": "That is the plain mean of 1, 0, 1. Use the weights."
      }
     },
     "explain": {
      "text": "The first entries of the values are 1, 0, 1, so output 3 starts 0.7517."
     }
    },
    {
     "question": "Token 3 is changed to $(0, 0)$. How many of the three outputs change?",
     "widget": {
