      "kind": "numeric",
      "answer": 0.5035,
      "tol": {
       "abs": 0.0001
      },
      "wrong": [
       {
        "id": "noscale",
        "value": 0.5761,
        "tol": {
         "abs": 0.0001
        }
       },
       {
        "id": "third",
        "value": 0.3333,
        "tol": {
         "abs": 0.0001
        }
       }
      ]
     },
     "feedback": {
      "correct": "Scaled scores 0.7071, 0.7071, 1.4142: weight 0.5035.",
      "generic": "Not quite. Scale the scores $(1, 1, 2)$ by $\\sqrt 2$, then softmax.",
      "byKey": {
       "noscale": "You left out the $\\sqrt 2$.",
       "third": "The scores differ, so the weights do."
      }
     },
     "explain": {
      "text": "$e^{1.4142}/(2e^{0.7071} + e^{1.4142}) = 0.5035$; keys 1 and 2 get 0.2483 each."
