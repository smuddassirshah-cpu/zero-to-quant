        "value": 0.5,
        "tol": {
         "abs": 0.0001
        }
       }
      ]
     },
     "feedback": {
      "correct": "Scores $0$ and $1/\\sqrt 2$: $1/(1 + e^{0.7071}) = 0.3302$.",
      "generic": "Not quite. Query 2 sees keys 1 and 2 only.",
      "byKey": {
       "nomask": "You let key 3 in. It is in the future of query 2.",
       "half": "The two scores differ."
      }
     },
     "explain": {
      "text": "Query 2 scores 0 against key 1 and 0.7071 against itself; the mask removes key 3. Weights 0.3302 and 0.6698."
     }
    },
    {
     "question": "What weight does query 3 put on itself? Give 4 decimal places.",
