   "id": "r-cosh",
   "difficulty": 4,
   "skills": [
    "de-second"
   ],
   "tags": [
    "char-roots"
   ],
   "prose": "Take $y'' - 4y = 0$ with $y(0) = 1$, $y'(0) = 0$.",
   "question": "What is $y(1)$, to 4 decimal places?",
   "widget": {
    "kind": "numeric",
    "answer": 3.7622,
    "tol": {
     "abs": 0.0005
    },
    "accept": "3.7622: $y = \\tfrac12(e^{2t} + e^{-2t})$",
    "wrong": [
     {
      "id": "e2",
      "value": 7.3891,
      "tol": {
       "abs": 0.0005
      }
     },
     {
      "id": "cos",
      "value": -0.4161,
      "tol": {
       "abs": 0.0005
      }
     }
    ]
   },
   "feedback": {
    "correct": "Roots $\\pm 2$; $c_1 = c_2 = \\tfrac12$, so $y(1) = \\cosh 2 = 3.7622$.",
    "generic": "Not quite right. The roots of $r^2 - 4$ are $\\pm 2$.",
    "byKey": {
     "e2": "You kept only $e^{2t}$. $y'(0) = 0$ needs equal parts of $e^{2t}$ and $e^{-2t}$.",
     "cos": "You treated it as $y'' + 4y = 0$. The sign gives real roots."
    }
   },
   "explain": {
    "text": "$y = \\tfrac12(e^{2t} + e^{-2t}) = \\cosh 2t$, and $\\cosh 2 = 3.7622$."
   }
  }
 ]
