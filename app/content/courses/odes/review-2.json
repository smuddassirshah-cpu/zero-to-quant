  {
   "id": "r-overshoot",
   "difficulty": 4,
   "skills": [
    "de-second"
   ],
   "tags": [
    "damping"
   ],
   "prose": "A second-order filter has $\\zeta = 0.5$.",
   "question": "By what percentage does its step response overshoot, to 2 decimal places?",
   "widget": {
    "kind": "numeric",
    "answer": 0.163,
    "tol": {
     "abs": 5e-05
    },
    "accept": "16.30%: $e^{-0.5\\pi/\\sqrt{0.75}}$",
    "unit": "%",
    "wrong": [
     {
      "id": "half",
      "value": 0.5,
      "tol": {
       "abs": 5e-05
      }
     },
     {
      "id": "q",
      "value": 0.4443,
      "tol": {
       "abs": 5e-05
      }
     }
    ]
   },
   "feedback": {
    "correct": "$0.5\\pi/0.8660 = 1.8138$ and $e^{-1.8138} = 16.30\\%$.",
    "generic": "Not quite right. Use $e^{-\\zeta\\pi/\\sqrt{1 - \\zeta^2}}$.",
    "byKey": {
     "half": "You took $1 - \\zeta$. The overshoot is exponential.",
     "q": "That is for $\\zeta = 0.25$."
    }
   },
   "explain": {
    "text": "$e^{-0.5\\pi/\\sqrt{0.75}} = 16.30\\%$: half the damping ratio of critical overshoots by about a sixth."
   }
  },
