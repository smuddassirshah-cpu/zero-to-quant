  {
   "id": "r-companion",
   "difficulty": 2,
   "skills": [
    "de-systems"
   ],
   "tags": [
    "companion"
   ],
   "prose": "Write $y'' + 4y' + 3y = 0$ as $\\mathbf{x}' = \\mathbf{A}\\mathbf{x}$ with $\\mathbf{x} = (y, y')$.",
   "question": "What is $\\mathbf{A}$?",
   "widget": {
    "kind": "expression",
    "answer": "\\begin{pmatrix}0&1\\\\-3&-4\\end{pmatrix}",
    "accept": [
     "[[0,1],[-3,-4]]"
    ],
    "wrong": [
     {
      "id": "sign",
      "tex": "\\begin{pmatrix}0&1\\\\3&4\\end{pmatrix}"
     },
     {
      "id": "swap",
      "tex": "\\begin{pmatrix}0&1\\\\-4&-3\\end{pmatrix}"
     }
    ],
    "keyboard": "algebra"
   },
   "feedback": {
    "correct": "Row 2 is $(-q, -p) = (-3, -4)$.",
    "generic": "Not quite right. Row 1 is $(0, 1)$; row 2 solves the equation for $y''$.",
    "byKey": {
     "sign": "Moving $4y' + 3y$ across flips the signs.",
     "swap": "The first entry multiplies $x_1 = y$, so it is $-3$."
    }
   },
   "explain": {
    "text": "$y'' = -3y - 4y'$, so $\\mathbf{A} = \\begin{pmatrix}0&1\\\\-3&-4\\end{pmatrix}$, with eigenvalues $-1$ and $-3$."
   }
  },
  {
   "id": "r-weights",
   "difficulty": 3,
   "skills": [
    "de-systems"
   ],
   "tags": [
    "eigen-solution"
   ],
   "prose": "$\\mathbf{A}$ has eigenvectors $(1, 1)$ and $(1, -1)$, and $\\mathbf{x}(0) = (3, 1)$.",
   "question": "What is $c_1$, the weight on $(1, 1)$?",
   "widget": {
    "kind": "numeric",
    "answer": 2,
    "tol": {
     "abs": 0.001
    },
    "accept": "2: $c_1 + c_2 = 3$, $c_1 - c_2 = 1$",
    "wrong": [
     {
      "id": "x0",
      "value": 3,
      "tol": {
       "abs": 0.001
      }
     },
     {
      "id": "c2",
      "value": 1,
      "tol": {
       "abs": 0.001
      }
     }
    ]
   },
   "feedback": {
    "correct": "Adding the rows: $2c_1 = 4$, so $c_1 = 2$ and $c_2 = 1$.",
    "generic": "Not quite right. Solve $c_1(1, 1) + c_2(1, -1) = (3, 1)$.",
    "byKey": {
     "x0": "You took $\\mathbf{c} = \\mathbf{x}(0)$. The eigenvectors are not the axes.",
     "c2": "That is $c_2$."
    }
   },
   "explain": {
    "text": "$(3, 1) = 2(1, 1) + 1(1, -1)$, so $c_1 = 2$."
   }
  },
