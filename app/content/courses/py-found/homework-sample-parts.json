          "abs": 0.0005
        },
        "placeholder": "a number",
        "unit": "£"
      },
      "feedback": {
        "correct": "45p is £0.45.",
        "generic": "Subtract, then divide by 100."
      },
      "explain": {
        "text": "410 - 365 is 45 pence, which is £0.45."
      }
    },
    {
