  "items": [
    {
      "id": "h-stats-parts",
      "difficulty": 3,
      "skills": [
        "pf-functions"
      ],
      "prose": "```python\nxs = [3, 5, 10]\n```",
      "question": "Three follow-ups on the list.",
      "parts": [
        {
          "question": "What is `sum(xs)`?",
          "widget": {
            "kind": "numeric",
            "answer": 18,
            "tol": {
              "abs": 0
            },
            "placeholder": "a number"
          },
          "feedback": {
            "correct": "3 + 5 + 10 is 18.",
            "generic": "Add all three items."
          },
          "explain": {
            "text": "The items add to 18."
          }
        },
        {
          "question": "Which expression gives the mean?",
          "widget": {
            "kind": "choice",
            "layout": "stack",
            "options": [
              {
                "id": "div",
                "text": "`sum(xs) / len(xs)`",
                "correct": true
              },
              {
                "id": "floor",
                "text": "`sum(xs) // len(xs)`",
                "why": "Floor division gives 6 and drops the fraction."
              },
              {
                "id": "fixed",
                "text": "`sum(xs) / 2`",
                "why": "It divides by 2, not by the three items."
              }
            ]
          },
          "feedback": {
            "correct": "Divide the sum by the length.",
            "generic": "Not quite right. The mean divides by the number of items."
          },
          "explain": {
            "text": "True division keeps the fraction: 18 / 3 is 6.0."
          }
        },
        {
          "question": "Select all that apply. Which of these give a list with the same items?",
          "widget": {
            "kind": "multi",
            "options": [
              {
                "id": "copy",
                "text": "`xs.copy()`",
                "correct": true
              },
              {
                "id": "slice",
                "text": "`xs[:]`",
                "correct": true
              },
              {
                "id": "rev",
                "text": "`xs[::-1]`",
                "why": "It reverses the order."
              },
              {
                "id": "pop",
                "text": "`xs[1:]`",
                "why": "It drops the first item."
              }
            ]
          },
          "feedback": {
            "correct": "A copy and a full slice keep every item in order.",
            "generic": "Not quite right. Which calls keep every item in order?"
          },
          "explain": {
            "text": "Both `copy` and a full slice return a new list with every item."
          }
        }
      ]
    },
    {
      "id": "h-mean-code",
      "difficulty": 4,
      "skills": [
        "pf-functions"
      ],
      "question": "A live round on one function.",
      "parts": [
        {
          "question": "Write `mean(xs)`, the mean of a list of numbers.",
          "widget": {
            "kind": "code",
            "language": "python",
            "starter": "def mean(xs):\n    \"\"\"Return the mean of a list of numbers.\"\"\"\n    return 0\n",
            "examples": [
              {
                "call": "mean([1, 2, 3])",
                "expect": "2.0",
                "compare": "isclose"
              }
            ],
            "tests": [
              {
                "call": "mean([1, 2, 3])",
                "expect": "2.0",
                "compare": "isclose"
              },
              {
                "call": "mean([4])",
                "expect": "4.0",
                "compare": "isclose"
              },
              {
                "call": "mean([0.5, 1.5])",
                "expect": "1.0",
                "compare": "isclose"
              },
              {
                "call": "mean([10, 20, 60])",
                "expect": "30.0",
                "compare": "isclose"
              }
            ],
            "how": "Submit runs 4 hidden tests. Each answer is accepted when it is close to the expected value.",
            "solution": "def mean(xs):\n    return sum(xs) / len(xs)\n"
          },
          "feedback": {
            "correct": "All four tests pass.",
            "generic": "A hidden test failed."
          },
          "explain": {
            "text": "Sum the items and divide by the length."
          }
        },
        {
          "question": "The mean of `[2, 4, 9]` as a whole number?",
          "widget": {
            "kind": "numeric",
            "answer": 5,
            "tol": {
              "abs": 0
            },
            "placeholder": "a number"
          },
          "feedback": {
            "correct": "15 / 3 is 5.",
            "generic": "Add the items, then divide by three."
          },
          "explain": {
            "text": "2 + 4 + 9 is 15, and 15 / 3 is 5."
          }
        },
        {
          "question": "Now `None` marks a missing price. Skip it, and return `0.0` when nothing is left.",
          "widget": {
            "kind": "code",
            "language": "python",
            "starter": "def mean(xs):\n    # Part 1 reference. Now skip the None entries.\n    return sum(xs) / len(xs)\n",
            "examples": [
              {
                "call": "mean([1, None, 3])",
                "expect": "2.0",
                "compare": "isclose"
              }
            ],
            "tests": [
              {
                "call": "mean([1, None, 3])",
                "expect": "2.0",
                "compare": "isclose"
              },
              {
                "call": "mean([])",
                "expect": "0.0",
                "compare": "isclose"
              },
              {
                "call": "mean([None, None])",
                "expect": "0.0",
                "compare": "isclose"
              },
              {
                "call": "mean([None, 6])",
                "expect": "6.0",
                "compare": "isclose"
              }
            ],
            "how": "Submit runs the 4 tests of this part and the 4 of part 1, 8 in all.",
            "solution": "def mean(xs):\n    kept = [x for x in xs if x is not None]\n    return sum(kept) / len(kept) if kept else 0.0\n"
          },
          "feedback": {
            "correct": "All eight tests pass.",
            "generic": "A hidden test failed, one of this part or of part 1."
          },
          "explain": {
            "text": "Filter first, then guard the empty case."
          }
        }
      ]
    },
    {
