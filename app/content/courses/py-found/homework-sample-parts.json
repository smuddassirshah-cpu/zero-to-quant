      "id": "h-slice",
      "difficulty": 5,
      "skills": [
        "pf-types"
      ],
      "prose": "```python\n'quantitative'[2:8:2]\n```",
      "question": "What does it evaluate to?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "att",
            "text": "`'att'`",
            "correct": true
          },
          {
            "id": "antit",
            "text": "`'antit'`",
            "why": "That ignores the step of 2: it takes every character from index 2 to 6."
          },
          {
            "id": "attt",
            "text": "`'attt'`",
            "why": "You took index 8, but the stop index is excluded."
          }
        ]
      },
      "feedback": {
        "correct": "Indexes 2, 4 and 6 give a, t and t.",
        "generic": "Not quite right. Take indexes 2, 4 and 6."
      },
      "explain": {
        "text": "In 'quantitative' the letters at indexes 2, 4 and 6 are a, t and t. The stop index 8 is excluded."
      }
    }
