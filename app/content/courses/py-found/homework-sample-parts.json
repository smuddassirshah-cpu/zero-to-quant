        "starter": "def spread(xs):\n    \"\"\"Return the largest value minus the smallest.\"\"\"\n    return 0\n",
        "examples": [
          {
            "call": "spread([3, 9, 5])",
            "expect": "6",
            "compare": "isclose"
          }
        ],
        "tests": [
          {
            "call": "spread([3, 9, 5])",
            "expect": "6",
            "compare": "isclose"
          },
          {
            "call": "spread([4])",
            "expect": "0",
            "compare": "isclose"
          },
          {
            "call": "spread([-2, 2])",
            "expect": "4",
            "compare": "isclose"
          },
          {
            "call": "spread([1.5, 0.5])",
            "expect": "1.0",
            "compare": "isclose"
          }
        ],
        "how": "Submit runs 4 hidden tests.",
        "solution": "def spread(xs):\n    return max(xs) - min(xs)\n"
      },
      "feedback": {
        "correct": "All four tests pass.",
        "generic": "A hidden test failed."
      },
      "explain": {
        "text": "Subtract the smallest from the largest."
      }
    },
