      "difficulty": 2,
      "skills": [
        "pf-types"
      ],
      "prose": "```python\nlen([1, 2, 3])\n```",
      "question": "What does it return?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "three",
            "text": "`3`",
            "correct": true
          },
          {
            "id": "two",
            "text": "`2`",
            "why": "You counted the gaps between items, not the items."
          },
          {
            "id": "four",
            "text": "`4`",
            "why": "The last index is 2, but `len` counts items from one."
          }
        ]
      },
      "feedback": {
        "correct": "`len` counts the items.",
        "generic": "Not quite right. Count the items, not the indexes."
      },
      "explain": {
        "text": "`len` returns the number of items. The last index is one less."
      }
