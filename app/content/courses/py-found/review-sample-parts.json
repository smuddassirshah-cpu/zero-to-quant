            "tol": {
              "abs": 0
            },
            "placeholder": "a number"
          },
          "feedback": {
            "correct": "2 + 4 + 7 is 13.",
            "generic": "Add all three items."
          },
          "explain": {
            "text": "The items add to 13."
          }
        },
        {
          "question": "Which expression gives the mean?",
          "widget": {
            "kind": "choice",
            "layout": "stack",
            "options": [
              {
                "id": "div",
                "text": "`sum(xs) / len(xs)`",
                "correct": true
              },
              {
                "id": "floor",
                "text": "`sum(xs) // len(xs)`",
                "why": "Floor division gives 4 and drops the fraction."
              },
              {
                "id": "fixed",
                "text": "`sum(xs) / 3`",
                "why": "It works for this list only: the length is fixed in the code."
              }
            ]
          },
          "feedback": {
            "correct": "Divide the sum by the length.",
            "generic": "Not quite right. The mean divides by the number of items."
          },
          "explain": {
            "text": "True division keeps the fraction: 13 / 3 is about 4.33."
          }
        },
        {
          "question": "Select all that apply. Which of these raise an error on an empty list?",
          "widget": {
            "kind": "multi",
            "options": [
              {
                "id": "sum",
                "text": "`sum([])`",
                "why": "`sum` of nothing is 0."
              },
              {
                "id": "max",
                "text": "`max([])`",
                "correct": true
              },
              {
                "id": "idx",
                "text": "`[][0]`",
                "correct": true
              },
              {
                "id": "len",
                "text": "`len([])`",
                "why": "`len` of nothing is 0."
              }
            ]
          },
          "feedback": {
            "correct": "`max` and an index into nothing both fail.",
            "generic": "Not quite right. Which calls need at least one item?"
          },
          "explain": {
            "text": "`max([])` raises ValueError and `[][0]` raises IndexError."
          }
        }
      ]
