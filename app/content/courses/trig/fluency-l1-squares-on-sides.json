{
  "id": "fluency-l1-squares-on-sides",
  "course": "trig",
  "lesson": "l1-squares-on-sides",
  "title": "Fluency: squares on the sides",
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "hypotenuse-whole",
      "weight": 2,
      "skill": "find the hypotenuse",
      "vars": {
        "mn": { "pick": [21, 32, 41, 43, 52, 54] },
        "h": { "int": [0, 59] },
        "o": { "pick": [0, 1] }
      },
      "let": {
        "m": "floor(mn/10)", "n": "mn % 10",
        "k": "1 + h % floor(100/((mn % 10)^2 + floor(mn/10)^2))",
        "p": "k*(m^2 - n^2)", "q": "2*k*m*n",
        "a": "o*p + (1 - o)*q", "b": "o*q + (1 - o)*p",
        "c": "k*(m^2 + n^2)", "a2": "a^2", "b2": "b^2", "c2": "c^2", "sum": "a + b"
      },
      "prompt": "A right-angled triangle has short sides {a} and {b}. How long is the hypotenuse?",
      "widget": { "kind": "numeric", "answer": "{c}", "tol": { "abs": 0 }, "placeholder": "a number" },
      "wrong": [
        { "id": "forgot-the-root", "value": "{c2}", "line": "That is $c^2$: take the square root to find $c$." },
        { "id": "added-the-sides", "value": "{sum}", "line": "You added the sides: it is their squares that add, $a^2 + b^2 = c^2$." }
      ],
      "solution": [
        "$c^2 = a^2 + b^2 = {a2} + {b2} = {c2}$.",
        "So $c = \\sqrt{{{c2}}} = {c}$."
      ]
    },
    {
      "id": "short-side-whole",
      "weight": 2,
      "skill": "find a short side",
      "vars": {
        "mn": { "pick": [21, 32, 41, 43, 52, 54] },
        "h": { "int": [0, 59] },
        "o": { "pick": [0, 1] }
      },
      "let": {
        "m": "floor(mn/10)", "n": "mn % 10",
        "k": "1 + h % floor(100/((mn % 10)^2 + floor(mn/10)^2))",
        "p": "k*(m^2 - n^2)", "q": "2*k*m*n",
        "a": "o*p + (1 - o)*q", "b": "o*q + (1 - o)*p",
        "c": "k*(m^2 + n^2)", "a2": "a^2", "b2": "b^2", "c2": "c^2",
        "added": "sqrt(c^2 + a^2)", "less": "c - a"
      },
      "prompt": "A right-angled triangle has hypotenuse {c} and one short side {a}. How long is the other short side?",
      "widget": { "kind": "numeric", "answer": "{b}", "tol": { "abs": 0 }, "placeholder": "a number" },
      "wrong": [
        { "id": "added-the-squares", "value": "{round(added, 6)}", "tol": { "abs": 0.01 }, "line": "The hypotenuse is the longest side, so its square is the biggest: subtract, $b^2 = c^2 - a^2$." },
        { "id": "took-away-sides", "value": "{less}", "line": "You took the sides away: it is their squares, $b^2 = c^2 - a^2$." }
      ],
      "solution": [
        "$b^2 = c^2 - a^2 = {c2} - {a2} = {b2}$.",
        "So the other short side is $\\sqrt{{{b2}}} = {b}$."
      ]
    },
    {
      "id": "hypotenuse-2-dp",
      "weight": 1,
      "skill": "find the hypotenuse to 2 decimal places",
      "vars": {
        "a": { "int": [2, 15] },
        "b": { "int": [2, 15] }
      },
      "let": { "a2": "a^2", "b2": "b^2", "c2": "a^2 + b^2", "c": "sqrt(a^2 + b^2)", "sum": "a + b" },
      "where": ["floor(sqrt(a^2 + b^2))^2 != a^2 + b^2", "a <= b"],
      "prompt": "A right-angled triangle has short sides {a} and {b}. How long is the hypotenuse, to 2 decimal places?",
      "widget": { "kind": "numeric", "answer": "{round(c, 6)}", "tol": { "abs": 0.005 }, "placeholder": "a decimal", "accept": "{c:dp2}" },
      "wrong": [
        { "id": "forgot-the-root", "value": "{c2}", "tol": { "abs": 0.005 }, "line": "That is $c^2$: take the square root to find $c$." },
        { "id": "added-the-sides", "value": "{sum}", "tol": { "abs": 0.005 }, "line": "You added the sides: it is their squares that add, $a^2 + b^2 = c^2$." }
      ],
      "solution": [
        "$c^2 = {a2} + {b2} = {c2}$.",
        "So $c = \\sqrt{{{c2}}} = {c:dp2}$ to 2 decimal places."
      ]
    },
    {
      "id": "short-side-2-dp",
      "weight": 1,
      "skill": "find a short side to 2 decimal places",
      "vars": {
        "c": { "int": [4, 20] },
        "h": { "int": [0, 59] }
      },
      "let": { "a": "2 + h % (c - 2)", "a2": "(2 + h % (c - 2))^2", "c2": "c^2", "b2": "c^2 - a^2", "b": "sqrt(c^2 - a^2)", "added": "sqrt(c^2 + a^2)" },
      "where": ["floor(sqrt(c^2 - a^2))^2 != c^2 - a^2"],
      "prompt": "A right-angled triangle has hypotenuse {c} and one short side {a}. How long is the other short side, to 2 decimal places?",
      "widget": { "kind": "numeric", "answer": "{round(b, 6)}", "tol": { "abs": 0.005 }, "placeholder": "a decimal", "accept": "{b:dp2}" },
      "wrong": [
        { "id": "added-the-squares", "value": "{round(added, 6)}", "tol": { "abs": 0.005 }, "line": "The hypotenuse is the longest side, so its square is the biggest: subtract, $b^2 = c^2 - a^2$." },
        { "id": "forgot-the-root", "value": "{b2}", "tol": { "abs": 0.005 }, "line": "That is $b^2$: take the square root to find the side." }
      ],
      "solution": [
        "$b^2 = {c2} - {a2} = {b2}$.",
        "So the other short side is $\\sqrt{{{b2}}} = {b:dp2}$ to 2 decimal places."
      ]
    }
  ]
}
