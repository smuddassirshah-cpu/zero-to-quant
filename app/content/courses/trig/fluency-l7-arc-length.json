{
  "id": "fluency-l7-arc-length",
  "course": "trig",
  "lesson": "l7-arc-length",
  "title": "Fluency: radians and arc length",
  "n": 20,
  "pass": 0.9,
  "minutes": 12,
  "families": [
    {
      "id": "degrees-to-radians",
      "weight": 2,
      "skill": "change degrees to radians",
      "vars": {
        "d": { "int": [5, 360], "step": 5 }
      },
      "let": { "k": "d/180", "flip": "180/d", "turn": "d/360" },
      "where": ["d != 180"],
      "prompt": "Write ${d}^\\circ$ as $k\\pi$ radians. What is $k$? Give a fraction.",
      "widget": { "kind": "numeric", "answer": "{k}", "tol": { "rel": 0.002 }, "placeholder": "a fraction", "accept": "${k:frac}$" },
      "wrong": [
        { "id": "upside-down", "value": "{flip}", "tol": { "rel": 0.002 }, "line": "That is upside down: $\\pi$ radians is $180^\\circ$, so divide {d} by 180." },
        { "id": "used-a-full-turn", "value": "{turn}", "tol": { "rel": 0.002 }, "line": "A full turn is $2\\pi$, not $\\pi$: $\\pi$ radians is $180^\\circ$, so divide by 180." }
      ],
      "solution": [
        "$\\pi$ radians is $180^\\circ$, so ${d}^\\circ$ is ${d} \\div 180$ lots of $\\pi$.",
        "${d} \\div 180 = {k:frac}$, so $k = {k:frac}$."
      ]
    },
    {
      "id": "degrees-to-radians-exact",
      "weight": 1,
      "skill": "write an angle in radians exactly",
      "vars": {
        "d": { "int": [5, 355], "step": 5, "not": [180] }
      },
      "let": { "g": "gcd(d, 180)", "p": "d/gcd(d, 180)", "q": "180/gcd(d, 180)", "k": "d/180", "flip": "180/d", "turn": "d/360" },
      "prompt": "Write ${d}^\\circ$ in radians, exactly.",
      "widget": { "kind": "expression", "answer": "\\frac{{{p:c}\\pi}}{{{q}}}", "form": "exact-angle", "accept": ["\\frac{{{p}}}{{{q}}}\\pi"], "keyboard": "algebra" },
      "wrong": [
        { "id": "upside-down", "tex": "{flip:cfrac}\\pi", "line": "That is upside down: $\\pi$ radians is $180^\\circ$, so multiply {d} by $\\frac{{\\pi}}{{180}}$." },
        { "id": "used-a-full-turn", "tex": "{turn:cfrac}\\pi", "line": "A full turn is $2\\pi$, not $\\pi$: $\\pi$ radians is $180^\\circ$, so divide by 180." }
      ],
      "solution": [
        "$\\pi$ radians is $180^\\circ$, so ${d}^\\circ$ is $\\frac{{{d}}}{{180}}\\pi$ radians.",
        "Divide top and bottom by {g}: $\\frac{{{d}}}{{180}} = {k:frac}$, so ${d}^\\circ = \\frac{{{p:c}\\pi}}{{{q}}}$."
      ]
    },
    {
      "id": "radians-to-degrees",
      "weight": 2,
      "skill": "change radians to degrees",
      "vars": {
        "q": { "pick": [2, 3, 4, 5, 6, 9, 10, 12, 18, 20, 36] },
        "h": { "int": [0, 71] }
      },
      "let": { "p": "1 + h % (2*q - 1)", "deg": "180*(1 + h % (2*q - 1))/q", "turn": "360*p/q", "nopi": "180*p/(q*pi)" },
      "where": ["gcd(p, q) == 1"],
      "prompt": "Write $\\frac{{{p:c}\\pi}}{{{q}}}$ radians in degrees.",
      "widget": { "kind": "numeric", "answer": "{deg}", "tol": { "abs": 0 }, "placeholder": "degrees", "unit": "°" },
      "wrong": [
        { "id": "used-a-full-turn", "value": "{turn}", "line": "$\\pi$ radians is $180^\\circ$, not $360^\\circ$." },
        { "id": "dropped-pi", "value": "{round(nopi, 6)}", "tol": { "abs": 0.1 }, "line": "You changed ${p/q:frac}$ radians, leaving out the $\\pi$: replace $\\pi$ by $180^\\circ$." }
      ],
      "solution": [
        "$\\pi$ radians is $180^\\circ$, so replace $\\pi$ by 180.",
        "$180^\\circ \\times {p/q:frac} = {deg}^\\circ$."
      ]
    },
    {
      "id": "radians-to-degrees-1-dp",
      "weight": 1,
      "skill": "change radians to degrees to 1 decimal place",
      "vars": {
        "j": { "int": [5, 120] }
      },
      "let": { "x": "j/20", "deg": "j/20*180/pi", "wrongway": "j/20*pi/180", "turn": "j/20*360/pi" },
      "where": ["j % 20 != 0"],
      "prompt": "What is {x} radians in degrees? Give 1 decimal place.",
      "widget": { "kind": "numeric", "answer": "{round(deg, 6)}", "tol": { "abs": 0.06 }, "placeholder": "degrees", "unit": "°", "accept": "{deg:dp1}" },
      "wrong": [
        { "id": "wrong-way-round", "value": "{round(wrongway, 6)}", "tol": { "abs": 0.06 }, "line": "That multiplies by $\\frac{{\\pi}}{{180}}$, which turns degrees into radians: here multiply by $\\frac{{180}}{{\\pi}}$." },
        { "id": "used-a-full-turn", "value": "{round(turn, 6)}", "tol": { "abs": 0.06 }, "line": "$\\pi$ radians is $180^\\circ$, so multiply by $\\frac{{180}}{{\\pi}}$, not $\\frac{{360}}{{\\pi}}$." }
      ],
      "solution": [
        "Degrees = radians $\\times \\frac{{180}}{{\\pi}}$.",
        "${x} \\times \\frac{{180}}{{\\pi}} = {deg:dp1}^\\circ$ to 1 decimal place."
      ]
    },
    {
      "id": "arc-length",
      "weight": 2,
      "skill": "find an arc length",
      "vars": {
        "r": { "int": [2, 20] },
        "d": { "int": [10, 350], "step": 10 }
      },
      "let": {
        "k": "d/180", "rad": "d*pi/180", "s": "r*d*pi/180",
        "deg": "r*d", "back": "r*d*180/pi"
      },
      "where": ["d != 180"],
      "prompt": "A circle has radius {r}. An angle of ${d}^\\circ$ sits at its centre. How long is the arc, to 2 decimal places?",
      "widget": { "kind": "numeric", "answer": "{round(s, 6)}", "tol": { "abs": 0.006 }, "placeholder": "a decimal", "accept": "{s:dp2}" },
      "wrong": [
        { "id": "used-degrees", "value": "{deg}", "line": "$s = r\\theta$ needs $\\theta$ in radians: change ${d}^\\circ$ to radians first." },
        { "id": "wrong-way-round", "value": "{round(back, 6)}", "tol": { "abs": 0.006 }, "line": "To change degrees to radians, multiply by $\\frac{{\\pi}}{{180}}$, not $\\frac{{180}}{{\\pi}}$." }
      ],
      "solution": [
        "${d}^\\circ$ is ${k:frac}\\pi$ radians.",
        "$s = r\\theta = {r} \\times {k:frac}\\pi = {s:dp2}$ to 2 decimal places."
      ]
    }
  ]
}
