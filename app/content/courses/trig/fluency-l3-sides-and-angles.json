{
  "id": "fluency-l3-sides-and-angles",
  "course": "trig",
  "lesson": "l3-sides-and-angles",
  "title": "Fluency: finding sides",
  "n": 20,
  "pass": 0.9,
  "minutes": 12,
  "families": [
    {
      "id": "side-from-hypotenuse",
      "weight": 2,
      "skill": "find a side from the hypotenuse",
      "vars": {
        "h": {
          "int": [
            3,
            30
          ]
        },
        "t": {
          "int": [
            10,
            80
          ]
        },
        "w": {
          "pick": [
            "opposite",
            "adjacent to"
          ]
        },
        "s": {
          "pick": [
            0,
            1
          ]
        }
      },
      "let": {
        "x": "t*3.14159265358979/180",
        "x2": "x*x",
        "sv": "round(x*(1 - x2/6*(1 - x2/20*(1 - x2/42*(1 - x2/72*(1 - x2/110*(1 - x2/156*(1 - x2/210))))))), 4)",
        "cv": "round(1 - x2/2*(1 - x2/12*(1 - x2/30*(1 - x2/56*(1 - x2/90*(1 - x2/132*(1 - x2/182)))))), 4)",
        "ratio": "(1 - s)*sv + s*cv",
        "other": "s*sv + (1 - s)*cv",
        "key": "h*((1 - s)*sv + s*cv)",
        "swap": "h*(s*sv + (1 - s)*cv)",
        "over": "h/((1 - s)*sv + s*cv)"
      },
      "where": [
        "(w == 'opposite' and s == 0) or (w == 'adjacent to' and s == 1)",
        "abs(swap - key) > 0.05",
        "abs(over - key) > 0.05",
        "abs(over - swap) > 0.05"
      ],
      "prompt": "A right-angled triangle has hypotenuse {h} and an angle of ${t}^\\circ$. Use $\\sin {t}^\\circ \\approx {sv:dp4}$ and $\\cos {t}^\\circ \\approx {cv:dp4}$. How long is the side {w} that angle, to 2 decimal places?",
      "widget": {
        "kind": "numeric",
        "answer": "{key}",
        "tol": {
          "abs": 0.01
        },
        "placeholder": "a decimal",
        "accept": "{key:dp2}, within 0.01"
      },
      "wrong": [
        {
          "id": "other-ratio",
          "value": "{swap}",
          "tol": {
            "abs": 0.01
          },
          "line": "That is the other short side: the opposite side uses the sine and the adjacent side the cosine."
        },
        {
          "id": "divided-by-ratio",
          "value": "{round(over, 6)}",
          "tol": {
            "abs": 0.01
          },
          "line": "The hypotenuse is the longest side: multiply {h} by the ratio, do not divide."
        }
      ],
      "solution": [
        "Opposite = hypotenuse $\\times \\sin$, and adjacent = hypotenuse $\\times \\cos$.",
        "So the side {w} the angle is ${h} \\times {ratio:dp4} = {key:dp2}$ to 2 decimal places."
      ]
    },
    {
      "id": "hypotenuse-from-side",
      "weight": 2,
      "skill": "find the hypotenuse from a side",
      "vars": {
        "d": {
          "int": [
            3,
            30
          ]
        },
        "t": {
          "int": [
            10,
            80
          ]
        },
        "w": {
          "pick": [
            "opposite",
            "adjacent to"
          ]
        },
        "s": {
          "pick": [
            0,
            1
          ]
        }
      },
      "let": {
        "x": "t*3.14159265358979/180",
        "x2": "x*x",
        "sv": "round(x*(1 - x2/6*(1 - x2/20*(1 - x2/42*(1 - x2/72*(1 - x2/110*(1 - x2/156*(1 - x2/210))))))), 4)",
        "cv": "round(1 - x2/2*(1 - x2/12*(1 - x2/30*(1 - x2/56*(1 - x2/90*(1 - x2/132*(1 - x2/182)))))), 4)",
        "ratio": "(1 - s)*sv + s*cv",
        "key": "d/((1 - s)*sv + s*cv)",
        "exact": "d/((1 - s)*(x*(1 - x2/6*(1 - x2/20*(1 - x2/42*(1 - x2/72*(1 - x2/110*(1 - x2/156*(1 - x2/210)))))))) + s*(1 - x2/2*(1 - x2/12*(1 - x2/30*(1 - x2/56*(1 - x2/90*(1 - x2/132*(1 - x2/182))))))))",
        "times": "d*((1 - s)*sv + s*cv)",
        "swap": "d/(s*sv + (1 - s)*cv)"
      },
      "where": [
        "(w == 'opposite' and s == 0) or (w == 'adjacent to' and s == 1)",
        "abs(swap - key) > 0.05",
        "abs(times - key) > 0.05",
        "abs(times - swap) > 0.05",
        "abs(exact - key) < 0.004"
      ],
      "prompt": "In a right-angled triangle, the side {w} an angle of ${t}^\\circ$ is {d}. Use $\\sin {t}^\\circ \\approx {sv:dp4}$ and $\\cos {t}^\\circ \\approx {cv:dp4}$. How long is the hypotenuse, to 2 decimal places?",
      "widget": {
        "kind": "numeric",
        "answer": "{round(key, 6)}",
        "tol": {
          "abs": 0.01
        },
        "placeholder": "a decimal",
        "accept": "{key:dp2}, within 0.01"
      },
      "wrong": [
        {
          "id": "multiplied-by-ratio",
          "value": "{times}",
          "tol": {
            "abs": 0.01
          },
          "line": "The hypotenuse is the longest side: divide {d} by the ratio, do not multiply."
        },
        {
          "id": "other-ratio",
          "value": "{round(swap, 6)}",
          "tol": {
            "abs": 0.01
          },
          "line": "That uses the other ratio: the opposite side goes with the sine and the adjacent side with the cosine."
        }
      ],
      "solution": [
        "Opposite = hypotenuse $\\times \\sin$, and adjacent = hypotenuse $\\times \\cos$, so the hypotenuse is the side divided by its ratio.",
        "${d} \\div {ratio:dp4} = {key:dp2}$ to 2 decimal places."
      ]
    },
    {
      "id": "height-with-tan",
      "weight": 2,
      "skill": "find a height with tangent",
      "vars": {
        "a": {
          "int": [
            5,
            80
          ]
        },
        "t": {
          "int": [
            10,
            70
          ]
        }
      },
      "let": {
        "x": "t*3.14159265358979/180",
        "x2": "x*x",
        "sv": "round(x*(1 - x2/6*(1 - x2/20*(1 - x2/42*(1 - x2/72*(1 - x2/110*(1 - x2/156*(1 - x2/210))))))), 4)",
        "cv": "round(1 - x2/2*(1 - x2/12*(1 - x2/30*(1 - x2/56*(1 - x2/90*(1 - x2/132*(1 - x2/182)))))), 4)",
        "tv": "round((x*(1 - x2/6*(1 - x2/20*(1 - x2/42*(1 - x2/72*(1 - x2/110*(1 - x2/156*(1 - x2/210))))))))/(1 - x2/2*(1 - x2/12*(1 - x2/30*(1 - x2/56*(1 - x2/90*(1 - x2/132*(1 - x2/182))))))), 4)",
        "key": "a*tv",
        "used": "a*sv",
        "over": "a/tv"
      },
      "where": [
        "abs(used - key) > 0.05",
        "abs(over - key) > 0.05",
        "abs(over - used) > 0.05"
      ],
      "prompt": "From {a} m away on level ground, the top of a building is ${t}^\\circ$ above level. Use $\\sin {t}^\\circ \\approx {sv:dp4}$ and $\\tan {t}^\\circ \\approx {tv:dp4}$. How tall is the building, in metres, to 2 decimal places?",
      "widget": {
        "kind": "numeric",
        "answer": "{key}",
        "tol": {
          "abs": 0.02
        },
        "placeholder": "a decimal",
        "accept": "{key:dp2}, within 0.02"
      },
      "wrong": [
        {
          "id": "used-sine",
          "value": "{used}",
          "tol": {
            "abs": 0.02
          },
          "line": "The {a} m is along the ground, next to the angle, and the height is opposite it: that is the tangent."
        },
        {
          "id": "divided-by-tan",
          "value": "{round(over, 6)}",
          "tol": {
            "abs": 0.02
          },
          "line": "Height over distance is $\\tan {t}^\\circ$, so multiply {a} by it, do not divide."
        }
      ],
      "solution": [
        "The height is opposite the angle and the {a} m is adjacent, so height $= {a} \\tan {t}^\\circ$.",
        "${a} \\times {tv:dp4} = {key:dp2}$ m to 2 decimal places."
      ]
    }
  ]
}
