{
  "id": "fluency-l4-multipliers",
  "course": "ratio",
  "lesson": "l4-multipliers",
  "title": "Fluency: multipliers",
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "write-multiplier",
      "weight": 1,
      "skill": "write the multiplier for a change",
      "vars": {
        "q": { "int": [1, 120] },
        "dir": { "pick": [["increases", 1, "rise"], ["decreases", -1, "fall"]], "as": ["verb", "s", "noun"] }
      },
      "let": { "p": "q/2", "key": "1 + s*q/200", "opp": "1 - s*q/200", "change": "q/200", "tens": "1 + s*q/20" },
      "where": ["q % 2 == 0 or q < 20"],
      "prompt": "What multiplier {verb} an amount by {p}%?",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0.00001 }, "placeholder": "a decimal" },
      "wrong": [
        { "id": "opposite", "value": "{opp}", "tol": { "abs": 0.00001 }, "line": "That is the multiplier for a {p}% change the other way." },
        { "id": "change-only", "value": "{change}", "tol": { "abs": 0.00001 }, "line": "That is the change alone. The multiplier keeps the whole, 1, and then adds or takes away the change.", "when": "q != 100" },
        { "id": "tenths", "value": "{tens}", "tol": { "abs": 0.00001 }, "line": "{p}% is {p} hundredths, ${change}$, not {p} tenths.", "when": "q < 20" }
      ],
      "solution": [
        "As a decimal, {p}% is ${change}$.",
        "A {noun} keeps the whole, 1, and {verb} it by ${change}$, so the multiplier is ${key}$."
      ]
    },
    {
      "id": "apply-multiplier",
      "weight": 2,
      "skill": "change an amount in one multiplication",
      "vars": {
        "amt": { "int": [20, 900], "step": 10 },
        "p": { "int": [1, 60] },
        "dir": { "pick": [["Increase", 1, "rise"], ["Decrease", -1, "fall"]], "as": ["verb", "s", "noun"] }
      },
      "let": { "m": "1 + s*p/100", "key": "amt*(1 + s*p/100)", "change": "amt*p/100", "opp": "amt*(1 - s*p/100)", "tens": "amt*(1 + s*p/10)" },
      "where": ["p != 50"],
      "prompt": "{verb} £{amt:dp2} by {p}%, using one multiplication.",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0.005 }, "unit": "£", "accept": "£{key:dp2}" },
      "wrong": [
        { "id": "change-only", "value": "{change}", "tol": { "abs": 0.005 }, "line": "That is the {p}% change alone. The multiplier ${m}$ gives the new amount in one step." },
        { "id": "opposite", "value": "{opp}", "tol": { "abs": 0.005 }, "line": "You used the multiplier for a {p}% change the other way. A {noun} of {p}% multiplies by ${m}$." },
        { "id": "tenths", "value": "{tens}", "tol": { "abs": 0.005 }, "line": "{p}% is {p} hundredths, so the multiplier is ${m}$, not ${1 + s*p/10}$.", "when": "p < 10" }
      ],
      "solution": [
        "A {p}% {noun} multiplies by ${m}$.",
        "${amt} \\times {m} = {key:dp2}$, so the new amount is £{key:dp2}."
      ]
    }
  ]
}
