{
  "id": "fluency-l2-building-percentages",
  "course": "ratio",
  "lesson": "l2-building-percentages",
  "title": "Fluency: building percentages",
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "whole-percent",
      "weight": 2,
      "skill": "find a percentage of an amount",
      "vars": {
        "p": { "int": [2, 98] },
        "amt": { "int": [20, 500], "step": 10 }
      },
      "where": ["p != 50", "p != 10"],
      "let": { "one": "amt/100", "key": "amt*p/100", "byp": "amt/p", "rest": "amt*(100 - p)/100" },
      "prompt": "What is {p}% of £{amt}?",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0.005 }, "unit": "£", "accept": "£{key:dp2}" },
      "wrong": [
        { "id": "divided-by-p", "value": "{byp}", "tol": { "abs": 0.005 }, "line": "You divided £{amt} by {p}, but {p}% means {p} hundredths. Find 1% first.", "when": "abs(amt/p - amt*p/100) > 0.02" },
        { "id": "the-rest", "value": "{rest}", "tol": { "abs": 0.005 }, "line": "That is the {100 - p}% left over. The question asks for {p}%." }
      ],
      "solution": [
        "1% of £{amt} is one hundredth of it, £{one:dp2}.",
        "So {p}% is ${p} \\times {one:dp2} = {key:dp2}$, which is £{key:dp2}."
      ]
    },
    {
      "id": "half-percent",
      "weight": 1,
      "skill": "find a percentage with a half in it",
      "vars": {
        "p": { "pick": [0.5, 1.5, 2.5, 3.5, 4.5, 7.5, 12.5, 15.5, 17.5, 22.5, 32.5, 37.5] },
        "amt": { "int": [20, 980], "step": 20 }
      },
      "let": { "one": "amt/100", "half": "amt/200", "key": "amt*p/100", "byp": "amt/p", "tenths": "amt*p/10" },
      "prompt": "What is {p}% of £{amt}?",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0.005 }, "unit": "£", "accept": "£{key:dp2}" },
      "wrong": [
        { "id": "divided-by-p", "value": "{byp}", "tol": { "abs": 0.005 }, "line": "You divided £{amt} by {p}. A percentage counts hundredths, so start from 1%, which is £{one:dp2}.", "when": "abs(amt/p - amt*p/100) > 0.02" },
        { "id": "tenths", "value": "{tenths}", "tol": { "abs": 0.005 }, "line": "You took {p} tenths. A percentage counts hundredths, so divide by 100, not 10." }
      ],
      "solution": [
        "1% of £{amt} is £{one:dp2}, and half of 1% is £{half:dp2}.",
        "So {p}% is ${p} \\times {one:dp2} = {key:dp2}$, which is £{key:dp2}."
      ]
    }
  ]
}
