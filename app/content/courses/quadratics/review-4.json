      ],
      "prose": "Write $\\sqrt{48} + \\sqrt{27}$ as $a\\sqrt{3}$.",
      "question": "What is $a$?",
      "widget": {
        "kind": "numeric",
        "answer": 7,
        "tol": {
          "abs": 0
        },
        "label": "a",
        "accept": "7",
        "wrong": [
          {
            "id": "under-root",
            "value": 5,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "times",
            "value": 12,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "$4\\sqrt{3} + 3\\sqrt{3} = 7\\sqrt{3}$.",
        "generic": "Not quite right. Write each root as a multiple of $\\sqrt{3}$ first.",
        "byKey": {
          "under-root": "You added under the root: $\\sqrt{75} = 5\\sqrt{3}$. Roots do not split over sums.",
          "times": "You multiplied 4 by 3. Adding $4\\sqrt{3}$ and $3\\sqrt{3}$ adds the counts."
        }
      },
      "explain": {
        "text": "$\\sqrt{48} = \\sqrt{16}\\sqrt{3} = 4\\sqrt{3}$ and $\\sqrt{27} = \\sqrt{9}\\sqrt{3} = 3\\sqrt{3}$. Like surds add, so $a = 7$."
      }
    },
    {
      "id": "r4-conjugate",
      "difficulty": 3,
      "skills": [
        "quad-rational"
      ],
      "prose": "Rationalise $\\dfrac{4}{\\sqrt{5} - 1}$.",
      "question": "Which is the result in simplest form?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "right",
            "text": "$\\sqrt{5} + 1$",
            "correct": true
          },
          {
            "id": "plus-bottom",
            "text": "$\\dfrac{2(\\sqrt{5} + 1)}{3}$",
            "why": "You added the 1: the bottom is $5 - 1 = 4$, not 6."
          },
          {
            "id": "no-flip",
            "text": "$\\sqrt{5} - 1$",
            "why": "The conjugate of $\\sqrt{5} - 1$ is $\\sqrt{5} + 1$: the sign flips."
          },
          {
            "id": "no-cancel",
            "text": "$4\\sqrt{5} + 4$",
            "why": "The new bottom is 4. Divide the top $4(\\sqrt{5} + 1)$ by it."
          }
        ]
      },
      "feedback": {
        "correct": "$\\tfrac{4(\\sqrt{5} + 1)}{5 - 1} = \\sqrt{5} + 1$.",
        "generic": "Not quite right. Multiply top and bottom by $\\sqrt{5} + 1$."
      },
      "explain": {
        "text": "$(\\sqrt{5} - 1)(\\sqrt{5} + 1) = 5 - 1 = 4$. The top is $4(\\sqrt{5} + 1)$, so the fraction is $\\sqrt{5} + 1$, about 3.236."
      }
    },
    {
      "id": "r4-cancel",
      "difficulty": 2,
      "skills": [
        "quad-rational"
      ],
      "prose": "Simplify $\\dfrac{x^2 - x - 6}{x^2 - 4}$.",
      "question": "Which is the simplified fraction?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "right",
            "text": "$\\dfrac{x - 3}{x - 2}$",
            "correct": true
          },
          {
            "id": "wrong-bracket",
            "text": "$\\dfrac{x - 3}{x + 2}$",
            "why": "You cancelled $(x - 2)$, which is not on top. The shared factor is $(x + 2)$."
          },
          {
            "id": "terms",
            "text": "$\\dfrac{-x - 6}{-4}$",
            "why": "You crossed out $x^2$, a term. Factorise top and bottom first."
          },
          {
            "id": "signs",
            "text": "$\\dfrac{x + 3}{x - 2}$",
            "why": "$x^2 - x - 6 = (x - 3)(x + 2)$: $-3$ and 2 multiply to $-6$ and add to $-1$."
          }
        ]
      },
      "feedback": {
        "correct": "$\\tfrac{(x - 3)(x + 2)}{(x - 2)(x + 2)} = \\tfrac{x - 3}{x - 2}$.",
        "generic": "Not quite right. Factorise both, then cancel the shared bracket."
      },
      "explain": {
        "text": "The top is $(x - 3)(x + 2)$ and the bottom $(x - 2)(x + 2)$. Cancelling $(x + 2)$ gives $\\tfrac{x - 3}{x - 2}$, for $x \\ne 2$ and $x \\ne -2$."
      }
    },
    {
      "id": "r4-add",
      "difficulty": 3,
      "skills": [
        "quad-rational"
      ],
      "prose": "Write $\\dfrac{2}{x} + \\dfrac{3}{x - 1}$ as $\\dfrac{\\square}{x(x - 1)}$.",
      "question": "Type the top, simplified.",
      "widget": {
        "kind": "expression",
        "answer": "5x-2",
        "accept": [
          "5x-2"
        ],
        "form": "expanded",
        "wrong": [
          {
            "id": "tops",
            "tex": "5"
          },
          {
            "id": "one-unmultiplied",
            "tex": "5x-1"
          },
          {
            "id": "whole",
            "tex": "\\frac{5x-2}{x(x-1)}"
          }
        ],
        "keyboard": "algebra"
      },
      "feedback": {
        "correct": "$2(x - 1) + 3x = 5x - 2$.",
        "generic": "Not quite right. Rewrite each fraction over $x(x - 1)$, then add the tops.",
        "byKey": {
          "tops": "You added the old tops. Over $x(x - 1)$ they are $2(x - 1)$ and $3x$.",
          "one-unmultiplied": "You multiplied only the $x$ by 2. $2(x - 1) = 2x - 2$.",
          "form": "That is equal, but collect the top into one expression: $5x - 2$.",
          "whole": "That is the whole fraction, and it is right. Type only its top: $5x - 2$."
        }
      },
      "explain": {
        "text": "Over $x(x - 1)$ the tops are $2(x - 1) = 2x - 2$ and $3x$, adding to $5x - 2$. So the sum is $\\tfrac{5x - 2}{x(x - 1)}$, for $x \\ne 0$ and $x \\ne 1$."
      }
    },
    {
      "id": "r4-reject",
      "difficulty": 4,
      "skills": [
        "quad-rational",
        "quad-solve"
      ],
      "prose": "Solve $\\dfrac{4}{x - 1} = 1 + \\dfrac{8}{x^2 - 1}$. Multiplying by $x^2 - 1 = (x - 1)(x + 1)$ gives $4(x + 1) = x^2 - 1 + 8$.",
      "question": "What is the solution?",
      "widget": {
        "kind": "numeric",
        "answer": 3,
        "tol": {
          "abs": 0
        },
        "label": "x",
        "accept": "3",
        "wrong": [
          {
            "id": "not-rejected",
            "value": 1,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "$x^2 - 4x + 3 = 0$ gives 1 and 3; $x = 1$ is rejected, so $x = 3$.",
        "generic": "Not quite right. Solve the quadratic, then check each root in the original.",
        "byKey": {
          "not-rejected": "$x = 1$ makes $x - 1$ and $x^2 - 1$ zero, so it is no solution. The other root, 3, works."
        }
      },
      "explain": {
        "text": "$4x + 4 = x^2 + 7$ rearranges to $x^2 - 4x + 3 = (x - 1)(x - 3) = 0$. The root $x = 1$ makes the bottoms zero and is rejected. Check $x = 3$: $\\tfrac{4}{2} = 1 + \\tfrac{8}{8}$, both 2."
      }
    },
    {
