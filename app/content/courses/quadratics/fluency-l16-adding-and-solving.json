  "families": [
    {
      "id": "add-tops",
      "weight": 1,
      "skill": "add over a common denominator",
      "vars": {
        "p": {
          "int": [
            1,
            6
          ]
        },
        "q": {
          "int": [
            1,
            6
          ]
        },
        "a": {
          "int": [
            -6,
            6
          ],
          "not": [
            0
          ]
        },
        "b": {
          "int": [
            -6,
            6
          ],
          "not": [
            0
          ]
        },
        "v": {
          "pick": [
            "x",
            "y",
            "t"
          ]
        }
      },
      "let": {
        "m": "p + q",
        "c0": "p*b + q*a",
        "own": "p*a + q*b"
      },
      "where": [
        "a != b",
        "p != q",
        "p*b + q*a != 0"
      ],
      "prompt": "Write $\\dfrac{{{p}}}{{{v}{a:+}}} + \\dfrac{{{q}}}{{{v}{b:+}}}$ over $({v}{a:+})({v}{b:+})$. Type the top, simplified.",
      "widget": {
        "kind": "expression",
        "answer": "{poly(v; m, c0)}",
        "form": "simplified"
      },
      "wrong": [
        {
          "id": "own-bottoms",
          "tex": "{poly(v; m, own)}",
          "line": "You multiplied each top by its own bottom. ${p}$ is multiplied by $({v}{b:+})$, the bracket it lacks."
        },
        {
          "id": "tops-added",
          "tex": "{m}",
          "line": "You added the tops alone. Each top must be multiplied by the bracket its fraction lacks."
        }
      ],
      "solution": [
        "$\\dfrac{{{p}}}{{{v}{a:+}}} = \\dfrac{{{p:c}({v}{b:+})}}{{({v}{a:+})({v}{b:+})}}$ and $\\dfrac{{{q}}}{{{v}{b:+}}} = \\dfrac{{{q:c}({v}{a:+})}}{{({v}{a:+})({v}{b:+})}}$.",
        "The top is ${p:c}({v}{b:+}) + {q:c}({v}{a:+}) = {poly(v; m, c0)}$."
      ]
    },
    {
      "id": "subtract-tops",
      "weight": 1,
      "skill": "subtract, keeping the second top in a bracket",
      "vars": {
        "p": {
