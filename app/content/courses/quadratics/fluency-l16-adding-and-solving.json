        }
      },
      "let": {
        "ab": "a*b",
        "na": "-a",
        "nb": "-b",
        "sab": "-(a + b)"
      },
      "where": [
        "a != b",
        "a != -b"
      ],
      "prompt": "Solve $\\dfrac{{{b}x}}{{x{na:+}}} = \\dfrac{{{ab}}}{{x{na:+}}} + x$.",
      "widget": {
        "kind": "numeric",
        "answer": "{b}",
        "tol": {
          "abs": 0
        },
        "placeholder": "use − for below zero"
      },
      "wrong": [
        {
          "id": "kept-bad",
          "value": "{a}",
          "line": "At $x = {a}$ the bottom $x{na:+}$ is 0, so ${a}$ is no solution."
        },
        {
          "id": "sign",
          "value": "{nb}",
          "line": "The factor $(x{nb:+})$ gives $x = {b}$: check the sign."
        }
      ],
      "solution": [
        "Multiply every term by $(x{na:+})$: ${b}x = {ab} + x(x{na:+})$.",
        "So ${poly(x; 1, sab, ab)} = (x{na:+})(x{nb:+}) = 0$.",
        "$x = {a}$ makes a bottom zero, so the only solution is $x = {b}$."
      ]
    }
