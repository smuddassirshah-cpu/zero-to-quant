      "let": {
        "nn": "k*k*m",
        "kk": "k*k",
        "jj": "j*j",
        "rest": "if(j > 0, k*k*m/(j*j), 0)",
        "first": "j",
        "sq": "k*k"
      },
      "prompt": "Write $\\sqrt{{{nn}}}$ in simplest surd form, ${la}\\sqrt{{{lb}}}$. What is ${la}$?",
      "widget": {
        "kind": "numeric",
        "answer": "{k}",
        "tol": {
          "abs": 0
        }
      },
      "wrong": [
        {
          "id": "stopped-early",
          "value": "{first}",
          "line": "$\\sqrt{{{nn}}} = {j}\\sqrt{{{rest}}}$ is true but not simplest: ${rest}$ still has a square factor. Keep going.",
          "when": "j > 0"
        },
        {
          "id": "square-not-root",
          "value": "{sq}",
          "line": "${sq}$ is the square factor itself. The number in front is its root, $\\sqrt{{{sq}}} = {k}$."
        }
      ],
      "solution": [
        "The largest square factor of ${nn}$ is ${kk}$: ${nn} = {kk} \\times {m}$.",
        "So $\\sqrt{{{nn}}} = \\sqrt{{{kk}}}\\sqrt{{{m}}} = {k}\\sqrt{{{m}}}$, and ${la} = {k}$."
      ]
    },
    {
      "id": "collect-surds",
      "weight": 1,
      "skill": "add and subtract like surds",
      "vars": {
        "p": {
          "int": [
            1,
            6
          ]
        },
        "q": {
          "int": [
            1,
            6
          ]
        },
        "m": {
          "pick": [
            2,
            3,
            5,
            6,
            7
          ]
        },
        "op": {
          "pick": [
            [
              "+",
              1
            ],
            [
              "-",
              -1
            ]
          ],
          "as": [
            "o",
            "s"
          ]
        }
      },
      "let": {
        "aa": "p*p*m",
        "bb": "q*q*m",
        "key": "p + s*q",
        "nr": "p*p + s*q*q",
        "plus": "p + q"
      },
      "where": [
        "p != q",
        "p > 1 or q > 1",
        "p*p*m <= 300",
        "q*q*m <= 300"
      ],
      "prompt": "Simplify $\\sqrt{{{aa}}} {o} \\sqrt{{{bb}}}$ to $k\\sqrt{{{m}}}$. What is $k$?",
      "widget": {
        "kind": "numeric",
        "answer": "{key}",
        "tol": {
          "abs": 0
        },
        "placeholder": "use − for below zero"
      },
      "wrong": [
        {
          "id": "no-roots",
          "value": "{nr}",
          "line": "You combined the square factors ${p*p}$ and ${q*q}$. Take their roots first: ${p}$ and ${q}$."
        },
        {
          "id": "sign",
          "value": "{plus}",
          "line": "You added. The second surd is taken away: ${p} - {q}$.",
          "when": "s < 0 and p*p - q*q != p + q"
        }
      ],
      "solution": [
        "$\\sqrt{{{aa}}} = {p:c}\\sqrt{{{m}}}$ and $\\sqrt{{{bb}}} = {q:c}\\sqrt{{{m}}}$.",
        "They are like surds, so ${p} {o} {q} = {key}$, and $k = {key}$."
      ]
    },
    {
      "id": "conjugate-bottom",
      "weight": 1,
      "skill": "rationalise with the conjugate",
      "vars": {
        "p": {
          "int": [
            2,
            9
          ]
        },
        "q": {
          "pick": [
            2,
            3,
            5,
            6,
            7,
            10,
            11,
            13
          ]
        },
        "c": {
          "int": [
            1,
            9
          ]
        },
        "op": {
          "pick": [
            [
              "-",
              "+"
            ],
            [
              "+",
              "-"
            ]
          ],
          "as": [
            "o",
            "co"
          ]
        }
      },
      "let": {
        "pp": "p*p",
        "key": "p*p - q",
        "added": "p*p + q",
        "qq": "p*p - q*q"
      },
      "where": [
        "p*p != q"
      ],
      "prompt": "Rationalise $\\dfrac{{{c}}}{{{p} {o} \\sqrt{{{q}}}}}$ by multiplying top and bottom by ${p} {co} \\sqrt{{{q}}}$. What whole number is the new bottom?",
      "widget": {
        "kind": "numeric",
        "answer": "{key}",
        "tol": {
          "abs": 0
        },
        "placeholder": "use − for below zero"
      },
      "wrong": [
        {
          "id": "added",
          "value": "{added}",
          "line": "The middle terms cancel and $\\sqrt{{{q}}} \\times \\sqrt{{{q}}} = {q}$ is taken away: ${pp} - {q}$."
        },
        {
          "id": "squared-q",
          "value": "{qq}",
          "line": "$\\sqrt{{{q}}} \\times \\sqrt{{{q}}} = {q}$, not ${q}^2$."
        }
      ],
      "solution": [
        "$({p} {o} \\sqrt{{{q}}})({p} {co} \\sqrt{{{q}}}) = {p}^2 - (\\sqrt{{{q}}})^2$, as the middle terms cancel.",
        "That is ${pp} - {q} = {key}$."
      ]
    }
  ]
