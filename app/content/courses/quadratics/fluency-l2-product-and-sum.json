{
  "id": "fluency-l2-product-and-sum",
  "course": "quadratics",
  "lesson": "l2-product-and-sum",
  "title": "Fluency: product and sum",
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "factorise-monic",
      "weight": 3,
      "skill": "factorise by product and sum",
      "vars": {
        "p": { "int": [-9, 9], "not": [0] },
        "q": { "int": [-9, 9], "not": [0] },
        "v": { "pick": ["x", "y", "t"] }
      },
      "let": { "s": "p + q", "c": "p*q", "np": "-p", "nq": "-q", "nc": "-p*q" },
      "where": ["p < q", "s != 0"],
      "prompt": "Factorise ${poly(v; 1, s, c)}$.",
      "widget": { "kind": "expression", "answer": "({v}{p:+})({v}{q:+})", "form": "factorised" },
      "wrong": [
        { "id": "signs-swapped", "tex": "({v}{np:+})({v}{nq:+})", "line": "Your pair has the right product, ${c}$, but it adds to ${-s}$, not ${s}$." },
        { "id": "one-sign", "tex": "({v}{p:+})({v}{nq:+})", "line": "Check the product: ${p} \\times {nq:()} = {nc}$, not ${c}$." }
      ],
      "solution": [
        "Look for two numbers with product ${c}$ and sum ${s}$.",
        "${p}$ and ${q}$ fit: ${p} \\times {q:()} = {c}$ and ${p} + {q:()} = {s}$.",
        "So ${poly(v; 1, s, c)} = ({v}{p:+})({v}{q:+})$."
      ]
    },
    {
      "id": "perfect-square",
      "weight": 1,
      "skill": "factorise a perfect square",
      "vars": {
        "p": { "int": [-12, 12], "not": [0] },
        "v": { "pick": ["x", "y", "t", "r"] }
      },
      "let": { "d": "2*p", "c": "p^2", "np": "-p" },
      "prompt": "Factorise ${poly(v; 1, d, c)}$.",
      "widget": { "kind": "expression", "answer": "({v}{p:+})^2", "accept": ["({v}{p:+})({v}{p:+})"], "form": "factorised" },
      "wrong": [
        { "id": "wrong-sign", "tex": "({v}{np:+})^2", "line": "Your bracket gives a middle term of ${-d:c}{v}$: the number in the bracket takes the sign of the middle term." },
        { "id": "difference", "tex": "({v}{p:+})({v}{np:+})", "line": "That pair multiplies to ${-c}$ and adds to $0$, so it has no middle term." }
      ],
      "solution": [
        "Look for two numbers with product ${c}$ and sum ${d}$.",
        "${p}$ and ${p}$ fit, since ${p} \\times {p:()} = {c}$ and ${p} + {p:()} = {d}$.",
        "So ${poly(v; 1, d, c)} = ({v}{p:+})^2$."
      ]
    }
  ]
}
