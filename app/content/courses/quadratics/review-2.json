        "tol": {
          "abs": 0
        },
        "label": "Value of q",
        "accept": "−9",
        "wrong": [
          {
            "id": "add",
            "value": 89,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "drop",
            "value": -49,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "$(x - 7)^2 - 49 + 40 = (x - 7)^2 - 9$.",
        "generic": "Not quite right. $(x - 7)^2$ adds a corner of 49; take it back off.",
        "byKey": {
          "add": "You added the corner. $(x - 7)^2$ already holds the 49, so subtract it: $40 - 49$.",
          "drop": "You took off the corner but dropped the $+40$."
        }
      },
      "explain": {
        "text": "$x^2 - 14x = (x - 7)^2 - 49$. Adding 40 gives $(x - 7)^2 - 9$. So $q = -9$."
