    {
      "id": "r2-plus-minus",
      "difficulty": 3,
      "skills": [
        "quad-square",
        "quad-solve"
      ],
      "prose": "Solve $(x + 1)^2 = 16$.",
      "question": "What are all the solutions?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "only",
            "text": "Only $x = 3$",
            "why": "You took only the positive root. $(-4)^2 = 16$ too, so $x + 1 = -4$ also works."
          },
          {
            "id": "right",
            "text": "$x = 3$ or $x = -5$",
            "correct": true
          },
          {
            "id": "late",
            "text": "$x = 4$ or $x = -4$",
            "why": "You stopped at $\\pm 4$. It is $x + 1$ that equals $\\pm 4$, so subtract 1."
          },
          {
            "id": "noroot",
            "text": "$x = 15$ or $x = -17$",
            "why": "You used 16 without square-rooting. Undo the square first."
          }
        ]
      },
      "feedback": {
        "correct": "$x + 1 = \\pm 4$, so $x = 3$ or $x = -5$.",
        "generic": "Not quite right. Square-root both sides, keeping both signs."
      },
      "explain": {
        "text": "$x + 1 = 4$ or $x + 1 = -4$. So $x = 3$ or $x = -5$. Check: $(-5 + 1)^2 = 16$."
      }
    },
    {
      "id": "r2-formula",
      "difficulty": 3,
      "skills": [
        "quad-solve"
      ],
      "prose": "Solve $2x^2 - 3x - 4 = 0$ with the formula.",
      "question": "What is the larger root, to 2 decimal places?",
      "widget": {
        "kind": "numeric",
        "answer": 2.35,
        "tol": {
          "abs": 0.005
        },
        "label": "Larger root",
        "accept": "2.35 (that is, $\\tfrac{3 + \\sqrt{41}}{4}$)",
        "wrong": [
          {
            "id": "signb",
            "value": 0.85,
            "tol": {
              "abs": 0.005
            }
          },
          {
            "id": "overa",
            "value": 4.7,
            "tol": {
              "abs": 0.005
            }
          },
          {
            "id": "bar",
            "value": 4.6,
            "tol": {
              "abs": 0.005
            }
          }
        ]
      },
      "feedback": {
        "correct": "$x = \\tfrac{3 + \\sqrt{41}}{4} \\approx 2.35$.",
        "generic": "Not quite right. $b^2 - 4ac = 9 + 32 = 41$; divide the whole top by $2a = 4$.",
        "byKey": {
          "signb": "You used $-b = -3$. With $b = -3$, $-b = +3$.",
          "overa": "You divided by $a = 2$. The formula divides by $2a = 4$.",
          "bar": "You divided only the square root by 4. The whole top, $3 + \\sqrt{41}$, goes over 4."
        }
      },
      "explain": {
        "text": "$b^2 - 4ac = 9 + 32 = 41$, so $x = \\tfrac{3 \\pm \\sqrt{41}}{4}$. With $\\sqrt{41} \\approx 6.403$, the roots are about 2.35 and −0.85."
      }
    },
    {
      "id": "r2-exact",
      "difficulty": 3,
      "skills": [
        "quad-solve",
        "quad-square"
      ],
      "prose": "Solve $x^2 - 2x - 1 = 0$.",
      "question": "What are the exact roots?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "right",
            "text": "$1 \\pm \\sqrt{2}$",
            "correct": true
          },
          {
            "id": "sign",
            "text": "$-1 \\pm \\sqrt{2}$",
            "why": "You used $-b = -2$. With $b = -2$, $-b = +2$, so the centre is 1."
          },
          {
            "id": "half",
            "text": "$1 \\pm \\sqrt{8}$",
            "why": "You halved the 2 but not $\\sqrt{8}$. Since $\\sqrt{8} = 2\\sqrt{2}$, half of it is $\\sqrt{2}$."
          },
          {
            "id": "wrongc",
            "text": "$1 \\pm 0$",
            "why": "You used $c = +1$. With $c = -1$, $b^2 - 4ac = 4 + 4 = 8$."
          }
        ]
      },
      "feedback": {
        "correct": "$(x - 1)^2 = 2$, so $x = 1 \\pm \\sqrt{2}$.",
        "generic": "Not quite right. Find $b^2 - 4ac$ carefully, then halve the whole top."
      },
      "explain": {
        "text": "Completing the square: $(x - 1)^2 = 2$, so $x = 1 \\pm \\sqrt{2}$. The formula agrees: $\\tfrac{2 \\pm \\sqrt{8}}{2}$, since $\\sqrt{8} = 2\\sqrt{2}$."
      }
    },
    {
      "id": "r2-count",
      "difficulty": 2,
      "skills": [
        "quad-solve"
      ],
      "prose": "Look at $4x^2 - 4x + 1 = 0$.",
      "question": "How many real roots does it have?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "one",
            "text": "One",
            "correct": true
          },
          {
            "id": "two",
            "text": "Two",
            "why": "You counted the two signs of ±. With $b^2 - 4ac = 0$ both give $x = \\tfrac{1}{2}$."
          },
          {
            "id": "none",
            "text": "None",
            "why": "$b^2 - 4ac = 16 - 16 = 0$, which is not negative."
          }
        ]
      },
      "feedback": {
        "correct": "$16 - 16 = 0$: one repeated root.",
        "generic": "Not quite right. Work out the sign of $b^2 - 4ac$."
      },
      "explain": {
        "text": "$b^2 - 4ac = 16 - 16 = 0$. So there is one root, $x = \\tfrac{1}{2}$. It is the perfect square $(2x - 1)^2$."
      }
    },
    {
      "id": "r2-two-roots",
      "difficulty": 4,
      "skills": [
        "quad-solve",
        "quad-model"
      ],
      "prose": "The curve $y = 3x^2 - 6x + c$ should cross the $x$-axis at two points.",
      "question": "Which values of $c$ make that happen?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "right",
            "text": "$c < 3$",
            "correct": true
          },
          {
            "id": "flip",
            "text": "$c > 3$",
            "why": "You flipped the inequality. $36 - 12c > 0$ means $12c < 36$."
          },
          {
            "id": "noa",
            "text": "$c < 9$",
            "why": "You left out $a = 3$. It is $36 - 4 \\times 3 \\times c = 36 - 12c$."
          },
          {
            "id": "nofour",
            "text": "$c < 12$",
            "why": "You left out the 4 in $4ac$. It is $36 - 12c > 0$."
          }
        ]
      },
      "feedback": {
        "correct": "$36 - 12c > 0$ gives $c < 3$.",
        "generic": "Not quite right. Solve $b^2 - 4ac > 0$ for $c$."
      },
      "explain": {
        "text": "Two roots need $36 - 12c > 0$, so $c < 3$. At $c = 3$ the quadratic is $3(x - 1)^2$, with one root."
      }
    },
    {
      "id": "r2-return",
      "difficulty": 4,
      "skills": [
        "quad-square",
        "quad-model"
      ],
      "prose": "A car worth £20,000.00 loses the same percentage of its value each year. After two years it is worth £16,200.00. So $(1 - r)^2 = 0.81$.",
      "question": "What is the yearly loss, as a percentage?",
      "widget": {
        "kind": "numeric",
        "answer": 0.1,
        "tol": {
          "abs": 0.0005
        },
        "unit": "%",
        "label": "Yearly loss",
        "accept": "10%",
        "wrong": [
          {
            "id": "halved",
            "value": 0.095,
            "tol": {
              "abs": 0.0005
            }
          },
          {
            "id": "total",
            "value": 0.19,
            "tol": {
              "abs": 0.0005
            }
          }
        ]
      },
      "feedback": {
        "correct": "$1 - r = 0.9$, so $r = 10\\%$ a year.",
        "generic": "Not quite right. Square-root both sides, then solve for $r$.",
        "byKey": {
          "halved": "You halved the 19% total. Losses compound: $0.9 \\times 0.9 = 0.81$, so 10% a year.",
          "total": "19% is the loss over both years. Square-root to undo the two years."
        }
      },
      "explain": {
        "text": "$1 - r = \\pm 0.9$. The root $1 - r = -0.9$ gives $r = 190\\%$, which would leave a negative value. So $r = 0.1$: 10% a year."
      }
    }
  ]
