{
  "id": "fluency-l15-fractions-with-letters",
  "course": "quadratics",
  "lesson": "l15-fractions-with-letters",
  "title": "Fluency: cancelling algebraic fractions",
  "n": 20,
  "pass": 0.9,
  "minutes": 12,
  "families": [
    {
      "id": "cancel-common-bracket",
      "weight": 1,
      "skill": "factorise top and bottom, then cancel",
      "vars": {
        "a": {
          "int": [
            -6,
            6
          ],
          "not": [
            0
          ]
        },
        "b": {
          "int": [
            -6,
            6
          ],
          "not": [
            0
          ]
        },
        "c": {
          "int": [
            -6,
            6
          ],
          "not": [
            0
          ]
        },
        "v": {
          "pick": [
            "x",
            "y",
            "t"
          ]
        }
      },
      "let": {
        "nb": "-b"
      },
      "where": [
        "a != b",
        "a != c",
        "b != c",
        "a != -b"
      ],
      "prompt": "Simplify $\\dfrac{{{poly(v; 1, a + b, a*b)}}}{{{poly(v; 1, a + c, a*c)}}} = \\dfrac{{\\square}}{{{v}{c:+}}}$. Type the top.",
      "widget": {
        "kind": "expression",
        "answer": "{v}{b:+}",
        "form": "expanded"
      },
      "wrong": [
        {
          "id": "shared-bracket",
          "tex": "{v}{a:+}",
          "line": "$({v}{a:+})$ is on the top and the bottom, so it cancels. The top keeps the other factor."
        },
        {
          "id": "sign-slip",
          "tex": "{v}{nb:+}",
          "line": "Check the signs: $({v}{a:+})({v}{nb:+})$ does not expand to the top."
        },
        {
          "id": "whole",
          "tex": "\\frac{{{v}{b:+}}}{{{v}{c:+}}}",
          "line": "That is the whole simplified fraction. Type only the top."
        }
      ],
      "solution": [
        "Factorise both: $\\dfrac{{({v}{a:+})({v}{b:+})}}{{({v}{a:+})({v}{c:+})}}$.",
        "Cancel $({v}{a:+})$: the top is ${v}{b:+}$."
      ]
    },
    {
      "id": "multiply-and-cancel",
      "weight": 1,
      "skill": "multiply, cancelling across",
      "vars": {
        "a": {
          "int": [
            -7,
            7
          ],
          "not": [
            0
          ]
        },
        "b": {
          "int": [
            -7,
            7
          ],
          "not": [
            0
          ]
        },
        "k": {
          "int": [
            2,
            6
          ]
        },
        "v": {
          "pick": [
            "x",
            "y",
            "t"
          ]
        }
      },
      "let": {
        "na": "-a",
        "aa": "-a*a",
        "kb": "k*b"
      },
      "where": [
        "b != a",
        "b != -a"
      ],
      "prompt": "Simplify $\\dfrac{{{poly(v; 1, 0, -a*a)}}}{{{v}{b:+}}} \\times \\dfrac{{{poly(v; k, k*b)}}}{{{v}{na:+}}}$ to a number times one bracket.",
      "widget": {
        "kind": "expression",
        "answer": "{k}({v}{a:+})",
        "form": "factorised"
      },
      "wrong": [
        {
          "id": "sign",
          "tex": "{k}({v}{na:+})",
          "line": "$({v}{na:+})$ is the bracket that cancels with the bottom. The one left is $({v}{a:+})$."
        },
        {
          "id": "number-lost",
          "tex": "{v}{a:+}",
          "line": "${poly(v; k, k*b)} = {k}({v}{b:+})$, and the ${k}$ stays after the bracket cancels."
        }
      ],
      "solution": [
        "Factorise: ${poly(v; 1, 0, -a*a)} = ({v}{na:+})({v}{a:+})$ and ${poly(v; k, k*b)} = {k}({v}{b:+})$.",
        "Cancel $({v}{b:+})$ and $({v}{na:+})$ across: ${k}({v}{a:+})$ is left."
      ]
    },
    {
      "id": "divide-and-cancel",
      "weight": 1,
      "skill": "divide by flipping, then cancel",
      "vars": {
        "a": {
          "int": [
            -7,
            7
          ],
          "not": [
            0
          ]
        },
        "b": {
          "int": [
            -7,
            7
          ],
          "not": [
            0
          ]
        },
        "v": {
          "pick": [
            "x",
            "y",
            "t"
          ]
        }
      },
      "let": {
        "nb": "-b"
      },
      "where": [
        "b != a",
        "b != -a"
      ],
      "prompt": "Simplify $\\dfrac{{{poly(v; 1, a, 0)}}}{{{v}{nb:+}}} \\div \\dfrac{{{v}{a:+}}}{{{poly(v; 1, 0, -b*b)}}}$ to a product of factors.",
      "widget": {
        "kind": "expression",
        "answer": "{v}({v}{b:+})",
        "form": "factorised"
      },
      "wrong": [
        {
          "id": "sign",
          "tex": "{v}({v}{nb:+})",
          "line": "$({v}{nb:+})$ cancels with the bottom. The bracket left from ${poly(v; 1, 0, -b*b)}$ is $({v}{b:+})$."
        },
        {
          "id": "letter-lost",
          "tex": "{v}{b:+}",
          "line": "${poly(v; 1, a, 0)} = {v}({v}{a:+})$: only the bracket cancels, and the ${v}$ stays."
        }
      ],
      "solution": [
        "Flip the second fraction and multiply: $\\dfrac{{{v}({v}{a:+})}}{{{v}{nb:+}}} \\times \\dfrac{{({v}{nb:+})({v}{b:+})}}{{{v}{a:+}}}$.",
        "Cancel $({v}{a:+})$ and $({v}{nb:+})$: ${v}({v}{b:+})$ is left."
      ]
    }
  ]
}
