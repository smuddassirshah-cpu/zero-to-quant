{
  "id": "review-3",
  "course": "quadratics",
  "level": 3,
  "pass": 0.8,
  "items": [
    {
      "id": "r3-match-graph",
      "difficulty": 2,
      "skills": [
        "quad-graph"
      ],
      "prose": "A parabola is drawn.",
      "canvas": {
        "kind": "plane",
        "params": {
          "x": [
            -5,
            3
          ],
          "y": [
            -5,
            6
          ],
          "grid": true,
          "height": 320,
          "functions": [
            {
              "id": "f",
              "expr": "4 - (x + 1)^2"
            }
          ]
        },
        "state": {
          "points": [
            {
              "id": "V",
              "x": -1,
              "y": 4,
              "label": "(−1, 4)",
              "labelPos": "e"
            }
          ]
        }
      },
      "question": "Which equation does it have?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "a",
            "text": "$y = -(x + 1)^2 + 4$",
            "correct": true
          },
          {
            "id": "b",
            "text": "$y = -(x - 1)^2 + 4$",
            "why": "$x - 1$ puts the line of symmetry at $x = 1$. The drawn curve turns at $x = -1$."
          },
          {
            "id": "c",
            "text": "$y = (x + 1)^2 + 4$",
            "why": "A positive $a$ opens upwards. This curve opens downwards."
          },
          {
            "id": "d",
            "text": "$y = -(x + 1)^2 - 4$",
            "why": "The $-4$ would put the vertex below the axis. This one is at height 4."
          }
        ]
      },
      "feedback": {
        "correct": "Vertex $(-1, 4)$, opening downwards.",
        "generic": "Not quite right. Read the vertex and the direction, then match them to $a$, $h$ and $k$."
      },
      "explain": {
        "text": "The top is at $(-1, 4)$, so $h = -1$ and $k = 4$. The curve opens downwards, so $a < 0$. That gives $y = -(x + 1)^2 + 4$."
      }
    },
    {
      "id": "r3-read-vertex",
      "difficulty": 2,
      "skills": [
        "quad-graph",
        "quad-square"
      ],
      "prose": "A curve is $y = 3(x - 2)^2 - 5$.",
      "question": "What is its vertex, and what kind of point is it?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "a",
            "text": "$(2, -5)$, a minimum",
            "correct": true
          },
          {
            "id": "b",
            "text": "$(-2, -5)$, a minimum",
            "why": "$x - 2$ is zero at $x = +2$."
          },
          {
            "id": "c",
            "text": "$(2, -5)$, a maximum",
            "why": "$a = 3 > 0$ opens the curve upwards, so the vertex is its lowest point."
          },
          {
            "id": "d",
            "text": "$(2, 5)$, a minimum",
            "why": "The $-5$ is added on, so the vertex is 5 below the axis."
          }
        ]
      },
      "feedback": {
        "correct": "$(2, -5)$, and $a > 0$ makes it a minimum.",
        "generic": "Not quite right. Read $h$ and $k$ from the completed square form."
      },
      "explain": {
        "text": "The bracket is zero at $x = 2$, leaving $y = -5$. Since $a = 3 > 0$ the curve opens upwards. So $(2, -5)$ is the lowest point."
      }
    },
    {
      "id": "r3-vertex-x",
      "difficulty": 3,
      "skills": [
        "quad-square"
      ],
      "prose": "A curve is $y = 2x^2 + 8x + 1$.",
      "question": "At which $x$ is its vertex?",
      "widget": {
        "kind": "numeric",
        "answer": -2,
        "tol": {
          "abs": 0
        },
        "label": "x at the vertex",
        "accept": "$-2$: $-\\tfrac{8}{2 \\times 2}$",
        "wrong": [
          {
            "id": "minus-b",
            "value": -8,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "sign",
            "value": 2,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "over-a",
            "value": -4,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "$x = -\\tfrac{8}{4} = -2$.",
        "generic": "Not quite right. Use $x = -\\tfrac{b}{2a}$ with $a = 2$ and $b = 8$.",
        "byKey": {
          "minus-b": "You used $x = -b$. Divide by $2a = 4$ as well.",
          "sign": "You lost the minus in $-\\tfrac{b}{2a}$.",
          "over-a": "You divided by $a$, not $2a$."
        }
      },
      "explain": {
        "text": "$x = -\\tfrac{8}{2 \\times 2} = -2$. Check: $2x^2 + 8x + 1 = 2(x + 2)^2 - 7$, and the bracket is zero at $x = -2$."
      }
    },
