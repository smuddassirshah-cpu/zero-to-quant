              "id": "b",
              "x": 5,
              "y": 0,
              "label": "5",
              "labelPos": "n"
            }
          ]
        }
      },
      "question": "What is the least value of $y$?",
      "widget": {
        "kind": "numeric",
        "answer": -16,
        "tol": {
          "abs": 0
