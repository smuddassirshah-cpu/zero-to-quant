{
  "id": "fluency-l3-leading-coefficient",
  "course": "quadratics",
  "lesson": "l3-leading-coefficient",
  "title": "Fluency: a coefficient on the square",
  "n": 20,
  "pass": 0.9,
  "minutes": 12,
  "families": [
    {
      "id": "factorise-non-monic",
      "weight": 3,
      "skill": "factorise by splitting the middle term",
      "vars": {
        "p": { "int": [2, 5] },
        "q": { "int": [-7, 7], "not": [0] },
        "s": { "int": [-7, 7], "not": [0] },
        "v": { "pick": ["x", "y", "t"] }
      },
      "let": { "ps": "p*s", "b": "p*s + q", "c": "q*s", "ac": "p*q*s" },
      "where": ["gcd(p, abs(q)) == 1", "b != 0", "q != s", "q != ps"],
      "prompt": "Factorise ${poly(v; p, b, c)}$.",
      "widget": { "kind": "expression", "answer": "({p}{v}{q:+})({v}{s:+})", "form": "factorised" },
      "wrong": [
        { "id": "skipped-grouping", "tex": "({v}{ps:+})({v}{q:+})", "line": "You found the split, ${ps}$ and ${q}$, but put it straight into brackets: group the four terms instead." },
        { "id": "numbers-swapped", "tex": "({p}{v}{s:+})({v}{q:+})", "line": "The numbers ${q}$ and ${s}$ are in the wrong brackets: expand to check the middle term." }
      ],
      "solution": [
        "Look for two numbers with product ${p} \\times {c:()} = {ac}$ and sum ${b}$: they are ${ps}$ and ${q}$.",
        "Split and group: ${poly(v; p, ps, 0)}{q:+c}{v}{c:+} = {p}{v}({v}{s:+}){q:+}({v}{s:+})$.",
        "So ${poly(v; p, b, c)} = ({p}{v}{q:+})({v}{s:+})$."
      ]
    },
    {
      "id": "split-product",
      "weight": 1,
      "skill": "find the product for the split",
      "vars": {
        "p": { "int": [2, 5] },
        "q": { "int": [-7, 7], "not": [0] },
        "r": { "int": [1, 2] },
        "s": { "int": [-7, 7], "not": [0] },
        "v": { "pick": ["x", "y", "t"] }
      },
      "let": { "a": "p*r", "b": "p*s + q*r", "c": "q*s", "ac": "p*r*q*s" },
      "where": ["gcd(p, abs(q)) == 1", "gcd(r, abs(s)) == 1", "b != 0", "ac != b", "b != c"],
      "prompt": "You split the middle term of ${poly(v; a, b, c)}$. What must the two numbers multiply to?",
      "widget": { "kind": "numeric", "answer": "{ac}", "tol": { "abs": 0 } },
      "wrong": [
        { "id": "last-term-only", "value": "{c}", "line": "That is the last term alone: for $a \\neq 1$ the product is $a \\times c$." },
        { "id": "the-sum", "value": "{b}", "line": "That is the sum the two numbers need: their product is $a \\times c$." }
      ],
      "solution": [
        "Here $a = {a}$ and $c = {c}$.",
        "The two numbers multiply to $ac = {a} \\times {c:()} = {ac}$."
      ]
    },
    {
      "id": "common-factor-first",
      "weight": 2,
      "skill": "take out a common factor, then factorise",
      "vars": {
        "k": { "pick": [2, 3, 4, 5, -2, -3] },
        "p": { "pick": [1, 1, 2, 3] },
        "q": { "int": [-6, 6], "not": [0] },
        "s": { "int": [-6, 6], "not": [0] },
        "v": { "pick": ["x", "y", "t", "q"] }
      },
      "let": { "m": "p*s + q", "n": "q*s", "a": "k*p", "b": "k*(p*s + q)", "c": "k*q*s", "nk": "-k" },
      "where": ["gcd(p, abs(q)) == 1", "p*s + q != 0", "p > 1 or q < s", "abs(k*q*s) <= 90"],
      "prompt": "Factorise ${poly(v; a, b, c)}$ fully.",
      "widget": { "kind": "expression", "answer": "{k}({p:c}{v}{q:+})({v}{s:+})", "form": "factorised-fully" },
      "wrong": [
        { "id": "factor-dropped", "tex": "({p:c}{v}{q:+})({v}{s:+})", "line": "Those brackets multiply to the expression divided by ${k}$: keep ${k}$ in front." },
        { "id": "factor-sign", "tex": "{nk}({p:c}{v}{q:+})({v}{s:+})", "line": "Every term was divided by ${k}$, so the factor in front is ${k}$, not ${nk}$.", "when": "k < 0" },
        { "id": "numbers-swapped", "tex": "{k}({p}{v}{s:+})({v}{q:+})", "line": "The numbers ${q}$ and ${s}$ are in the wrong brackets: expand to check the middle term.", "when": "p > 1 and q != s" }
      ],
      "solution": [
        "Every term divides by ${k}$: ${poly(v; a, b, c)} = {k}({poly(v; p, m, n)})$.",
        "Then ${poly(v; p, m, n)} = ({p:c}{v}{q:+})({v}{s:+})$.",
        "So ${poly(v; a, b, c)} = {k}({p:c}{v}{q:+})({v}{s:+})$."
      ]
    }
  ]
}
