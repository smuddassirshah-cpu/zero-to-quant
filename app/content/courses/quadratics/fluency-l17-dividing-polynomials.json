      "let": {
        "na": "-a",
        "b2": "p - a",
        "b1": "q - a*p",
        "b0": "-a*q",
        "sp": "p - 2*a",
        "sq": "q - 2*a*p + 2*a*a",
        "nq": "-q"
      },
      "where": [
        "abs(a*q) <= 24"
      ],
      "prompt": "Divide ${poly(v; 1, b2, b1, b0)}$ by $({v}{na:+})$. Give the quotient multiplied out.",
      "widget": {
        "kind": "expression",
        "answer": "{poly(v; 1, p, q)}",
        "form": "expanded"
      },
      "wrong": [
        {
          "id": "sign",
          "tex": "{poly(v; 1, sp, sq)}",
          "line": "You divided as if by $({v}{a:+})$. Each step multiplies by ${a}$, the root of $({v}{na:+})$."
        },
        {
          "id": "constant-sign",
          "tex": "{poly(v; 1, p, nq)}",
          "line": "Check the last term: $({na}) \\times ({q})$ must give the constant ${b0}$."
        }
      ],
      "solution": [
        "One term at a time: ${v}^3 \\div {v} = {v}^2$, then take off ${v}^2({v}{na:+})$ and carry on with what is left.",
        "Check: $({v}{na:+})({poly(v; 1, p, q)}) = {poly(v; 1, b2, b1, b0)}$."
      ]
    },
