              "id": "f",
              "expr": "x^2 + 4*x - 1",
              "label": "$y = x^2 + 4x - 1$",
              "labelAt": 1.4
            }
          ]
        },
        "state": {}
      },
      "question": "Which value is the right-hand crossing?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "right",
            "text": "$x = -2 + \\sqrt{5}$",
            "correct": true
          },
          {
            "id": "sign",
            "text": "$x = 2 + \\sqrt{5}$",
            "why": "You moved the 2 across without changing its sign. From $x + 2 = \\sqrt{5}$, subtract 2."
          },
          {
            "id": "noroot",
            "text": "$x = 3$",
            "why": "You set $x + 2 = 5$. The 5 is a square, so $x + 2 = \\sqrt{5}$."
          },
          {
            "id": "corner",
            "text": "$x = -2 + \\sqrt{3}$",
            "why": "You took the 1 off the corner of 4. Moving −1 across adds it: $(x + 2)^2 = 4 + 1 = 5$."
          }
