    {
      "id": "p-serve-13b",
      "difficulty": 5,
      "skills": [
        "gpt-hardware"
      ],
      "prose": "A lab runs a 13-billion-parameter model (40 layers, width 5,120) for one user at a time. Weights and cache are bf16, and its accelerator reads memory at 2 TB/s.",
      "parts": [
        {
          "question": "How many GB do the weights take?",
          "widget": {
            "kind": "numeric",
            "answer": 26,
            "tol": {
              "abs": 0
            },
            "wrong": [
              {
                "id": "one",
                "value": 13,
                "tol": {
                  "abs": 0
                }
              },
              {
                "id": "fp32",
                "value": 52,
                "tol": {
                  "abs": 0
                }
              }
            ],
            "label": "GB"
          },
          "feedback": {
            "correct": "$13 \\times 10^9 \\times 2 = 26$ GB.",
            "generic": "Not quite. 2 bytes per parameter.",
            "byKey": {
              "one": "That is 1 byte per weight.",
              "fp32": "That is 4 bytes per weight."
            }
          },
          "explain": {
            "text": "26 GB of bf16 weights."
          }
        },
        {
          "question": "Using 40 layers of width 5,120, how many GB is the cache for one sequence of 3,000 tokens? Give 2 decimal places.",
          "widget": {
            "kind": "numeric",
            "answer": 2.46,
            "tol": {
              "abs": 0.005
            },
            "wrong": [
              {
                "id": "keys",
                "value": 1.23,
                "tol": {
                  "abs": 0.005
                }
              },
              {
                "id": "gib",
                "value": 2.29,
                "tol": {
                  "abs": 0.005
                }
              }
            ],
            "label": "GB"
          },
          "feedback": {
            "correct": "$2 \\times 40 \\times 5{,}120 \\times 3{,}000 \\times 2 = 2{,}457{,}600{,}000$ bytes, about 2.46 GB.",
            "generic": "Not quite. Use $2LdTb$.",
            "byKey": {
              "keys": "That counts the keys only.",
              "gib": "That is GiB. The question asks for GB, $10^9$ bytes."
            }
          },
          "explain": {
            "text": "$2.4576 \\times 10^9$ bytes: about 2.46 GB."
          }
        },
        {
          "question": "Reading the 26 GB of weights and the 2.46 GB cache for every token, how many milliseconds does each token take at 2 TB/s? Give 2 decimal places.",
          "widget": {
            "kind": "numeric",
            "answer": 14.23,
            "tol": {
              "abs": 0.005
            },
            "wrong": [
              {
                "id": "weights",
                "value": 13,
                "tol": {
                  "abs": 0.005
                }
              },
              {
                "id": "seconds",
                "value": 0.01,
                "tol": {
                  "abs": 0.005
                }
              }
            ],
            "label": "Milliseconds"
          },
          "feedback": {
            "correct": "$28.46 \\times 10^9 / 2 \\times 10^{12} = 14.23$ ms.",
            "generic": "Not quite. Bytes over bandwidth.",
            "byKey": {
              "weights": "That reads the weights alone.",
              "seconds": "That is seconds; the question asks for milliseconds."
            }
          },
          "explain": {
            "text": "$(26 + 2.46) \\times 10^9 / 2 \\times 10^{12}$ s is 14.23 ms."
          }
        },
        {
          "question": "At 14.23 ms a token, how many tokens a second is that? Give 1 decimal place.",
          "widget": {
            "kind": "numeric",
            "answer": 70.3,
            "tol": {
              "abs": 0.05
            },
            "wrong": [
              {
                "id": "weights",
                "value": 76.9,
                "tol": {
                  "abs": 0.05
                }
              }
            ],
            "label": "Tokens per second"
          },
          "feedback": {
            "correct": "$1{,}000 / 14.23 \\approx 70.3$ tokens a second.",
            "generic": "Not quite. Invert the time per token.",
            "byKey": {
              "weights": "That is the weights-only rate, 13 ms a token."
            }
          },
          "explain": {
            "text": "$1{,}000 / 14.23 \\approx 70.3$."
          }
        }
      ]
    },
