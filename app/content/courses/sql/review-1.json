    {
      "id": "r-lowest-vod",
      "difficulty": 4,
      "skills": [
        "sql-select"
      ],
      "prose": "In SQLite, `prices` holds VOD closes 0.72, 0.71, NULL and 0.74.",
      "question": "Which query lists VOD's three lowest known closes, lowest first?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "right",
            "text": "`SELECT close` `FROM prices` `WHERE ticker = 'VOD'` `AND close IS NOT NULL` `ORDER BY close` `LIMIT 3;`",
            "correct": true
          },
          {
            "id": "gap",
            "text": "`SELECT close` `FROM prices` `WHERE ticker = 'VOD'` `ORDER BY close` `LIMIT 3;`",
            "why": "SQLite sorts NULL first when ascending, so the gap takes one of the three places."
          },
          {
            "id": "ne-null",
            "text": "`SELECT close` `FROM prices` `WHERE ticker = 'VOD'` `AND close <> NULL` `ORDER BY close` `LIMIT 3;`",
            "why": "`<> NULL` is never true, so this returns nothing."
          },
          {
            "id": "desc",
            "text": "`SELECT close` `FROM prices` `WHERE ticker = 'VOD'` `AND close IS NOT NULL` `ORDER BY close DESC` `LIMIT 3;`",
            "why": "`DESC` lists the highest closes first."
          }
        ],
        "shuffle": true
      },
      "feedback": {
        "correct": "Drop the gap, sort up, cut at three.",
        "generic": "Not quite right. Remove the gap with `IS NOT NULL`, then sort ascending."
      },
      "explain": {
        "text": "`IS NOT NULL` removes the gap before the sort. Ascending order gives 0.71, 0.72, 0.74, and `LIMIT 3` keeps all three."
      }
    },
