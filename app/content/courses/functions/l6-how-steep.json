  "summary": {
    "ideas": [
      "The gradient is the rise divided by the run between any two points on a line.",
      "A falling line has a negative gradient, a horizontal line has gradient 0, and a vertical line has none.",
      "Compute a gradient from coordinates, never from how steep the picture looks."
    ],
    "formula": {
      "name": "Gradient",
      "tex": "m = \\dfrac{y_2 - y_1}{x_2 - x_1}",
      "note": "Rise over run, with both differences taken in the same direction."
    },
    "trap": "Unequal axis scales make a line look flatter or steeper than it is, and run over rise gives the upside-down answer."
  },
