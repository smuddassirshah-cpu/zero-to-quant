    {
      "id": "r4-push",
      "difficulty": 2,
      "skills": [
        "ds-trees"
      ],
      "prose": "Push 1 onto the min-heap `[3, 5, 4, 9, 6]` by appending it and sifting up.",
      "canvas": {
        "kind": "array",
        "params": {
          "cells": [
            3,
            5,
            4,
            9,
            6
          ],
          "showIndex": true
        },
        "state": {}
      },
      "question": "What is the list afterwards?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "a",
            "text": "`[1, 5, 3, 9, 6, 4]`",
            "correct": true
          },
          {
            "id": "b",
            "text": "`[1, 3, 4, 5, 6, 9]`",
            "why": "That is the list fully sorted. A push only swaps along one path."
          },
          {
            "id": "c",
            "text": "`[3, 5, 1, 9, 6, 4]`",
            "why": "You stopped after one swap. 1 is still smaller than its new parent, 3."
          },
          {
            "id": "d",
            "text": "`[1, 3, 5, 9, 6, 4]`",
            "why": "You swapped 1 with index 1, but its parent is index 2: $(5 - 1) // 2 = 2$."
          }
        ],
        "shuffle": true
      },
      "feedback": {
        "correct": "Two swaps, and 1 is on top.",
        "generic": "Not quite right. Append at index 5, then swap with the parent at $(i - 1) // 2$ while it is larger."
      },
      "explain": {
        "text": "1 starts at index 5. Its parent, index 2, holds 4: swap. Its new parent, index 0, holds 3: swap. Now 1 is the root."
      }
    },
    {
      "id": "r4-quotes",
      "difficulty": 3,
      "skills": [
        "ds-trees"
      ],
      "prose": "Bids: B1 £100.00, B2 £99.98, B3 £99.99. Asks: A1 £100.03, A2 £100.01. Then B1 and A2 are cancelled.",
      "question": "What is the spread, best ask minus best bid, in £?",
      "widget": {
        "kind": "numeric",
        "answer": 0.04,
        "tol": {
          "abs": 0.0005
        },
        "unit": "£",
        "wrong": [
          {
            "id": "stale",
            "value": 0.01,
            "tol": {
              "abs": 0.0005
            }
          },
          {
            "id": "b2",
            "value": 0.05,
            "tol": {
              "abs": 0.0005
            }
          }
        ]
      },
      "feedback": {
        "correct": "£100.03 − £99.99 = £0.04.",
        "generic": "Not quite right. Find the best live bid and the best live ask first.",
        "byKey": {
          "stale": "You used the cancelled quotes. B1 and A2 are gone.",
          "b2": "B3 at £99.99 is higher than B2 at £99.98."
        }
      },
      "explain": {
        "text": "With B1 gone the best bid is B3, £99.99. With A2 gone the best ask is A1, £100.03. The spread is £0.04."
      }
    },
    {
      "id": "r4-valid",
      "difficulty": 3,
      "skills": [
        "ds-trees"
      ],
      "prose": "Each list is a tree in level order, with `None` for a missing child.",
      "question": "Which one is a valid binary search tree?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "a",
            "text": "`[8, 3, 10, 1, 6, None, 14]`",
            "correct": true
          },
          {
            "id": "b",
            "text": "`[8, 3, 10, 1, 9, None, 14]`",
            "why": "9 sits on 8's left side, though 9 > 8. It only looks right against its parent, 3."
          },
          {
            "id": "c",
            "text": "`[8, 3, 10, 1, 6, 7, 14]`",
            "why": "7 sits on 8's right side, under 10, though 7 < 8."
          },
          {
            "id": "d",
            "text": "`[8, 3, 10, 3, 6, None, 14]`",
            "why": "The repeated 3 breaks the strict rule: the left side must be smaller."
          }
        ],
        "shuffle": true
      },
      "feedback": {
        "correct": "Every node fits the bounds from all its ancestors.",
        "generic": "Not quite right. Check each node against every ancestor, not only its parent."
      },
      "explain": {
        "text": "In the valid tree every value on 8's left is below 8 and every value on its right is above 8, at every level. The others each hide one node that passes its parent but fails an ancestor."
      }
    },
    {
      "id": "r4-topk",
      "difficulty": 3,
      "skills": [
        "ds-trees"
      ],
      "prose": "You keep the 20 largest trades of a day of $n$ trades in a min-heap of at most 20 items.",
      "question": "What is the total cost?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "a",
            "text": "$O(n \\log 20)$, which is $O(n)$ for a fixed 20",
            "correct": true
          },
          {
            "id": "b",
            "text": "$O(n \\log n)$",
            "why": "That is sorting every trade. The heap never grows past 20."
          },
          {
            "id": "c",
            "text": "$O(20)$",
            "why": "Every trade must at least be compared with the heap's top, so it grows with $n$."
          },
          {
            "id": "d",
            "text": "$O(n^2)$",
            "why": "Nothing is compared with every other trade."
          }
        ]
      },
      "feedback": {
        "correct": "Each trade costs at most $O(\\log 20)$.",
        "generic": "Not quite right. How big does the heap get?"
      },
      "explain": {
        "text": "Each trade is compared with `h[0]`, and only a winner pays $O(\\log k)$ to replace it. With $k = 20$ fixed, that is linear in $n$."
      }
    },
