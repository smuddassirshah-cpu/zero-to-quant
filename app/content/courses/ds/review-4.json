  "items": [
    {
      "id": "r4-post",
      "difficulty": 2,
      "skills": [
        "ds-trees"
      ],
      "prose": "Post-order visits both sides of a node before the node itself.",
      "canvas": {
        "kind": "tree",
        "params": {
          "orient": "tb",
          "rootLabel": "1",
          "nodes": [
            {
              "id": "l",
              "label": "2",
              "children": [
                {
                  "id": "l",
                  "label": "∅"
                },
                {
                  "id": "r",
                  "label": "4",
                  "children": []
                }
              ]
            },
            {
              "id": "r",
              "label": "3",
              "children": [
                {
                  "id": "l",
                  "label": "5",
                  "children": []
                },
                {
                  "id": "r",
                  "label": "∅"
                }
              ]
            }
          ],
          "compact": true
        },
        "state": {}
      },
      "question": "What is the post-order of this tree?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "a",
            "text": "4, 2, 5, 3, 1",
            "correct": true
          },
          {
            "id": "b",
            "text": "1, 2, 4, 3, 5",
            "why": "That is pre-order: each node before its sides."
          },
          {
            "id": "c",
            "text": "2, 4, 1, 5, 3",
            "why": "That is in-order: each node between its sides."
          },
          {
            "id": "d",
            "text": "4, 5, 2, 3, 1",
            "why": "You listed the deepest level first, but 2 must come before 3's side starts."
          }
        ],
        "shuffle": true
      },
      "feedback": {
        "correct": "Correct.",
        "generic": "Not quite right. Finish the left side, then the right side, then the node."
      },
      "explain": {
        "text": "The left side of 1 gives 4, then 2. The right side gives 5, then 3. The root comes last."
      }
    },
