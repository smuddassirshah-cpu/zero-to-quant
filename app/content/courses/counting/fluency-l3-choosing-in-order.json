{
  "id": "fluency-l3-choosing-in-order",
  "lesson": "l3-choosing-in-order",
  "title": "Fluency: choosing in order",
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "evaluate-p",
      "weight": 2,
      "skill": "work out P(n, r)",
      "vars": {
        "n": { "int": [5, 50] },
        "r": { "int": [2, 5] }
      },
      "let": { "nr": "n - r", "last": "n - r + 1", "key": "fact(n)/fact(n - r)", "pow": "n^r", "short": "fact(n)/fact(n - r + 1)" },
      "where": ["n > r", "key <= 10000"],
      "prompt": "What is $P({n}, {r})$?",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0 }, "placeholder": "A whole number" },
      "wrong": [
        { "id": "repeats-allowed", "value": "{pow}", "line": "That is ${n}^{r}$, which lets the same item fill two places. Each place has one fewer choice than the last." },
        { "id": "one-factor-short", "value": "{short}", "line": "You stopped one factor early. Filling {r} places takes {r} factors, down to {last}." }
      ],
      "solution": [
        "Multiply down from {n} for {r} factors: the last factor is {last}.",
        "So $P({n}, {r}) = \\dfrac{{{n}!}}{{{nr}!}} = {key}$."
      ]
    },
    {
      "id": "awards",
      "weight": 1,
      "skill": "count ordered choices in context",
      "vars": {
        "n": { "int": [5, 12] },
        "r": { "int": [2, 4] },
        "w": { "pick": ["fund managers", "traders", "analysts", "brokers"] }
      },
      "let": { "nr": "n - r", "last": "n - r + 1", "key": "fact(n)/fact(n - r)", "pow": "n^r", "times": "n*r" },
      "where": ["key <= 5040"],
      "prompt": "There are {n} {w} up for {r} different awards, and nobody can win twice. In how many ways can the awards be given out?",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0 }, "placeholder": "A whole number" },
      "wrong": [
        { "id": "repeats-allowed", "value": "{pow}", "line": "That lets one person win twice. After each award there is one fewer person left." },
        { "id": "times-places", "value": "{times}", "line": "You multiplied {n} by {r}. Multiply the choices for each award: {n}, then one fewer, and so on." }
      ],
      "solution": [
        "The first award has {n} choices, the next one fewer, for {r} awards in all.",
        "So the count is $P({n}, {r}) = \\dfrac{{{n}!}}{{{nr}!}} = {key}$."
      ]
    },
    {
      "id": "factorial-quotient",
      "weight": 1,
      "skill": "simplify a quotient of factorials",
      "vars": {
        "n": { "int": [5, 60] },
        "g": { "int": [2, 4] }
      },
      "let": { "m": "n - g", "m1": "n - g + 1", "key": "fact(n)/fact(n - g)", "gf": "fact(g)", "ratio": "n/(n - g)" },
      "where": ["key <= 5040"],
      "prompt": "Work out $\\dfrac{{{n}!}}{{{m}!}}$.",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0 }, "placeholder": "A whole number" },
      "wrong": [
        { "id": "subtracted", "value": "{gf}", "line": "You took ${n}! \\div {m}!$ to be $({n} - {m})!$. Factorials do not cancel like that." },
        { "id": "divided-the-numbers", "value": "{ratio}", "line": "You divided {n} by {m}. Cancel ${m}!$ from ${n}!$ instead." }
      ],
      "solution": [
        "${n}!$ is ${m}!$ times the whole numbers from {m1} to {n}, so ${m}!$ cancels.",
        "What is left is the product of those {g} numbers: {key}."
      ]
    }
  ]
}
