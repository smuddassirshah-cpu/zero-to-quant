{
  "id": "review-3",
  "course": "counting",
  "level": 3,
  "pass": 0.8,
  "items": [
    {
      "id": "r-between",
      "difficulty": 2,
      "skills": [
        "vc-arrows"
      ],
      "prose": "A robot moves in a straight line from $(3, -2)$ to $(-1, 4)$.",
      "question": "Which column vector is the robot's move?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "a",
            "text": "$\\begin{pmatrix} -4 \\\\ 6 \\end{pmatrix}$",
            "correct": true
          },
          {
            "id": "b",
            "text": "$\\begin{pmatrix} 4 \\\\ -6 \\end{pmatrix}$",
            "why": "You took start minus end: that is the trip back."
          },
          {
            "id": "c",
            "text": "$\\begin{pmatrix} -1 \\\\ 4 \\end{pmatrix}$",
            "why": "That is where the robot ends, not how it moved."
          },
          {
            "id": "d",
            "text": "$\\begin{pmatrix} 2 \\\\ 2 \\end{pmatrix}$",
            "why": "You added the two points. A move is end minus start."
          }
        ]
      },
      "feedback": {
        "correct": "4 left and 6 up.",
        "generic": "Not quite right. Take end minus start in each row."
      },
      "explain": {
        "text": "Across: $-1 - 3 = -4$. Up: $4 - (-2) = 6$. So the move is $\\begin{pmatrix} -4 \\\\ 6 \\end{pmatrix}$."
      }
    },
    {
      "id": "r-combine",
      "difficulty": 2,
      "skills": [
        "vc-arrows"
      ],
      "prose": "Let $\\mathbf{u} = \\begin{pmatrix} 1 \\\\ -2 \\end{pmatrix}$ and $\\mathbf{v} = \\begin{pmatrix} 4 \\\\ -5 \\end{pmatrix}$.",
      "question": "What is $3\\mathbf{u} - \\mathbf{v}$?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "a",
            "text": "$\\begin{pmatrix} -1 \\\\ -1 \\end{pmatrix}$",
            "correct": true
          },
          {
            "id": "b",
            "text": "$\\begin{pmatrix} 7 \\\\ -11 \\end{pmatrix}$",
            "why": "You added v instead of subtracting it."
          },
          {
            "id": "c",
            "text": "$\\begin{pmatrix} -1 \\\\ -11 \\end{pmatrix}$",
            "why": "Taking away $-5$ adds 5: $-6 - (-5) = -1$."
          },
          {
            "id": "d",
            "text": "$\\begin{pmatrix} -3 \\\\ 3 \\end{pmatrix}$",
            "why": "You left out the 3: $\\mathbf{u} - \\mathbf{v} = (-3, 3)$. Scale u by 3 first."
          }
        ]
      },
      "feedback": {
        "correct": "$(3, -6) - (4, -5) = (-1, -1)$.",
        "generic": "Not quite right. Scale u first, then subtract v row by row."
      },
      "explain": {
        "text": "$3\\mathbf{u} = (3, -6)$. Then $(3 - 4, -6 - (-5)) = (-1, -1)$."
      }
    },
    {
      "id": "r-distance",
      "difficulty": 3,
      "skills": [
        "vc-arrows"
      ],
      "prose": "Two points on a map: $A(-2, 1)$ and $B(4, 9)$, in kilometres.",
      "question": "How far is it from A to B in a straight line?",
      "widget": {
        "kind": "numeric",
        "answer": 10,
        "tol": {
          "abs": 0.01
        },
        "unit": "km",
        "label": "Distance",
        "placeholder": "a number",
        "accept": "10 km: $|(6, 8)| = \\sqrt{100}$.",
        "wrong": [
          {
            "id": "added",
            "value": 14,
            "tol": {
              "abs": 0.01
            }
          },
          {
            "id": "end",
            "value": 9.85,
            "tol": {
              "abs": 0.01
            }
          }
        ]
      },
      "feedback": {
        "correct": "$\\overrightarrow{AB} = (6, 8)$, of length 10.",
        "generic": "Not quite right. Find the vector from A to B, then its magnitude.",
        "byKey": {
          "added": "You added 6 and 8. The straight line cuts the corner.",
          "end": "That is how far B is from the origin. Start at A."
        }
      },
      "explain": {
        "text": "$\\overrightarrow{AB} = (4 - (-2), 9 - 1) = (6, 8)$, and $\\sqrt{36 + 64} = 10$ km."
      }
    },
    {
      "id": "r-unit",
      "difficulty": 2,
      "skills": [
        "vc-arrows"
      ],
      "prose": "Let $\\mathbf{w} = \\begin{pmatrix} -6 \\\\ 8 \\end{pmatrix}$.",
      "question": "Which vector is $\\hat{\\mathbf{w}}$, the unit vector in the direction of $\\mathbf{w}$?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "a",
            "text": "$\\begin{pmatrix} -0.6 \\\\ 0.8 \\end{pmatrix}$",
            "correct": true
          },
          {
            "id": "b",
            "text": "$\\begin{pmatrix} 0.6 \\\\ -0.8 \\end{pmatrix}$",
            "why": "That has length 1 but points the opposite way."
          },
          {
            "id": "c",
            "text": "$\\begin{pmatrix} -3 \\\\ 4 \\end{pmatrix}$",
            "why": "You halved w. Its length is 5, not 1."
          },
          {
            "id": "d",
            "text": "$\\begin{pmatrix} -0.43 \\\\ 0.57 \\end{pmatrix}$",
            "why": "You divided by $6 + 8 = 14$. Divide by the magnitude, 10."
          }
        ]
      },
      "feedback": {
        "correct": "$|\\mathbf{w}| = 10$, so divide each entry by 10.",
        "generic": "Not quite right. Divide w by its magnitude."
      },
      "explain": {
        "text": "$|\\mathbf{w}| = \\sqrt{36 + 64} = 10$, so $\\hat{\\mathbf{w}} = \\tfrac{1}{10}\\mathbf{w} = (-0.6, 0.8)$. Check: $0.36 + 0.64 = 1$."
      }
    },
    {
      "id": "r-find-t",
      "difficulty": 3,
      "skills": [
        "vc-geometry"
      ],
      "prose": "The points $A(1, -1)$, $B(3, 2)$ and $C(9, t)$ are collinear.",
      "question": "Find $t$.",
      "widget": {
        "kind": "numeric",
        "answer": 11,
        "tol": {
          "abs": 0
        },
        "unit": "",
        "label": "t",
        "placeholder": "a number",
        "accept": "11: $\\overrightarrow{AC} = (8, 12) = 4\\overrightarrow{AB}$.",
        "wrong": [
          {
            "id": "no-start",
            "value": 12,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "times3",
            "value": 8,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "$(8, t + 1) = 4(2, 3)$, so $t = 11$.",
        "generic": "Not quite right. Write AB and AC, then match the rows with one k.",
        "byKey": {
          "no-start": "You found $t + 1 = 12$ and stopped. Take the 1 away.",
          "times3": "The top row gives $k = 8 \\div 2 = 4$, not 3."
        }
      },
      "explain": {
        "text": "$\\overrightarrow{AB} = (2, 3)$ and $\\overrightarrow{AC} = (8, t + 1)$. The top row gives $k = 4$, so $t + 1 = 12$ and $t = 11$."
      }
    },
    {
      "id": "r-diagonal",
      "difficulty": 3,
      "skills": [
        "vc-geometry"
      ],
      "prose": "OABC is a parallelogram with $\\overrightarrow{OA} = \\mathbf{a}$ and $\\overrightarrow{OC} = \\mathbf{c}$.",
      "canvas": {
        "kind": "vectors",
        "params": {
          "x": [
            -1,
            6
          ],
          "y": [
            -1,
            5
          ],
          "vectors": [
            {
              "id": "a",
              "v": [
                4,
                1
              ],
              "label": "$\\mathbf{a}$"
            },
            {
              "id": "c",
              "v": [
                1,
                3
              ],
              "label": "$\\mathbf{c}$",
              "colour": 2
            },
            {
              "id": "ab",
              "v": [
                1,
                3
              ],
              "from": [
                4,
                1
              ],
              "colour": 2
            },
            {
              "id": "cb",
              "v": [
                4,
                1
              ],
              "from": [
                1,
                3
              ]
            }
          ]
        },
        "state": {
          "caption": "O is the origin, A and C are the heads of a and c, and B is the far corner"
        }
      },
      "question": "Which expression is the diagonal $\\overrightarrow{AC}$?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "a",
            "text": "$\\mathbf{c} - \\mathbf{a}$",
            "correct": true
          },
          {
            "id": "b",
            "text": "$\\mathbf{a} - \\mathbf{c}$",
            "why": "That is start minus end, the move from C to A."
          },
          {
            "id": "c",
            "text": "$\\mathbf{a} + \\mathbf{c}$",
            "why": "That is the other diagonal, $\\overrightarrow{OB}$."
          },
          {
            "id": "d",
            "text": "$\\tfrac{1}{2}(\\mathbf{a} + \\mathbf{c})$",
            "why": "That reaches the centre of the parallelogram from O."
          }
        ]
      },
      "feedback": {
        "correct": "Back along a to O, then out along c.",
        "generic": "Not quite right. Route the trip from A to C through O."
      },
      "explain": {
        "text": "$\\overrightarrow{AC} = \\overrightarrow{AO} + \\overrightarrow{OC} = -\\mathbf{a} + \\mathbf{c}$. End minus start, with positions $\\mathbf{a}$ and $\\mathbf{c}$."
      }
    },
    {
      "id": "r-pythag",
      "difficulty": 3,
      "skills": [
        "vc-arrows"
      ],
      "prose": "Two forces act at right angles: $|\\mathbf{u}| = 5$ newtons and $|\\mathbf{v}| = 12$ newtons.",
      "question": "What is $|\\mathbf{u} + \\mathbf{v}|$?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "a",
            "text": "13 newtons",
            "correct": true
          },
          {
            "id": "b",
            "text": "17 newtons",
            "why": "You added the magnitudes. That only works when the forces point the same way."
          },
          {
            "id": "c",
            "text": "7 newtons",
            "why": "That is the gap between them, which only happens when they point opposite ways."
          },
          {
            "id": "d",
            "text": "$\\sqrt{119} \\approx 10.9$ newtons",
            "why": "You subtracted the squares. At right angles they add."
          }
        ]
      },
      "feedback": {
        "correct": "$\\sqrt{25 + 144} = 13$.",
        "generic": "Not quite right. The two forces and their sum make a right-angled triangle."
      },
      "explain": {
        "text": "At right angles, $\\mathbf{u}$, $\\mathbf{v}$ and $\\mathbf{u} + \\mathbf{v}$ form a right-angled triangle. So $|\\mathbf{u} + \\mathbf{v}| = \\sqrt{5^2 + 12^2} = 13$, less than $5 + 12$."
      }
    },
    {
      "id": "r-pnl",
      "difficulty": 2,
      "skills": [
        "vc-geometry"
      ],
      "prose": "You are long 100 shares of Alpha and short 50 of Beta: $\\mathbf{p} = \\begin{pmatrix} 100 \\\\ -50 \\end{pmatrix}$. Alpha rises £0.40 and Beta rises £1.20.",
      "question": "What is your P&L?",
      "widget": {
        "kind": "numeric",
        "answer": -20,
        "tol": {
          "abs": 0.005
        },
        "unit": "£",
        "label": "P&L",
        "placeholder": "pounds, negative for a loss",
        "accept": "$-\\text{£}20.00$: $100 \\times 0.40 + (-50) \\times 1.20 = 40 - 60$.",
        "wrong": [
          {
            "id": "long",
            "value": 100,
            "tol": {
              "abs": 0.005
            }
          },
          {
            "id": "vector",
            "value": 40,
            "tol": {
              "abs": 0.005
            }
          }
        ]
      },
      "feedback": {
        "correct": "£40.00 on Alpha, minus £60.00 on the Beta short.",
        "generic": "Not quite right. Take the dot product of holdings and price changes.",
        "byKey": {
          "long": "You treated the short as long. A short loses when the price rises.",
          "vector": "That is the Alpha line alone. Add the Beta line, $-50 \\times 1.20$."
        }
      },
      "explain": {
        "text": "$\\mathbf{p} \\cdot \\mathbf{d} = 100(0.40) + (-50)(1.20) = 40 - 60 = -20$. The book loses $\\text{£}20.00$."
      }
    },
