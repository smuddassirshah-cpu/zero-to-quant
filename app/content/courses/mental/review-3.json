    {
      "id": "r-return-sixth",
      "difficulty": 4,
      "skills": [
        "ma-frac",
        "ma-div"
      ],
      "prose": "A fund made £7,000.00 profit on £42,000.00 of capital.",
      "question": "What is the return as a decimal, to four places?",
      "widget": {
        "kind": "numeric",
        "answer": 0.1667,
        "tol": {
          "abs": 5e-05
        },
        "label": "Return as a decimal",
        "accept": "0.1667, a 16.67% return.",
        "placeholder": "for example 0.05",
        "wrong": [
          {
            "id": "flipped",
            "value": 6
          },
          {
            "id": "digit",
            "value": 0.6,
            "tol": {
              "abs": 0.0001
            }
          },
          {
            "id": "chopped",
            "value": 0.1666,
            "tol": {
              "abs": 1e-05
            }
          }
        ]
      },
      "feedback": {
        "correct": "$\\tfrac{7000}{42000} = \\tfrac16 \\approx 0.1667$.",
        "generic": "Not quite right. Divide the profit by the capital and cancel.",
        "byKey": {
          "flipped": "6 is capital divided by profit. The return is profit over capital.",
          "digit": "0.6 reads the 6 as a digit. $\\tfrac16$ is less than a fifth.",
          "chopped": "You cut off the 6s. $\\tfrac16 = 0.16666\\ldots$, which rounds up to 0.1667."
        }
      },
      "explain": {
        "text": "£7,000 out of £42,000 cancels to $\\tfrac7{42} = \\tfrac16$. A sixth is $0.1666\\ldots$, which is 0.1667 to four places."
      }
    }
  ]
