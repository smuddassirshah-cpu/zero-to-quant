    {
      "id": "r-missing-factor",
      "difficulty": 2,
      "skills": [
        "ma-div"
      ],
      "prose": "A table fact, read backwards.",
      "question": "What is $96 \\div 12$?",
      "widget": {
        "kind": "numeric",
        "answer": 8,
        "tol": {
          "abs": 0
        },
        "label": "96 divided by 12",
        "accept": "8 exactly.",
        "wrong": [
          {
            "id": "nine",
            "value": 9
          },
          {
            "id": "seven",
            "value": 7
          }
        ]
      },
      "feedback": {
        "correct": "$12 \\times 8 = 96$.",
        "generic": "Not quite right. Ask which number times 12 makes 96.",
        "byKey": {
          "nine": "$12 \\times 9 = 108$, which is 12 too many.",
          "seven": "$12 \\times 7 = 84$, which is 12 short."
        }
      },
      "explain": {
        "text": "The missing factor in $12 \\times ? = 96$ is 8. So $96 \\div 12 = 8$."
      }
    },
    {
      "id": "r-seventeen",
      "difficulty": 3,
      "skills": [
        "ma-frac"
      ],
      "prose": "A position is worth £260.00.",
      "question": "What is 17% of it?",
      "widget": {
        "kind": "numeric",
        "answer": 44.2,
        "tol": {
          "abs": 0.001
        },
        "label": "17% in pounds",
        "accept": "£44.20",
        "unit": "£",
        "wrong": [
          {
            "id": "added-pounds",
            "value": 33,
            "tol": {
              "abs": 0.001
            }
          },
          {
            "id": "fifteen",
            "value": 39,
            "tol": {
              "abs": 0.001
            }
          },
          {
            "id": "one-place",
            "value": 4.42,
            "tol": {
              "abs": 0.001
            }
          }
        ]
      },
      "feedback": {
        "correct": "£26 + £13 + £5.20 = £44.20.",
        "generic": "Not quite right. Build 17% from 10%, 5% and two lots of 1%.",
        "byKey": {
          "added-pounds": "You added £7, not 7%. Build the 7% from 5% and two lots of 1%.",
          "fifteen": "£39 is 15%. Add two lots of 1%, which is £5.20.",
          "one-place": "£4.42 is 1.7%. 10% of £260 is £26, not £2.60."
        }
      },
      "explain": {
        "text": "10% of £260 is £26, 5% is £13 and 1% is £2.60. So 17% is £26 + £13 + £5.20 = £44.20."
      }
    },
    {
      "id": "r-remainder",
      "difficulty": 3,
      "skills": [
        "ma-div",
        "ma-frac"
      ],
      "prose": "$53 \\div 4$ is 13 remainder 1.",
      "question": "What is $53 \\div 4$ as a decimal?",
      "widget": {
        "kind": "numeric",
        "answer": 13.25,
        "tol": {
          "abs": 0.0001
        },
        "label": "53 divided by 4",
        "accept": "13.25 exactly.",
        "wrong": [
          {
            "id": "rem-digit",
            "value": 13.1,
            "tol": {
              "abs": 0.0001
            }
          },
          {
            "id": "rem-hundredths",
            "value": 13.01,
            "tol": {
              "abs": 0.0001
            }
          }
        ]
      },
      "feedback": {
        "correct": "$13 + \\tfrac14 = 13.25$.",
        "generic": "Not quite right. The remainder is a fraction of 4.",
        "byKey": {
          "rem-digit": "You wrote the remainder 1 as a tenth. It is one quarter: $\\tfrac14 = 0.25$.",
          "rem-hundredths": "You wrote the remainder 1 as a hundredth. It is one quarter: $\\tfrac14 = 0.25$."
        }
      },
      "explain": {
        "text": "$4 \\times 13 = 52$ leaves 1 over, and $\\tfrac14 = 0.25$. So $53 \\div 4 = 13.25$."
      }
    },
    {
      "id": "r-pace",
      "difficulty": 2,
      "skills": [
        "ma-div"
      ],
      "prose": "You score 24 in a 120-second round.",
      "question": "What is your pace, in seconds per answer?",
      "widget": {
        "kind": "numeric",
        "answer": 5,
        "tol": {
          "abs": 0.001
        },
        "label": "Seconds per answer",
        "accept": "5 seconds.",
        "unit": "seconds",
        "wrong": [
          {
            "id": "flipped",
            "value": 0.2,
            "tol": {
              "abs": 0.001
            }
          },
          {
            "id": "gap",
            "value": 96
          }
        ]
      },
      "feedback": {
        "correct": "$120 \\div 24 = 5$.",
        "generic": "Not quite right. Divide the time by the score.",
        "byKey": {
          "flipped": "0.2 is answers per second. Pace is seconds per answer.",
          "gap": "96 is 120 take away 24. Divide instead."
        }
      },
      "explain": {
        "text": "Pace is time divided by score: $120 \\div 24 = 5$ seconds an answer. A score of 30 would need 4."
      }
    },
    {
      "id": "r-halve-eight",
      "difficulty": 3,
      "skills": [
        "ma-div"
      ],
      "prose": "Use halving.",
      "question": "What is $216 \\div 8$?",
      "widget": {
        "kind": "numeric",
        "answer": 27,
        "tol": {
          "abs": 0
        },
        "label": "216 divided by 8",
        "accept": "27 exactly.",
        "wrong": [
          {
            "id": "two-halvings",
            "value": 54
          },
          {
            "id": "one-halving",
            "value": 108
          }
        ]
      },
      "feedback": {
        "correct": "Three halvings: 108, 54, 27.",
        "generic": "Not quite right. Dividing by 8 is three halvings.",
        "byKey": {
          "two-halvings": "54 is two halvings, which divides by 4. Halve once more.",
          "one-halving": "108 is one halving. Dividing by 8 needs three."
        }
      },
      "explain": {
        "text": "Since $8 = 2 \\times 2 \\times 2$, halve three times: 108, 54, 27. Check: $27 \\times 8 = 216$."
      }
    },
    {
      "id": "r-five-sixths",
      "difficulty": 3,
      "skills": [
        "ma-frac"
      ],
      "prose": "From a fraction you know.",
      "question": "What is $\\tfrac56$ to three decimal places?",
      "widget": {
        "kind": "numeric",
        "answer": 0.833,
        "tol": {
          "abs": 0.00035
        },
        "label": "5/6 to three decimal places",
        "accept": "0.833. Also 0.8333.",
        "placeholder": "for example 0.5",
        "wrong": [
          {
            "id": "digits",
            "value": 0.56,
            "tol": {
              "abs": 0.0001
            }
          },
          {
            "id": "one-sixth",
            "value": 0.167,
            "tol": {
              "abs": 0.0004
            }
          },
          {
            "id": "rounded-up",
            "value": 0.834,
            "tol": {
              "abs": 0.0001
            }
          }
        ]
      },
      "feedback": {
        "correct": "$1 - 0.1667 = 0.8333 \\approx 0.833$.",
        "generic": "Not quite right. Five sixths is one sixth short of 1.",
        "byKey": {
          "digits": "0.56 writes the 5 and the 6 as digits. $\\tfrac56$ is close to 1.",
          "one-sixth": "0.167 is one sixth. Five sixths is 1 take away one sixth.",
          "rounded-up": "The fourth digit is 3, so the third digit stays: 0.833."
        }
      },
      "explain": {
        "text": "$\\tfrac56 = 1 - \\tfrac16 = 1 - 0.1666\\ldots = 0.8333\\ldots$, which is 0.833 to three places."
      }
    },
    {
