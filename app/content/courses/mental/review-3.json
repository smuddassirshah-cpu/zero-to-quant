    {
      "id": "r-split-seven",
      "difficulty": 4,
      "skills": [
        "ma-div"
      ],
      "prose": "You meet $147 \\div 7$ in a timed round.",
      "question": "Which split finishes in one step per piece?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "right",
            "text": "$140 + 7$",
            "correct": true
          },
          {
            "id": "hundred",
            "text": "$100 + 47$",
            "why": "You split at a hundred. $100 \\div 7$ and $47 \\div 7$ both leave remainders."
          },
          {
            "id": "tens",
            "text": "$120 + 27$",
            "why": "You split off the tens. $120 \\div 7$ and $27 \\div 7$ both leave remainders."
          },
          {
            "id": "divisor",
            "text": "$147 \\div 5 + 147 \\div 2$",
            "why": "That splits the divisor 7. Only the number being divided can be split."
          }
        ]
      },
      "feedback": {
        "correct": "$20 + 1 = 21$.",
        "generic": "Not quite right. Split 147 into multiples of 7."
      },
      "explain": {
        "text": "140 and 7 are both multiples of 7, giving $20 + 1 = 21$. Check: $21 \\times 7 = 147$."
      }
    },
