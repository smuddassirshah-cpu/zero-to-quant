  "summary": {
    "ideas": [
      "Round the awkward number to a ten or to 100, do the easy sum, then undo the rounding.",
      "Either number in a sum can be the one you round.",
      "Took away too much? Give it back. Added too much? Take it off."
    ],
    "formula": {
      "name": "Round, then adjust",
      "tex": "a - b = a - (b + d) + d",
      "note": "71 − 38 = 71 − 40 + 2 = 33."
    },
    "trap": "After rounding up in a subtraction, taking the difference off again instead of giving it back."
  },
