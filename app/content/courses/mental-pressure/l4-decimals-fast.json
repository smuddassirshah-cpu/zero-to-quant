        "starter": "def decimal_places(s):\n    \"\"\"Digits after the point in a decimal written as text: '0.07' -> 2.\"\"\"\n    ...\n\n\ndef scale_divide(a, b):\n    \"\"\"Scale two decimals (text) by one power of ten so both are whole:\n    ('0.48', '0.012') -> (480, 12).\"\"\"\n    k = max(decimal_places(a), decimal_places(b))\n    return ..., ...\n",
        "solution": "def decimal_places(s):\n    \"\"\"Digits after the point in a decimal written as text: '0.07' -> 2.\"\"\"\n    return len(s.split('.')[1]) if '.' in s else 0\n\n\ndef scale_divide(a, b):\n    \"\"\"Scale two decimals (text) by one power of ten so both are whole:\n    ('0.48', '0.012') -> (480, 12).\"\"\"\n    k = max(decimal_places(a), decimal_places(b))\n    whole = lambda s: int(s.replace('.', '')) * 10 ** (k - decimal_places(s))\n    return whole(a), whole(b)\n",
        "examples": [
