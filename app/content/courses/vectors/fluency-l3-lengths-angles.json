{
  "id": "fluency-l3-lengths-angles",
  "course": "vectors",
  "lesson": "l3-lengths-angles",
  "title": "Fluency: lengths and angles",
  "n": 20,
  "pass": 0.9,
  "minutes": 12,
  "families": [
    {
      "id": "length",
      "weight": 1,
      "skill": "find the length of a vector",
      "vars": {
        "t": { "pick": [[3, 4, 5], [6, 8, 10], [5, 12, 13], [8, 15, 17], [7, 24, 25], [9, 12, 15], [12, 16, 20], [15, 20, 25], [20, 21, 29], [10, 24, 26], [18, 24, 30], [16, 30, 34]], "as": ["p", "q", "len"] },
        "sx": { "pick": [1, -1] },
        "sy": { "pick": [1, -1] },
        "sw": { "pick": [0, 1] }
      },
      "let": {
        "x": "if(sw == 0, p, q)*sx",
        "y": "if(sw == 0, q, p)*sy",
        "vv": "len^2",
        "sizes": "p + q"
      },
      "prompt": "Find $|\\mathbf{{v}}|$ for $\\mathbf{{v}} = ({x}, {y})$.",
      "widget": { "kind": "numeric", "answer": "{len}", "tol": { "abs": 0 }, "placeholder": "For example 7" },
      "wrong": [
        { "id": "no-square-root", "value": "{vv}", "line": "That is $\\mathbf{{v}} \\cdot \\mathbf{{v}} = {vv}$, the squared length. Take its square root." },
        { "id": "added-sizes", "value": "{sizes}", "line": "You added the sizes of the coordinates. Square each one, add, then take the square root." }
      ],
      "solution": [
        "$\\mathbf{{v}} \\cdot \\mathbf{{v}} = {x:()}^2 + {y:()}^2$, which is ${x^2} + {y^2} = {vv}$.",
        "So $|\\mathbf{{v}}| = \\sqrt{{{vv}}} = {len}$."
      ]
    },
    {
      "id": "unit-vector",
      "weight": 1,
      "skill": "find a unit vector",
      "vars": {
        "t": { "pick": [[3, 4, 5], [6, 8, 10], [5, 12, 13], [8, 15, 17], [7, 24, 25], [9, 12, 15], [12, 16, 20], [15, 20, 25], [20, 21, 29], [10, 24, 26], [18, 24, 30], [16, 30, 34]], "as": ["p", "q", "len"] },
        "sx": { "pick": [1, -1] },
        "sy": { "pick": [1, -1] },
        "sw": { "pick": [0, 1] }
      },
      "let": {
        "x": "if(sw == 0, p, q)*sx",
        "y": "if(sw == 0, q, p)*sy",
        "vv": "len^2",
        "ux": "x/len",
        "uy": "y/len"
      },
      "prompt": "Find the unit vector in the direction of $\\mathbf{{v}} = ({x}, {y})$.",
      "widget": { "kind": "expression", "answer": "({ux:frac}, {uy:frac})", "keyboard": "algebra" },
      "wrong": [
        { "id": "divided-by-dot", "tex": "({x/vv:frac}, {y/vv:frac})", "line": "You divided by $\\mathbf{{v}} \\cdot \\mathbf{{v}} = {vv}$. Divide by the length, ${len}$." },
        { "id": "sign-dropped", "tex": "({abs(ux):frac}, {abs(uy):frac})", "line": "A unit vector points the same way as $\\mathbf{{v}}$, so each coordinate keeps its sign.", "when": "x < 0 or y < 0" }
      ],
      "solution": [
        "$\\mathbf{{v}} \\cdot \\mathbf{{v}} = {x^2} + {y^2} = {vv}$, so $|\\mathbf{{v}}| = {len}$.",
        "Divide each coordinate by ${len}$: the unit vector is $({ux:frac}, {uy:frac})$."
      ]
    },
    {
      "id": "cosine-of-angle",
      "weight": 1,
      "skill": "find the cosine of the angle between two vectors",
      "vars": {
        "tu": { "pick": [[3, 4, 5], [4, 3, 5], [6, 8, 10], [8, 6, 10], [5, 12, 13], [12, 5, 13]], "as": ["p1", "p2", "lu"] },
        "tv": { "pick": [[3, 4, 5], [4, 3, 5], [6, 8, 10], [8, 6, 10], [5, 12, 13], [12, 5, 13]], "as": ["q1", "q2", "lv"] },
        "s1": { "pick": [1, -1] },
        "s2": { "pick": [1, -1] },
        "s3": { "pick": [1, -1] }
      },
      "let": {
        "a1": "p1*s1",
        "a2": "p2*s2",
        "b1": "q1*s3",
        "b2": "q2",
        "m1": "p1*s1*q1*s3",
        "m2": "p2*s2*q2",
        "dot": "p1*s1*q1*s3 + p2*s2*q2",
        "ll": "lu*lv",
        "key": "(p1*s1*q1*s3 + p2*s2*q2)/(lu*lv)",
        "uu": "lu^2"
      },
      "where": ["dot != 0", "dot^2 != ll^2"],
      "prompt": "Find $\\cos\\theta$, where $\\theta$ is the angle between $\\mathbf{{u}} = ({a1}, {a2})$ and $\\mathbf{{v}} = ({b1}, {b2})$. Give a fraction or a decimal.",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0.0005 }, "placeholder": "Fraction or decimal", "accept": "${key:frac}$, or a decimal within 0.0005" },
      "wrong": [
        { "id": "no-lengths", "value": "{dot}", "line": "${dot}$ is the dot product. Divide it by both lengths, $|\\mathbf{{u}}|\\,|\\mathbf{{v}}| = {ll}$." },
        { "id": "projection-instead", "value": "{dot/uu}", "tol": { "abs": 0.0005 }, "line": "You divided by $\\mathbf{{u}} \\cdot \\mathbf{{u}} = {uu}$, which gives a projection coefficient. The cosine divides by both lengths.", "when": "lu != lv" }
      ],
      "solution": [
        "$\\mathbf{{u}} \\cdot \\mathbf{{v}} = {m1}{m2:+} = {dot}$, $|\\mathbf{{u}}| = {lu}$ and $|\\mathbf{{v}}| = {lv}$.",
        "So $\\cos\\theta = \\dfrac{{{dot}}}{{{lu} \\times {lv}}} = {key:frac}$."
      ]
    },
    {
      "id": "projection-multiple",
      "weight": 1,
      "skill": "find the multiple in a projection",
      "vars": {
        "u1": { "int": [-6, 6], "not": [0] },
        "u2": { "int": [-6, 6], "not": [0] },
        "v1": { "int": [-4, 4], "not": [0] },
        "v2": { "int": [-4, 4], "not": [0] }
      },
      "let": {
        "m1": "u1*v1",
        "m2": "u2*v2",
        "uv": "u1*v1 + u2*v2",
        "vv": "v1^2 + v2^2",
        "uu": "u1^2 + u2^2",
        "key": "(u1*v1 + u2*v2)/(v1^2 + v2^2)"
      },
      "where": ["uv != 0", "abs(uv) != vv", "uu != vv", "uv^2 != uu*vv"],
      "prompt": "The projection of $\\mathbf{{u}} = ({u1}, {u2})$ onto $\\mathbf{{v}} = ({v1}, {v2})$ is $k\\mathbf{{v}}$. Find $k$ as a fraction or a decimal.",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0.0005 }, "placeholder": "Fraction or decimal", "accept": "${key:frac}$, or a decimal within 0.0005" },
      "wrong": [
        { "id": "upside-down", "value": "{vv/uv}", "tol": { "abs": 0.0005 }, "line": "You divided $\\mathbf{{v}} \\cdot \\mathbf{{v}}$ by $\\mathbf{{u}} \\cdot \\mathbf{{v}}$. Turn the fraction the other way up." },
        { "id": "divided-by-uu", "value": "{uv/uu}", "tol": { "abs": 0.0005 }, "line": "You divided by $\\mathbf{{u}} \\cdot \\mathbf{{u}} = {uu}$. The multiple of $\\mathbf{{v}}$ divides by $\\mathbf{{v}} \\cdot \\mathbf{{v}} = {vv}$." }
      ],
      "solution": [
        "$\\mathbf{{u}} \\cdot \\mathbf{{v}} = {m1}{m2:+} = {uv}$ and $\\mathbf{{v}} \\cdot \\mathbf{{v}} = {v1^2} + {v2^2} = {vv}$.",
        "So $k = \\dfrac{{\\mathbf{{u}} \\cdot \\mathbf{{v}}}}{{\\mathbf{{v}} \\cdot \\mathbf{{v}}}} = {key:frac}$."
      ]
    }
  ]
}
