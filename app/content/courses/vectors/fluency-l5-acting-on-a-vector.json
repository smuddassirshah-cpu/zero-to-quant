{
  "id": "fluency-l5-acting-on-a-vector",
  "course": "vectors",
  "lesson": "l5-acting-on-a-vector",
  "title": "Fluency: a matrix acting on a vector",
  "n": 20,
  "pass": 0.9,
  "minutes": 12,
  "families": [
    {
      "id": "two-by-two",
      "weight": 2,
      "skill": "multiply a 2 by 2 matrix by a vector",
      "vars": {
        "a": { "int": [-5, 5], "not": [0] },
        "b": { "int": [-5, 5], "not": [0] },
        "c": { "int": [-5, 5], "not": [0] },
        "d": { "int": [-5, 5], "not": [0] },
        "x1": { "int": [-3, 3], "not": [0] },
        "x2": { "int": [-3, 3], "not": [0] }
      },
      "let": {
        "r1": "a*x1 + b*x2",
        "r2": "c*x1 + d*x2",
        "t1": "a*x1 + c*x2",
        "t2": "b*x1 + d*x2",
        "g1": "a*x1",
        "g2": "d*x2",
        "ax": "a*x1",
        "bx": "b*x2",
        "cx": "c*x1",
        "dx": "d*x2"
      },
      "where": ["b != c"],
      "prompt": "Work out $\\mathbf{{A}}\\mathbf{{x}}$ for $\\mathbf{{A}} = \\begin{{pmatrix}} {a} & {b} \\\\ {c} & {d} \\end{{pmatrix}}$ and $\\mathbf{{x}} = ({x1}, {x2})$.",
      "widget": { "kind": "expression", "answer": "({r1}, {r2})", "keyboard": "algebra" },
      "wrong": [
        { "id": "combined-rows", "tex": "({t1}, {t2})", "line": "You combined the rows. The amounts in $\\mathbf{{x}}$ scale the columns, $({a}, {c})$ and $({b}, {d})$." },
        { "id": "diagonal-only", "tex": "({g1}, {g2})", "line": "You multiplied only the diagonal entries by $\\mathbf{{x}}$. Every entry of $\\mathbf{{A}}$ counts." }
      ],
      "solution": [
        "Take ${x1}$ of column 1, $({a}, {c})$, and ${x2}$ of column 2, $({b}, {d})$.",
        "Top: ${ax}{bx:+} = {r1}$. Bottom: ${cx}{dx:+} = {r2}$.",
        "So $\\mathbf{{A}}\\mathbf{{x}} = ({r1}, {r2})$."
      ]
    },
    {
      "id": "taller-columns",
      "weight": 1,
      "skill": "multiply a 3 by 2 matrix by a vector",
      "vars": {
        "a": { "int": [-4, 4] },
        "b": { "int": [-4, 4] },
        "c": { "int": [-4, 4] },
        "d": { "int": [-4, 4] },
        "e": { "int": [-4, 4] },
        "f": { "int": [-4, 4] },
        "x1": { "int": [-3, 3], "not": [0] },
        "x2": { "int": [-3, 3], "not": [0] }
      },
      "let": {
        "r1": "a*x1 + b*x2",
        "r2": "c*x1 + d*x2",
        "r3": "e*x1 + f*x2",
        "s1": "a*x2 + b*x1",
        "s2": "c*x2 + d*x1",
        "s3": "e*x2 + f*x1",
        "n1": "a + b",
        "n2": "c + d",
        "n3": "e + f"
      },
      "where": ["x1 != x2", "a != b or c != d or e != f", "a != 0 or c != 0 or e != 0", "b != 0 or d != 0 or f != 0", "n1 != r1 or n2 != r2 or n3 != r3"],
      "prompt": "Find $\\mathbf{{A}}\\mathbf{{x}}$ for $\\mathbf{{A}} = \\begin{{pmatrix}} {a} & {b} \\\\ {c} & {d} \\\\ {e} & {f} \\end{{pmatrix}}$ and $\\mathbf{{x}} = ({x1}, {x2})$.",
      "widget": { "kind": "expression", "answer": "({r1}, {r2}, {r3})", "keyboard": "algebra" },
      "wrong": [
        { "id": "amounts-swapped", "tex": "({s1}, {s2}, {s3})", "line": "You took ${x2}$ of column 1 and ${x1}$ of column 2. The first entry of $\\mathbf{{x}}$ goes with column 1." },
        { "id": "added-columns", "tex": "({n1}, {n2}, {n3})", "line": "You added the two columns. Scale column 1 by ${x1}$ and column 2 by ${x2}$ first." }
      ],
      "solution": [
        "Column 1 is $({a}, {c}, {e})$ and column 2 is $({b}, {d}, {f})$.",
        "$\\mathbf{{A}}\\mathbf{{x}}$ is ${x1}$ of column 1 plus ${x2}$ of column 2, which is $({r1}, {r2}, {r3})$."
      ]
    }
  ]
}
