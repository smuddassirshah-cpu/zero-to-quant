{
  "id": "review-1",
  "course": "vectors",
  "level": 1,
  "items": [
    {
      "id": "r-combine",
      "difficulty": 2,
      "skills": [
        "la-vectors"
      ],
      "prose": "$\\mathbf{u} = (1, -1)$ and $\\mathbf{v} = (2, 3)$.",
      "question": "What is $3\\mathbf{u} + 2\\mathbf{v}$?",
      "widget": {
        "kind": "table",
        "columns": [
          "Coordinate",
          "Value"
        ],
        "rows": [
          [
            "first",
            {
              "edit": true,
              "answer": 7,
              "tol": {
                "abs": 0
              },
              "placeholder": "?"
            }
          ],
          [
            "second",
            {
              "edit": true,
              "answer": 3,
              "tol": {
                "abs": 0
              },
              "placeholder": "?"
            }
          ]
        ]
      },
      "feedback": {
        "correct": "$(3 + 4,\\ -3 + 6) = (7, 3)$.",
        "generic": "Not quite right. Stretch each arrow by its weight, then add coordinate by coordinate.",
        "byKey": {
          "r0c1": "First coordinate: $3 \\times 1 + 2 \\times 2$.",
          "r1c1": "Second coordinate: $3 \\times (-1) + 2 \\times 3 = -3 + 6$."
        }
      },
      "explain": {
        "text": "$3\\mathbf{u} = (3, -3)$ and $2\\mathbf{v} = (4, 6)$. Adding gives $(7, 3)$."
      }
    },
    {
      "id": "r-weights",
      "difficulty": 3,
      "skills": [
        "la-vectors"
      ],
      "prose": "$\\mathbf{u} = (1, 1)$ and $\\mathbf{v} = (1, -1)$. You want $a\\mathbf{u} + b\\mathbf{v} = (5, 1)$.",
      "question": "Find $a$ and $b$.",
      "widget": {
        "kind": "table",
        "columns": [
          "Weight",
          "Value"
        ],
        "rows": [
          [
            "$a$",
            {
              "edit": true,
              "answer": 3,
              "tol": {
                "abs": 0
              },
              "placeholder": "?"
            }
          ],
          [
            "$b$",
            {
              "edit": true,
              "answer": 2,
              "tol": {
                "abs": 0
              },
              "placeholder": "?"
            }
          ]
        ]
      },
      "feedback": {
        "correct": "$3(1, 1) + 2(1, -1) = (5, 1)$.",
        "generic": "Not quite right. Write $a + b = 5$ and $a - b = 1$, then solve.",
        "byKey": {
          "r0c1": "Add $a + b = 5$ and $a - b = 1$: $2a = 6$.",
          "r1c1": "Your $a$ is right. Then $b = 5 - a$."
        }
      },
      "explain": {
        "text": "Matching coordinates gives $a + b = 5$ and $a - b = 1$. Adding them, $2a = 6$, so $a = 3$ and $b = 2$."
      }
    },
    {
      "id": "r-span",
      "difficulty": 2,
      "skills": [
        "la-vectors"
      ],
      "prose": "Each option is a pair of arrows from the origin.",
      "question": "Which pair reaches only the points of one line?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "right",
            "text": "$(2, -1)$ and $(-6, 3)$",
            "correct": true
          },
          {
            "id": "perp",
            "text": "$(2, -1)$ and $(1, 2)$",
            "why": "You picked a perpendicular pair: $2 - 2 = 0$. Arrows at right angles are never parallel, so they reach the whole plane."
          },
          {
            "id": "axis",
            "text": "$(1, 0)$ and $(1, 1)$",
            "why": "Neither is a multiple of the other, so their mixes reach every point."
          },
          {
            "id": "swap",
            "text": "$(3, 1)$ and $(1, 3)$",
            "why": "You took swapped coordinates for a multiple. They point in different directions."
          }
        ]
      },
      "feedback": {
        "correct": "$(-6, 3) = -3(2, -1)$: parallel.",
        "generic": "Not quite right. Find the pair where one arrow is a multiple of the other."
      },
      "explain": {
        "text": "$(-6, 3) = -3 \\times (2, -1)$, so both arrows lie on one line through the origin. Every mix stays on that line."
      }
    },
    {
      "id": "r-dot",
      "difficulty": 2,
      "skills": [
        "la-vectors"
      ],
      "prose": "$\\mathbf{u} = (-2, 3)$ and $\\mathbf{v} = (4, 5)$.",
      "question": "What is $\\mathbf{u} \\cdot \\mathbf{v}$?",
      "widget": {
        "kind": "numeric",
        "answer": 7,
        "tol": {
          "abs": 0
        },
        "unit": "",
        "label": "Dot product",
        "placeholder": "a number",
        "accept": "7 exactly: $-8 + 15$.",
        "wrong": [
          {
            "id": "sign",
            "value": 23,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "cross",
            "value": 2,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "$-8 + 15 = 7$.",
        "generic": "Not quite right. Multiply first with first and second with second, then add.",
        "byKey": {
          "sign": "You dropped the minus sign: $(-2) \\times 4 = -8$.",
          "cross": "You crossed over: $(-2) \\times 5 + 3 \\times 4$. Pair first with first."
        }
      },
      "explain": {
        "text": "$(-2)(4) + (3)(5) = -8 + 15 = 7$. It is positive, so the arrows are less than 90° apart."
      }
    },
    {
      "id": "r-perp",
      "difficulty": 3,
      "skills": [
        "la-vectors"
      ],
      "prose": "$\\mathbf{u} = (6, k)$ and $\\mathbf{v} = (2, -3)$.",
      "question": "For which $k$ is $\\mathbf{u}$ perpendicular to $\\mathbf{v}$?",
      "widget": {
        "kind": "numeric",
        "answer": 4,
        "tol": {
          "abs": 0
        },
        "unit": "",
        "label": "k",
        "placeholder": "a number",
        "accept": "4 exactly: $12 - 3k = 0$.",
        "wrong": [
          {
            "id": "sign",
            "value": -4,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "flip",
            "value": 0.25,
            "tol": {
              "abs": 0.001
            }
          }
        ]
      },
      "feedback": {
        "correct": "$(6, 4) \\cdot (2, -3) = 12 - 12 = 0$.",
        "generic": "Not quite right. Set $\\mathbf{u} \\cdot \\mathbf{v} = 12 - 3k$ equal to 0.",
        "byKey": {
          "sign": "You solved $12 + 3k = 0$. The second product is $k \\times (-3) = -3k$.",
          "flip": "You divided 3 by 12. From $3k = 12$, $k = 4$."
        }
      },
      "explain": {
        "text": "$\\mathbf{u} \\cdot \\mathbf{v} = 12 - 3k$. Perpendicular means it is 0, so $k = 4$."
      }
    },
    {
      "id": "r-angle",
      "difficulty": 3,
      "skills": [
        "la-vectors"
      ],
      "prose": "$\\mathbf{u} = (1, 2)$ and $\\mathbf{v} = (2, -4)$.",
      "question": "What is the angle between them, in degrees?",
      "widget": {
        "kind": "numeric",
        "answer": 126.87,
        "tol": {
          "abs": 0.5
        },
        "unit": "degrees",
        "label": "Angle in degrees",
        "placeholder": "a number",
        "accept": "About 126.9°: $\\cos\\theta = -6/10 = -0.6$.",
        "wrong": [
          {
            "id": "acute",
            "value": 53.13,
            "tol": {
              "abs": 0.5
            }
          },
          {
            "id": "cos",
            "value": -0.6,
            "tol": {
              "abs": 0.002
            }
          }
        ]
      },
      "feedback": {
        "correct": "$\\cos\\theta = -0.6$, so $\\theta \\approx 126.9°$.",
        "generic": "Not quite right. Divide the dot product by both lengths, keeping the sign, then take the inverse cosine.",
        "byKey": {
          "acute": "You dropped the minus sign. $\\cos\\theta = -0.6$ gives an angle over 90°.",
          "cos": "That is $\\cos\\theta$. Take its inverse cosine."
        }
      },
      "explain": {
        "text": "$\\mathbf{u} \\cdot \\mathbf{v} = 2 - 8 = -6$, $|\\mathbf{u}| = \\sqrt{5}$ and $|\\mathbf{v}| = \\sqrt{20}$, so $|\\mathbf{u}|\\,|\\mathbf{v}| = 10$. Then $\\cos\\theta = -0.6$ and $\\theta \\approx 126.9°$."
      }
    },
    {
      "id": "r-proj",
      "difficulty": 3,
      "skills": [
        "la-vectors"
      ],
      "prose": "$\\mathbf{u} = (4, 2)$ and $\\mathbf{v} = (1, 3)$.",
      "question": "What is the projection of $\\mathbf{u}$ onto $\\mathbf{v}$?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "right",
            "text": "$(1, 3)$",
            "correct": true
          },
          {
            "id": "no-divide",
            "text": "$(10, 30)$",
            "why": "You multiplied $\\mathbf{v}$ by $\\mathbf{u} \\cdot \\mathbf{v} = 10$. Divide by $\\mathbf{v} \\cdot \\mathbf{v} = 10$ as well."
          },
          {
            "id": "reverse",
            "text": "$(2, 1)$",
            "why": "You projected $\\mathbf{v}$ onto $\\mathbf{u}$. The projection onto $\\mathbf{v}$ is a multiple of $\\mathbf{v}$."
          },
          {
            "id": "unit",
            "text": "$(0.32, 0.95)$",
            "why": "That is the unit vector along $\\mathbf{v}$. The projection is $k\\mathbf{v}$ with $k = \\mathbf{u} \\cdot \\mathbf{v} / \\mathbf{v} \\cdot \\mathbf{v}$."
          }
        ]
      },
      "feedback": {
        "correct": "$k = 10 / 10 = 1$, so the projection is $\\mathbf{v}$ itself.",
        "generic": "Not quite right. Find $k = \\dfrac{\\mathbf{u} \\cdot \\mathbf{v}}{\\mathbf{v} \\cdot \\mathbf{v}}$, then multiply $\\mathbf{v}$ by it."
      },
      "explain": {
        "text": "$\\mathbf{u} \\cdot \\mathbf{v} = 4 + 6 = 10$ and $\\mathbf{v} \\cdot \\mathbf{v} = 1 + 9 = 10$, so $k = 1$. The leftover $\\mathbf{u} - \\mathbf{v} = (3, -1)$ is perpendicular to $\\mathbf{v}$, as it should be."
      }
    },
    {
      "id": "r-return",
      "difficulty": 3,
      "skills": [
        "la-vectors"
      ],
      "prose": "A portfolio has weights $\\mathbf{w} = (0.7, 0.6, -0.3)$, with a short in the third asset. The returns are 4%, $-1$% and 5%.",
      "question": "What is $R_p$?",
      "widget": {
        "kind": "numeric",
        "answer": 0.007,
        "tol": {
          "abs": 0.0005
        },
        "unit": "%",
        "label": "Portfolio return",
        "placeholder": "percent",
        "accept": "0.7%: $0.028 - 0.006 - 0.015$.",
        "wrong": [
          {
            "id": "long",
            "value": 0.037,
            "tol": {
              "abs": 0.0005
            }
          },
          {
            "id": "avg",
            "value": 0.0267,
            "tol": {
              "abs": 0.0005
            }
          }
        ]
      },
      "feedback": {
        "correct": "$0.028 - 0.006 - 0.015 = 0.007$.",
        "generic": "Not quite right. Dot the weights with the returns, keeping both minus signs.",
        "byKey": {
          "long": "You counted the short as a long. The third asset rose 5%, so the short loses: $-0.3 \\times 0.05 = -0.015$.",
          "avg": "You averaged the returns. Weight each one."
        }
      },
      "explain": {
        "text": "$0.7(0.04) + 0.6(-0.01) + (-0.3)(0.05)$ $= 0.028 - 0.006 - 0.015 = 0.007$, a return of 0.7%."
      }
    },
    {
      "id": "r-neutral",
      "difficulty": 4,
      "skills": [
        "la-vectors"
      ],
      "prose": "A long-short book holds $\\mathbf{w} = (2, -3, 1)$ in £m. The stocks' market betas are $\\boldsymbol{\\beta} = (1.1, 0.6, -0.4)$.",
      "question": "What is the book's market exposure, in £m?",
      "widget": {
        "kind": "numeric",
        "answer": 0,
        "tol": {
          "abs": 0.005
        },
        "unit": "",
        "label": "Exposure in £m",
        "placeholder": "£ millions",
        "accept": "0: $2.2 - 1.8 - 0.4$.",
        "wrong": [
          {
            "id": "long",
            "value": 4.4,
            "tol": {
              "abs": 0.005
            }
          },
          {
            "id": "one-sign",
            "value": 0.8,
            "tol": {
              "abs": 0.005
            }
          }
        ]
      },
      "feedback": {
        "correct": "Exactly zero: the book is market neutral.",
        "generic": "Not quite right. Dot the positions with the betas, keeping every sign.",
        "byKey": {
          "long": "You dropped the signs. The short in the second stock gives $(-3)(0.6) = -1.8$.",
          "one-sign": "The third stock has a negative beta: $1 \\times (-0.4) = -0.4$."
        }
      },
      "explain": {
        "text": "$2(1.1) + (-3)(0.6) + 1(-0.4)$ $= 2.2 - 1.8 - 0.4 = 0$. The positions are perpendicular to the betas, so a market move leaves the book flat, to first order."
      }
    },
    {
      "id": "r-pnl",
      "difficulty": 4,
      "skills": [
        "la-vectors"
      ],
      "prose": "A book holds $\\mathbf{q} = (300, -200, 150)$ shares. Today the prices move by $\\Delta\\mathbf{p} = (-0.60, -1.10, 0.80)$ pounds.",
      "question": "What is today's P&L?",
      "widget": {
        "kind": "numeric",
        "answer": 160,
        "tol": {
          "abs": 0.005
        },
        "unit": "£",
        "label": "P&L",
        "placeholder": "pounds",
        "accept": "£160.00: $-180 + 220 + 120$.",
        "wrong": [
          {
            "id": "long",
            "value": -280,
            "tol": {
              "abs": 0.005
            }
          }
        ]
      },
      "feedback": {
        "correct": "£160.00 profit.",
        "generic": "Not quite right. Dot the holdings with the price changes, keeping signs.",
        "byKey": {
          "long": "You treated the short as a long. A short gains when the price falls: $(-200)(-1.10) = +220$."
        }
      },
      "explain": {
        "text": "$300(-0.60) + (-200)(-1.10) + 150(0.80)$ $= -180 + 220 + 120 = 160$. The short made £220 as its price fell."
      }
    }
  ]
}
