{
  "id": "fluency-l7-one-after-another",
  "course": "vectors",
  "lesson": "l7-one-after-another",
  "title": "Fluency: one transformation after another",
  "n": 20,
  "pass": 0.9,
  "minutes": 12,
  "families": [
    {
      "id": "one-entry",
      "weight": 1,
      "skill": "find one entry of a matrix product",
      "vars": {
        "rc": { "pick": [[1, 1], [1, 2], [2, 1], [2, 2]], "as": ["i", "j"] },
        "a": { "int": [-4, 4], "not": [0] },
        "b": { "int": [-4, 4], "not": [0] },
        "c": { "int": [-4, 4], "not": [0] },
        "d": { "int": [-4, 4], "not": [0] },
        "e": { "int": [-4, 4], "not": [0] },
        "f": { "int": [-4, 4], "not": [0] },
        "g": { "int": [-4, 4], "not": [0] },
        "h": { "int": [-4, 4], "not": [0] }
      },
      "let": {
        "ra": "if(i == 1, a, c)",
        "rb": "if(i == 1, b, d)",
        "ce": "if(j == 1, e, f)",
        "cg": "if(j == 1, g, h)",
        "p1": "if(i == 1, a, c)*if(j == 1, e, f)",
        "p2": "if(i == 1, b, d)*if(j == 1, g, h)",
        "key": "if(i == 1, a, c)*if(j == 1, e, f) + if(i == 1, b, d)*if(j == 1, g, h)",
        "ba": "if(i == 1, e, g)*if(j == 1, a, b) + if(i == 1, f, h)*if(j == 1, c, d)",
        "tr": "if(j == 1, a, c)*if(i == 1, e, f) + if(j == 1, b, d)*if(i == 1, g, h)"
      },
      "where": ["key != ba", "i == j or key != tr", "i == j or ba != tr"],
      "prompt": "Take $\\mathbf{{A}} = \\begin{{pmatrix}} {a} & {b} \\\\ {c} & {d} \\end{{pmatrix}}$ and $\\mathbf{{B}} = \\begin{{pmatrix}} {e} & {f} \\\\ {g} & {h} \\end{{pmatrix}}$. Find entry $({i}, {j})$ of $\\mathbf{{AB}}$.",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0 }, "placeholder": "For example 7" },
      "wrong": [
        { "id": "order-swapped", "value": "{ba}", "line": "That is entry $({i}, {j})$ of $\\mathbf{{BA}}$. In $\\mathbf{{AB}}$ the row comes from $\\mathbf{{A}}$ and the column from $\\mathbf{{B}}$." },
        { "id": "row-column-swapped", "value": "{tr}", "line": "That is entry $({j}, {i})$. Use row {i} of $\\mathbf{{A}}$ and column {j} of $\\mathbf{{B}}$.", "when": "i != j" }
      ],
      "solution": [
        "Row {i} of $\\mathbf{{A}}$ is $({ra}, {rb})$ and column {j} of $\\mathbf{{B}}$ is $({ce}, {cg})$.",
        "Dot them: ${p1}{p2:+} = {key}$."
      ]
    },
    {
      "id": "one-column",
      "weight": 1,
      "skill": "find one column of a matrix product",
      "vars": {
        "j": { "pick": [1, 2] },
        "a": { "int": [-4, 4], "not": [0] },
        "b": { "int": [-4, 4], "not": [0] },
        "c": { "int": [-4, 4], "not": [0] },
        "d": { "int": [-4, 4], "not": [0] },
        "e": { "int": [-4, 4], "not": [0] },
        "f": { "int": [-4, 4], "not": [0] },
        "g": { "int": [-4, 4], "not": [0] },
        "h": { "int": [-4, 4], "not": [0] }
      },
      "let": {
        "x1": "if(j == 1, e, f)",
        "x2": "if(j == 1, g, h)",
        "k1": "a*if(j == 1, e, f) + b*if(j == 1, g, h)",
        "k2": "c*if(j == 1, e, f) + d*if(j == 1, g, h)",
        "w1": "e*if(j == 1, a, b) + f*if(j == 1, c, d)",
        "w2": "g*if(j == 1, a, b) + h*if(j == 1, c, d)",
        "q1": "a*if(j == 1, e, f) + c*if(j == 1, g, h)",
        "q2": "b*if(j == 1, e, f) + d*if(j == 1, g, h)"
      },
      "where": ["k1 != w1 or k2 != w2", "k1 != q1 or k2 != q2", "w1 != q1 or w2 != q2"],
      "prompt": "Take $\\mathbf{{A}} = \\begin{{pmatrix}} {a} & {b} \\\\ {c} & {d} \\end{{pmatrix}}$ and $\\mathbf{{B}} = \\begin{{pmatrix}} {e} & {f} \\\\ {g} & {h} \\end{{pmatrix}}$. Find column {j} of $\\mathbf{{AB}}$.",
      "widget": { "kind": "expression", "answer": "({k1}, {k2})", "keyboard": "algebra" },
      "wrong": [
        { "id": "order-swapped", "tex": "({w1}, {w2})", "line": "That is column {j} of $\\mathbf{{BA}}$. Column {j} of $\\mathbf{{AB}}$ is $\\mathbf{{A}}$ times column {j} of $\\mathbf{{B}}$." },
        { "id": "combined-rows", "tex": "({q1}, {q2})", "line": "You combined the rows of $\\mathbf{{A}}$. The entries of column {j} of $\\mathbf{{B}}$ scale the columns of $\\mathbf{{A}}$." }
      ],
      "solution": [
        "Column {j} of $\\mathbf{{AB}}$ is $\\mathbf{{A}}$ times column {j} of $\\mathbf{{B}}$, which is $({x1}, {x2})$.",
        "That is ${x1}$ of $({a}, {c})$ plus ${x2}$ of $({b}, {d})$, so the column is $({k1}, {k2})$."
      ]
    }
  ]
}
