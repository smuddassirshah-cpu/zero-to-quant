{
  "id": "fluency-l15-widest-street",
  "lesson": "l15-widest-street",
  "title": "Fluency: margins and decision values",
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "margin",
      "weight": 1,
      "skill": "the margin from the weights",
      "vars": {
        "h1": {
          "int": [
            -6,
            6
          ],
          "not": [
            0
          ]
        },
        "h2": {
          "int": [
            -6,
            6
          ]
        },
        "b": {
          "int": [
            -5,
            5
          ]
        }
      },
      "let": {
        "w1": "h1/2",
        "w2": "h2/2",
        "nsq": "(h1^2 + h2^2)/4",
        "norm": "sqrt((h1^2 + h2^2)/4)",
        "key": "1/sqrt((h1^2 + h2^2)/4)",
        "width": "2/sqrt((h1^2 + h2^2)/4)"
      },
      "where": [
        "h1^2 + h2^2 != 4",
        "h1^2 + h2^2 != 8"
      ],
      "prompt": "A fitted linear SVM has $w = ({w1}, {w2})$ and $b = {b}$. What is its margin, the distance from the centre line to either edge? Give 4 decimal places.",
      "widget": {
        "kind": "numeric",
        "answer": "{key}",
        "tol": {
          "abs": 5e-05
        },
        "placeholder": "A number such as 1.4142",
        "accept": "${key:dp4}$, within 0.00005"
      },
      "wrong": [
        {
          "id": "gave-norm",
          "value": "{norm}",
          "tol": {
            "abs": 5e-05
          },
          "line": "You gave $\\lVert w \\rVert$. On an edge $w \\cdot x + b = \\pm 1$, so the margin is $\\tfrac{{1}}{{\\lVert w \\rVert}}$."
        },
        {
          "id": "street-width",
          "value": "{width}",
          "tol": {
            "abs": 5e-05
          },
          "line": "You gave the whole street, edge to edge. The margin is half of it, $\\tfrac{{1}}{{\\lVert w \\rVert}}$."
        }
      ],
      "solution": [
        "$\\lVert w \\rVert = \\sqrt{{{w1:()}^2 + {w2:()}^2}} = \\sqrt{{{nsq}}}$.",
        "The margin is $\\tfrac{{1}}{{\\lVert w \\rVert}} \\approx {key:dp4}$; the intercept $b$ moves the street but not its width."
      ]
    },
    {
      "id": "decision-value",
      "weight": 1,
      "skill": "a decision value",
      "vars": {
        "w1": {
          "int": [
            -4,
            4
          ],
          "not": [
            0
          ]
        },
        "w2": {
          "int": [
            -4,
            4
          ],
          "not": [
            0
          ]
        },
        "b": {
          "int": [
            -6,
            6
          ],
          "not": [
            0
          ]
        },
        "x1": {
          "int": [
            -3,
            4
          ],
          "not": [
            0
          ]
        },
        "x2": {
          "int": [
            -3,
            4
          ],
          "not": [
            0
          ]
        }
      },
      "let": {
        "t1": "w1*x1",
        "t2": "w2*x2",
        "key": "w1*x1 + w2*x2 + b",
        "nob": "w1*x1 + w2*x2",
        "one": "w1*x1 + b"
      },
      "where": [
        "w1*x1 + w2*x2 + b != 0",
        "w2*x2 != b"
      ],
      "prompt": "A linear SVM has $w = ({w1}, {w2})$ and $b = {b}$. What is the decision value $w \\cdot x + b$ of the point $x = ({x1}, {x2})$?",
      "widget": {
        "kind": "numeric",
        "answer": "{key}",
        "tol": {
          "abs": 0
        },
        "placeholder": "A whole number"
      },
      "wrong": [
        {
          "id": "no-intercept",
          "value": "{nob}",
          "tol": {
            "abs": 0
          },
          "line": "You stopped at $w \\cdot x$. Add the intercept $b = {b}$."
        },
        {
          "id": "one-term",
          "value": "{one}",
          "tol": {
            "abs": 0
          },
          "line": "You used only the first feature. The second adds ${w2} \\times {x2:()} = {t2}$."
        }
      ],
      "solution": [
        "$w \\cdot x = {w1} \\times {x1:()} {w2:+} \\times {x2:()} = {t1} {t2:+}$.",
        "Adding $b$ gives ${nob} {b:+} = {key}$."
      ]
    },
    {
      "id": "distance",
      "weight": 2,
      "skill": "a point's distance from the centre line",
      "vars": {
        "w1": {
          "int": [
            -4,
            4
          ],
          "not": [
            0
          ]
        },
        "w2": {
          "int": [
            -4,
            4
          ]
        },
        "b": {
          "int": [
            -6,
            6
          ]
        },
        "x1": {
          "int": [
            -3,
            4
          ]
        },
        "x2": {
          "int": [
            -3,
            4
          ]
        }
      },
      "let": {
        "f": "w1*x1 + w2*x2 + b",
        "af": "abs(w1*x1 + w2*x2 + b)",
        "nsq": "w1^2 + w2^2",
        "key": "abs(w1*x1 + w2*x2 + b)/sqrt(w1^2 + w2^2)",
        "squared": "abs(w1*x1 + w2*x2 + b)/(w1^2 + w2^2)"
      },
      "where": [
        "w1^2 + w2^2 != 1",
        "w1*x1 + w2*x2 + b != 0"
      ],
      "prompt": "A linear SVM has $w = ({w1}, {w2})$ and $b = {b}$. How far is the point $({x1}, {x2})$ from its centre line? Give 2 decimal places.",
      "widget": {
        "kind": "numeric",
        "answer": "{key}",
        "tol": {
          "abs": 0.005
        },
        "placeholder": "A number such as 2.83",
        "accept": "${key:dp2}$, within 0.005"
      },
      "wrong": [
        {
          "id": "no-norm",
          "value": "{af}",
          "tol": {
            "abs": 0.005
          },
          "line": "You gave $|w \\cdot x + b|$, which counts margins, not distance. Divide by $\\lVert w \\rVert$."
        },
        {
          "id": "squared-norm",
          "value": "{squared}",
          "tol": {
            "abs": 0.005
          },
          "line": "You divided by $\\lVert w \\rVert^2 = {nsq}$. Divide by $\\lVert w \\rVert = \\sqrt{{{nsq}}}$."
        }
      ],
      "solution": [
        "The decision value is ${f}$ and $\\lVert w \\rVert = \\sqrt{{{nsq}}}$.",
        "The distance is $\\tfrac{{|w \\cdot x + b|}}{{\\lVert w \\rVert}} = \\tfrac{{{af}}}{{\\sqrt{{{nsq}}}}} \\approx {key:dp2}$."
      ]
    }
  ]
}
