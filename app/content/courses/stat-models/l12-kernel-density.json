    "language": "python",
    "starter": "import numpy as np\nfrom scipy.optimize import brentq\nfrom scipy.stats import norm\n\n\ndef kde(x_grid, data, h):\n    \"\"\"Gaussian KDE at each point of x_grid, no loops.\"\"\"\n    ...\n\n\ndef silverman_h(data):\n    \"\"\"0.9 min(s, IQR / 1.34) n^(-1/5), IQR from np.percentile.\"\"\"\n    ...\n\n\ndef kde_quantile(data, h, q):\n    \"\"\"x with mean(Phi((x - data) / h)) = q.\"\"\"\n    ...\n",
    "solution": "import numpy as np\nfrom scipy.optimize import brentq\nfrom scipy.stats import norm\n\n\ndef kde(x_grid, data, h):\n    x = np.asarray(x_grid, dtype=float)[:, None]\n    d = np.asarray(data, dtype=float)[None, :]\n    return norm.pdf((x - d) / h).mean(axis=1) / h\n\n\ndef silverman_h(data):\n    data = np.asarray(data, dtype=float)\n    q75, q25 = np.percentile(data, [75, 25])\n    s = data.std(ddof=1)\n    return 0.9 * min(s, (q75 - q25) / 1.34) * len(data) ** -0.2\n\n\ndef kde_quantile(data, h, q):\n    data = np.asarray(data, dtype=float)\n    f = lambda x: norm.cdf((x - data) / h).mean() - q\n    lo, hi = data.min() - 10 * h, data.max() + 10 * h\n    return brentq(f, lo, hi, xtol=1e-12)\n",
