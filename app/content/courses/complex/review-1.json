    {
      "id": "r-fourth-roots",
      "difficulty": 2,
      "skills": [
        "cz-polar"
      ],
      "prose": "Solve $z^4 = 1$.",
      "question": "Which list holds every fourth root of unity?",
      "widget": {
        "kind": "choice",
        "options": [
          {
            "id": "a",
            "text": "$1, i, -1, -i$",
            "correct": true
          },
          {
            "id": "b",
            "text": "$1, -1$",
            "why": "Those are the real roots. Two more lie on the unit circle at 90 and 270 degrees."
          },
          {
            "id": "c",
            "text": "$1, \\frac14, \\frac{1}{16}, \\frac{1}{64}$",
            "why": "Roots of unity all have modulus 1, so they sit on the unit circle."
          },
          {
            "id": "d",
            "text": "$1, \\frac{1 + i}{\\sqrt2}, i, \\frac{-1 + i}{\\sqrt2}$",
            "why": "Those are 45 degrees apart: eighth roots. Fourth roots are 90 degrees apart."
          }
        ],
        "shuffle": true
      },
      "feedback": {
        "correct": "The corners of a square: $1, i, -1, -i$.",
        "generic": "Not quite. Space four points equally round the unit circle, starting at 1."
      },
      "explain": {
        "text": "The fourth roots of unity are $e^{2\\pi ik/4} = i^k$ for $k = 0, 1, 2, 3$: $1, i, -1, -i$. Each has $(i^k)^4 = (i^4)^k = 1$."
      }
    },
    {
      "id": "r-i-power",
      "difficulty": 2,
      "skills": [
        "cz-arith"
      ],
      "prose": "Powers of $i$ repeat.",
      "question": "What is $i^{99}$?",
      "widget": {
        "kind": "expression",
        "answer": "-i",
        "accept": [
          "-i"
        ],
        "wrong": [
          {
            "id": "rem-one",
            "tex": "i"
          },
          {
            "id": "odd-minus",
            "tex": "-1"
          }
        ],
        "keyboard": "algebra"
      },
      "feedback": {
        "correct": "$99 = 4 \\times 24 + 3$, so $i^{99} = i^3 = -i$.",
        "generic": "Not quite. Find the remainder of 99 on division by 4.",
        "byKey": {
          "rem-one": "That is the value for remainder 1. $99 = 96 + 3$, so the remainder is 3.",
          "odd-minus": "An odd power of $i$ is never real: $i^{odd}$ is $i$ or $-i$."
        }
      },
      "explain": {
        "text": "$99 = 4 \\times 24 + 3$, and $i^4 = 1$, so $i^{99} = i^3 = -i$."
      }
    },
