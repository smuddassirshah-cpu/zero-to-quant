    {
      "id": "r-quotient",
      "difficulty": 2,
      "skills": [
        "cz-arith"
      ],
      "prose": "Divide two complex numbers.",
      "question": "Work out $\\dfrac{1 + 2i}{2 - i}$.",
      "widget": {
        "kind": "expression",
        "answer": "i",
        "accept": [
          "i"
        ],
        "wrong": [
          {
            "id": "partwise",
            "tex": "\\frac{1}{2}-2i"
          },
          {
            "id": "den-minus",
            "tex": "\\frac{5}{3}i"
          },
          {
            "id": "top-wrong",
            "tex": "\\frac{4+3i}{5}"
          }
        ],
        "keyboard": "algebra"
      },
      "feedback": {
        "correct": "$\\dfrac{(1 + 2i)(2 + i)}{5} = \\dfrac{5i}{5} = i$.",
        "generic": "Not quite. Multiply top and bottom by the conjugate $2 + i$.",
        "byKey": {
          "partwise": "You divided part by part. Multiply top and bottom by $2 + i$ instead.",
          "den-minus": "Your bottom used $i^2 = +1$. In fact $(2 - i)(2 + i) = 4 + 1 = 5$.",
          "top-wrong": "You multiplied the top by $2 - i$ itself. Use the conjugate $2 + i$."
        }
      },
      "explain": {
        "text": "Top: $(1 + 2i)(2 + i) = 2 + i + 4i + 2i^2 = 5i$. Bottom: $(2 - i)(2 + i) = 5$. So the quotient is $i$; check: $i(2 - i) = 2i + 1$."
      }
    },
