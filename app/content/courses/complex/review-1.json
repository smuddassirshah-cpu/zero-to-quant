          {
            "id": "c",
            "text": "$4i$",
            "why": "You kept one $i$. $i\\sqrt2 \\times i\\sqrt8 = i^2\\sqrt{16} = -4$."
          },
          {
            "id": "d",
            "text": "Not defined",
            "why": "Each root is defined with $i$: $\\sqrt{-2} = i\\sqrt2$."
          }
