{
  "id": "fluency-l2-points-in-a-plane",
  "lesson": "l2-points-in-a-plane",
  "title": "Fluency: modulus, argument and polar form",
  "n": 20,
  "pass": 0.9,
  "minutes": 12,
  "families": [
    {
      "id": "modulus",
      "weight": 1,
      "skill": "find the modulus of a complex number",
      "vars": {
        "a": { "int": [-9, 9], "not": [0] },
        "b": { "int": [-9, 9], "not": [0] }
      },
      "let": {
        "n": "a^2 + b^2",
        "r": "sqrt(a^2 + b^2)",
        "added": "abs(a) + abs(b)"
      },
      "where": ["abs(a) + abs(b) != a^2 + b^2"],
      "prompt": "Find $|{a}{b:+c}i|$. Give it to 3 decimal places.",
      "widget": { "kind": "numeric", "answer": "{r}", "tol": { "abs": 0.0005 }, "placeholder": "For example 3.606", "accept": "$\\sqrt{{{n}}} = {r:dp3}$ to 3 decimal places" },
      "wrong": [
        { "id": "added-parts", "value": "{added}", "tol": { "abs": 0.0005 }, "line": "You added the two parts. The modulus is $\\sqrt{{x^2 + y^2}}$, the length of the arrow." },
        { "id": "no-root", "value": "{n}", "tol": { "abs": 0.0005 }, "line": "You stopped at ${a:()}^2 + {b:()}^2 = {n}$. The modulus is its square root." }
      ],
      "solution": [
        "The point is $({a}, {b})$, so $|z|^2 = {a:()}^2 + {b:()}^2 = {n}$.",
        "So $|z| = \\sqrt{{{n}}} = {r:dp3}$ to 3 decimal places."
      ]
    },
    {
      "id": "distance",
      "weight": 1,
      "skill": "find the distance between two complex numbers",
      "vars": {
        "a": { "int": [-6, 6], "not": [0] },
        "b": { "int": [-6, 6], "not": [0] },
        "c": { "int": [-6, 6], "not": [0] },
        "d": { "int": [-6, 6], "not": [0] }
      },
      "let": {
        "x": "a - c",
        "y": "b - d",
        "n": "(a - c)^2 + (b - d)^2",
        "r": "sqrt((a - c)^2 + (b - d)^2)",
        "sm": "sqrt((a + c)^2 + (b + d)^2)",
        "md": "abs(sqrt(a^2 + b^2) - sqrt(c^2 + d^2))"
      },
      "where": ["a != c", "b != d", "a*c + b*d != 0"],
      "prompt": "Take $z = {a}{b:+c}i$ and $w = {c}{d:+c}i$. Find $|z - w|$ to 3 decimal places.",
      "widget": { "kind": "numeric", "answer": "{r}", "tol": { "abs": 0.0005 }, "placeholder": "For example 3.606", "accept": "$\\sqrt{{{n}}} = {r:dp3}$ to 3 decimal places" },
      "wrong": [
        { "id": "sum-not-difference", "value": "{sm}", "tol": { "abs": 0.0005 }, "line": "That is $|z + w|$. The question asks for the difference $z - w$." },
        { "id": "moduli-subtracted", "value": "{md}", "tol": { "abs": 0.0005 }, "line": "You subtracted the moduli. Subtract the numbers first: $z - w = {x}{y:+c}i$.", "when": "abs(md - r) > 0.001" },
        { "id": "no-root", "value": "{n}", "tol": { "abs": 0.0005 }, "line": "You stopped at ${x:()}^2 + {y:()}^2 = {n}$. The modulus is its square root." }
      ],
      "solution": [
        "Subtract part by part: $z - w = {x}{y:+c}i$.",
        "So $|z - w| = \\sqrt{{{x:()}^2 + {y:()}^2}} = \\sqrt{{{n}}} = {r:dp3}$ to 3 decimal places."
      ]
    },
    {
      "id": "principal-argument",
      "weight": 2,
      "skill": "find a principal argument exactly",
      "vars": {
        "pt": {
          "pick": [
            [1, 1, "", "", 1, 4, 1, 4, "first", "\\frac{\\pi}{4}"],
            [-1, 1, "", "", 3, 4, -1, 4, "second", "\\frac{\\pi}{4}"],
            [-1, -1, "", "", -3, 4, 1, 4, "third", "\\frac{\\pi}{4}"],
            [1, -1, "", "", -1, 4, -1, 4, "fourth", "\\frac{\\pi}{4}"],
            [1, 1, "\\sqrt{3}", "", 1, 6, 1, 6, "first", "\\frac{\\pi}{6}"],
            [-1, 1, "\\sqrt{3}", "", 5, 6, -1, 6, "second", "\\frac{\\pi}{6}"],
            [-1, -1, "\\sqrt{3}", "", -5, 6, 1, 6, "third", "\\frac{\\pi}{6}"],
            [1, -1, "\\sqrt{3}", "", -1, 6, -1, 6, "fourth", "\\frac{\\pi}{6}"],
            [1, 1, "", "\\sqrt{3}", 1, 3, 1, 3, "first", "\\frac{\\pi}{3}"],
            [-1, 1, "", "\\sqrt{3}", 2, 3, -1, 3, "second", "\\frac{\\pi}{3}"],
            [-1, -1, "", "\\sqrt{3}", -2, 3, 1, 3, "third", "\\frac{\\pi}{3}"],
            [1, -1, "", "\\sqrt{3}", -1, 3, -1, 3, "fourth", "\\frac{\\pi}{3}"]
          ],
          "as": ["sx", "sy", "ra", "ia", "p", "q", "ap", "aq", "quad", "ref"]
        },
        "k": { "int": [2, 9] }
      },
      "let": {
        "re": "sx*k",
        "im": "sy*k",
        "wp": "p + 2*q"
      },
      "prompt": "Find $\\operatorname{{Arg}}({re}{ra}{im:+}{ia}i)$ exactly, in radians.",
      "widget": { "kind": "expression", "answer": "\\frac{{{p:c}\\pi}}{{{q}}}", "form": "exact-angle", "accept": ["\\frac{{{p}}}{{{q}}}\\pi"], "keyboard": "algebra" },
      "wrong": [
        { "id": "arctan-only", "tex": "\\frac{{{ap:c}\\pi}}{{{aq}}}", "line": "You used $\\arctan(b/a)$, which cannot see the quadrant. The point is in the {quad} quadrant.", "when": "sx < 0" },
        { "id": "not-principal", "tex": "\\frac{{{wp:c}\\pi}}{{{q}}}", "line": "That is an argument, but it is above $\\pi$. The principal one lies in $(-\\pi, \\pi]$.", "when": "p < 0" }
      ],
      "solution": [
        "The point $({re}{ra}, {im}{ia})$ lies in the {quad} quadrant, at angle ${ref}$ from the real axis.",
        "So $\\operatorname{{Arg}} = {p/q:frac}\\pi$, which lies in $(-\\pi, \\pi]$."
      ]
    },
    {
      "id": "from-polar",
      "weight": 2,
      "skill": "turn the polar form into x + iy",
      "vars": {
        "ang": {
          "pick": [
            ["\\frac{\\pi}{6}", 1, "\\sqrt{3}", 1, "", "\\frac{\\sqrt{3}}{2}+\\frac{1}{2}i"],
            ["\\frac{5\\pi}{6}", -1, "\\sqrt{3}", 1, "", "-\\frac{\\sqrt{3}}{2}+\\frac{1}{2}i"],
            ["-\\frac{\\pi}{6}", 1, "\\sqrt{3}", -1, "", "\\frac{\\sqrt{3}}{2}-\\frac{1}{2}i"],
            ["-\\frac{5\\pi}{6}", -1, "\\sqrt{3}", -1, "", "-\\frac{\\sqrt{3}}{2}-\\frac{1}{2}i"]
          ],
          "as": ["th", "ca", "su", "cb", "sv", "unit"]
        },
        "r": { "int": [4, 40], "step": 2 }
      },
      "let": {
        "h": "r/2",
        "x": "r/2*ca",
        "y": "r/2*cb"
      },
      "prompt": "Write ${r}\\left(\\cos\\left({th}\\right) + i\\sin\\left({th}\\right)\\right)$ in the form $x + iy$, exactly.",
      "widget": { "kind": "expression", "answer": "{x}{su}{y:+}{sv}i", "form": "rectangular", "keyboard": "algebra" },
      "wrong": [
        { "id": "cos-sin-swapped", "tex": "{y}{sv}{x:+}{su}i", "line": "You swapped the cosine and the sine. The real part is $r\\cos\\theta$." },
        { "id": "forgot-r", "tex": "{unit}", "line": "You found $\\cos\\theta + i\\sin\\theta$ but did not multiply by $r = {r}$." }
      ],
      "solution": [
        "$\\cos\\left({th}\\right) + i\\sin\\left({th}\\right) = {unit}$.",
        "Multiply both parts by ${r}$: the number is ${x}{su}{y:+}{sv}i$."
      ]
    }
  ]
}
