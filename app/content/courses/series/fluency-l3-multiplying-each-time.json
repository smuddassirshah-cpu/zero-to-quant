{
  "id": "fluency-l3-multiplying-each-time",
  "lesson": "l3-multiplying-each-time",
  "title": "Fluency: geometric sequences",
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "geometric-term",
      "weight": 2,
      "skill": "find a term of a geometric sequence",
      "vars": {
        "r": { "pick": [2, 3, -2, -3, 0.5, -0.5] },
        "k": { "int": [4, 7] },
        "m": { "int": [1, 5] },
        "s": { "pick": [1, -1] }
      },
      "let": {
        "den": "1 + floor(1/abs(r))/2",
        "a": "s*m*den^(k - 1)",
        "t2": "a*r", "t3": "a*r^2", "km": "k - 1",
        "u": "a*r^(k - 1)", "over": "a*r^k", "added": "a + (k - 1)*(a*r - a)"
      },
      "where": ["abs(u) <= 1500", "added != u"],
      "prompt": "A geometric sequence begins ${a}, {t2}, {t3}, \\dots$ What is $u_{{{k}}}$?",
      "widget": { "kind": "numeric", "answer": "{u}", "tol": { "abs": 0 }, "placeholder": "A number" },
      "wrong": [
        { "id": "k-factors", "value": "{over}", "line": "You used {k} factors of $r$, but $u_{{{k}}}$ has only {km}." },
        { "id": "added-the-step", "value": "{added}", "line": "You added the same step each time. This sequence multiplies by the same number." }
      ],
      "solution": [
        "The ratio is $r = {t2} \\div {a:()} = {r}$.",
        "$u_{{{k}}}$ has {km} factors of $r$, so $u_{{{k}}} = {a} \\times {r:()}^{{{km}}} = {u}$."
      ]
    },
    {
      "id": "common-ratio",
      "weight": 1,
      "skill": "find the common ratio",
      "vars": {
        "p": { "int": [-5, 5], "not": [0] },
        "q": { "pick": [1, 2, 4, 5] },
        "m": { "int": [1, 6] },
        "s": { "pick": [1, -1] }
      },
      "let": { "a": "s*m*q^2", "t2": "s*m*p*q", "t3": "s*m*p^2", "r": "p/q", "flip": "q/p", "step": "s*m*p*q - s*m*q^2" },
      "where": ["gcd(abs(p), q) == 1", "abs(p) != q", "step != p/q", "step != q/p"],
      "prompt": "A geometric sequence begins ${a}, {t2}, {t3}, \\dots$ What is its common ratio $r$?",
      "widget": { "kind": "numeric", "answer": "{r}", "tol": { "abs": 0 }, "placeholder": "A fraction or a decimal" },
      "wrong": [
        { "id": "upside-down", "value": "{flip}", "line": "You divided the first term by the second. Divide each term by the one before." },
        { "id": "difference", "value": "{step}", "line": "You took the difference of two terms. A geometric sequence has a common ratio, not a difference." }
      ],
      "solution": [
        "Divide each term by the one before: ${t2} \\div {a:()} = {r}$.",
        "Check: ${t3} \\div {t2:()} = {r}$, so $r = {r}$."
      ]
    },
    {
      "id": "geometric-formula",
      "weight": 1,
      "skill": "write the rule for the nth term",
      "vars": {
        "a": { "int": [-9, 12], "not": [0, 1, -1] },
        "r": { "pick": [2, 3, 4, 5, -2, -3] }
      },
      "let": { "t2": "a*r", "t3": "a*r^2", "d": "a*r - a", "c": "2*a - a*r" },
      "where": ["a != r"],
      "prompt": "Write $u_n$ for the sequence ${a}, {t2}, {t3}, \\dots$",
      "widget": { "kind": "expression", "answer": "{a} \\times {r:()}^{{n-1}}", "integers": ["n"], "keyboard": "algebra" },
      "wrong": [
        { "id": "n-factors", "tex": "{a} \\times {r:()}^{{n}}", "line": "You used $n$ factors of $r$. At $n = 1$ that gives {t2}, which is $u_2$." },
        { "id": "ratio-and-first-swapped", "tex": "{r:()} \\times {a:()}^{{n-1}}", "line": "You swapped the first term and the ratio. The ratio, {r}, is the number raised to a power." },
        { "id": "arithmetic-rule", "tex": "{poly(n; d, c)}", "line": "That is the arithmetic rule through the first two terms. This sequence multiplies by {r} each time." }
      ],
      "solution": [
        "The first term is {a} and $r = {t2} \\div {a:()} = {r}$.",
        "Term $n$ has $n - 1$ factors of $r$: $u_n = {a} \\times {r:()}^{{n-1}}$."
      ]
    }
  ]
}
