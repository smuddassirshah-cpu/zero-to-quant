{
  "id": "review-1",
  "course": "series",
  "level": 1,
  "items": [
    {
      "id": "r-falling",
      "difficulty": 2,
      "skills": [
        "seq-arith"
      ],
      "prose": "A sequence begins $31, 26, 21, 16, \\dots$",
      "question": "What is the next term?",
      "widget": {
        "kind": "numeric",
        "answer": 11,
        "tol": {
          "abs": 0
        },
        "label": "Next term",
        "accept": "11: the rule is subtract 5.",
        "placeholder": "A whole number",
        "wrong": [
          {
            "id": "sign",
            "value": 21,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "six",
            "value": 10,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "Subtract 5: 16 − 5 = 11.",
        "generic": "Not quite right. Find the gap between neighbours, including its sign.",
        "byKey": {
          "sign": "You added 5. The terms fall by 5 each time.",
          "six": "You subtracted 6. Check a gap: $31 - 26 = 5$."
        }
      },
      "explain": {
        "text": "Each gap is −5, so the term-to-term rule is subtract 5. The next term is $16 - 5 = 11$."
      }
    },
    {
      "id": "r-two-readings",
      "difficulty": 3,
      "skills": [
        "seq-arith",
        "seq-geom"
      ],
      "prose": "A sequence begins 4, 12, ….",
      "question": "What is the third term if it is arithmetic, and if it is geometric?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "right",
            "text": "Arithmetic 20, geometric 36",
            "correct": true
          },
          {
            "id": "swap",
            "text": "Arithmetic 36, geometric 20",
            "why": "You swapped them. Adding the gap of 8 gives 20; multiplying by 3 gives 36."
          },
          {
            "id": "double",
            "text": "Arithmetic 20, geometric 24",
            "why": "You doubled 12. The ratio is $12 \\div 4 = 3$, so the geometric third term is 36."
          },
          {
            "id": "same",
            "text": "Both 20: two terms fix the rule",
            "why": "Two terms fit both kinds of rule. The ratio reading gives $12 \\times 3 = 36$."
          }
        ]
      },
      "feedback": {
        "correct": "Add 8 for 20, or multiply by 3 for 36.",
        "generic": "Not quite right. Work out the difference and the ratio of 4 and 12."
      },
      "explain": {
        "text": "The difference is 8 and the ratio is 3. Arithmetic gives $12 + 8 = 20$; geometric gives $12 \\times 3 = 36$. Two terms cannot tell them apart."
      }
    },
    {
      "id": "r-formula",
      "difficulty": 2,
      "skills": [
        "seq-arith"
      ],
      "prose": "An arithmetic sequence begins $12, 9, 6, 3, \\dots$",
      "question": "Which formula gives $u_n$?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "right",
            "text": "$15 - 3n$",
            "correct": true
          },
          {
            "id": "a-nd",
            "text": "$12 - 3n$",
            "why": "You took $n$ steps from the first term. At $n = 1$ this gives 9, which is $u_2$."
          },
          {
            "id": "sign",
            "text": "$3n + 9$",
            "why": "You dropped the minus sign. This climbs: 12, 15, 18."
          },
          {
            "id": "swap",
            "text": "$12n - 3$",
            "why": "You multiplied $n$ by the first term. The difference, −3, multiplies $n$."
          }
        ]
      },
      "feedback": {
        "correct": "$12 - 3(n - 1) = 15 - 3n$.",
        "generic": "Not quite right. Test each formula at $n = 1$ and $n = 2$."
      },
      "explain": {
        "text": "$a = 12$ and $d = -3$, so $u_n = 12 - 3(n - 1) = 15 - 3n$. Check: $u_1 = 12$ and $u_4 = 3$."
      }
    },
    {
      "id": "r-which-power",
      "difficulty": 3,
      "skills": [
        "seq-geom"
      ],
      "prose": "A geometric sequence has $u_n = 2 \\times 3^{n-1}$.",
      "question": "Which term equals 486?",
      "widget": {
        "kind": "numeric",
        "answer": 6,
        "tol": {
          "abs": 0
        },
        "label": "Position of 486",
        "accept": "$u_6 = 2 \\times 3^5 = 486$.",
        "placeholder": "A position",
        "wrong": [
          {
            "id": "power",
            "value": 5,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "half",
            "value": 243,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "$486 = 2 \\times 243 = 2 \\times 3^5$, so $n - 1 = 5$.",
        "generic": "Not quite right. Divide 486 by 2, then find the power of 3.",
        "byKey": {
          "power": "5 is the power of 3. The power is $n - 1$, so $n = 6$.",
          "half": "243 is $486 \\div 2$. Now write it as a power of 3."
        }
      },
      "explain": {
        "text": "$486 \\div 2 = 243 = 3^5$. The power is $n - 1$, so $n = 6$."
      }
    },
    {
      "id": "r-recur",
      "difficulty": 3,
      "skills": [
        "seq-arith",
        "seq-geom"
      ],
      "prose": "A sequence has $u_{n+1} = 0.5u_n + 6$ and $u_1 = 20$.",
      "question": "What is $u_3$?",
      "widget": {
        "kind": "numeric",
        "answer": 14,
        "tol": {
          "abs": 0.001
        },
        "label": "u3",
        "accept": "14: the terms are 20, 16, 14.",
        "placeholder": "A number",
        "wrong": [
          {
            "id": "n-in",
            "value": 7,
            "tol": {
              "abs": 0.001
            }
          },
          {
            "id": "u2",
            "value": 16,
            "tol": {
              "abs": 0.001
            }
          }
        ]
      },
      "feedback": {
        "correct": "20, 16, 14.",
        "generic": "Not quite right. Make $u_2$ from 20, then $u_3$ from $u_2$.",
        "byKey": {
          "n-in": "You put the position, 2, into the rule. It takes the last term, $u_2 = 16$.",
          "u2": "That is $u_2$. Apply the rule once more."
        }
      },
      "explain": {
        "text": "$u_2 = 0.5 \\times 20 + 6 = 16$ and $u_3 = 0.5 \\times 16 + 6 = 14$. The terms are heading down towards 12."
      }
    },
    {
      "id": "r-settle",
      "difficulty": 3,
      "skills": [
        "seq-converge"
      ],
      "prose": "The terms of $u_{n+1} = 0.75u_n + 5$ settle.",
      "question": "At which value?",
      "widget": {
        "kind": "numeric",
        "answer": 20,
        "tol": {
          "abs": 0.001
        },
        "label": "Settling value",
        "accept": "20, since $0.75 \\times 20 + 5 = 20$.",
        "placeholder": "A number",
        "wrong": [
          {
            "id": "add",
            "value": 5,
            "tol": {
              "abs": 0.001
            }
          },
          {
            "id": "divide",
            "value": 6.6667,
            "tol": {
              "abs": 0.01
            }
          }
        ]
      },
      "feedback": {
        "correct": "$L = 0.75L + 5$ gives $0.25L = 5$, so $L = 20$.",
        "generic": "Not quite right. Solve $L = 0.75L + 5$.",
        "byKey": {
          "add": "5 is the amount added. Test it: $0.75 \\times 5 + 5 = 8.75$, so 5 moves.",
          "divide": "You divided 5 by 0.75. Subtract $0.75L$ first: $0.25L = 5$."
        }
      },
      "explain": {
        "text": "If the terms settle at $L$, then $L = 0.75L + 5$. So $0.25L = 5$ and $L = 20$."
      }
    },
    {
      "id": "r-alt",
      "difficulty": 3,
      "skills": [
        "seq-geom"
      ],
      "prose": "A geometric sequence has $a = 50$ and $r = -0.8$.",
      "question": "What is $u_4$?",
      "widget": {
        "kind": "numeric",
        "answer": -25.6,
        "tol": {
          "abs": 0.001
        },
        "label": "u4",
        "accept": "−25.6, since $50 \\times (-0.8)^3 = -25.6$.",
        "placeholder": "A decimal",
        "wrong": [
          {
            "id": "sign",
            "value": 25.6,
            "tol": {
              "abs": 0.001
            }
          },
          {
            "id": "four",
            "value": 20.48,
            "tol": {
              "abs": 0.001
            }
          }
        ]
      },
      "feedback": {
        "correct": "$50 \\times (-0.8)^3 = -25.6$.",
        "generic": "Not quite right. Multiply by −0.8 three times.",
        "byKey": {
          "sign": "Three negative factors make a negative. The sign flips each step: 50, −40, 32, −25.6.",
          "four": "You multiplied by −0.8 four times: that is $u_5$."
        }
      },
      "explain": {
        "text": "The terms are 50, −40, 32, −25.6. A ratio between −1 and 0 flips the sign and shrinks the size each step."
      }
    },
    {
      "id": "r-save",
      "difficulty": 4,
      "skills": [
        "seq-arith"
      ],
      "prose": "A pot holds £350.00 after month 1. You add £125.00 at the end of each month after that.",
      "question": "At the end of which month does it first hold more than £2,000.00?",
      "widget": {
        "kind": "numeric",
        "answer": 15,
        "tol": {
          "abs": 0
        },
        "label": "First month above £2,000.00",
        "accept": "Month 15: $350 + 14 \\times 125 = 2100$.",
        "placeholder": "A month number",
        "wrong": [
          {
            "id": "m14",
            "value": 14,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "m16",
            "value": 16,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "m13",
            "value": 13,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "Month 15 holds £2,100.00; month 14 holds £1,975.00.",
        "generic": "Not quite right. Solve $350 + 125(n - 1) > 2000$ for the first whole $n$.",
        "byKey": {
          "m14": "Month 14 holds $350 + 13 \\times 125 = 1975$. That is £25.00 short.",
          "m16": "You divided £2,000.00 by £125.00. The pot already holds £350.00.",
          "m13": "You found $n - 1 = 13.2$ and rounded down. You need $n - 1 = 14$."
        }
      },
      "explain": {
        "text": "We need $350 + 125(n - 1) > 2000$, so $n - 1 > 13.2$. The first whole step count is 14, so $n = 15$. Month 15 holds £2,100.00."
      }
    },
    {
      "id": "r-dividend",
      "difficulty": 4,
      "skills": [
        "seq-geom"
      ],
      "prose": "A dividend is £0.80 in year 1 and rises by 4% a year.",
      "question": "In which year does it first exceed £1.00?",
      "widget": {
        "kind": "numeric",
        "answer": 7,
        "tol": {
          "abs": 0
        },
        "label": "First year above £1.00",
        "accept": "Year 7: $0.80 \\times 1.04^6 \\approx 1.0123$.",
        "placeholder": "A year number",
        "wrong": [
          {
            "id": "y6",
            "value": 6,
            "tol": {
              "abs": 0
            }
          },
          {
            "id": "simple",
            "value": 8,
            "tol": {
              "abs": 0
            }
          }
        ]
      },
      "feedback": {
        "correct": "Year 6 pays about £0.97; year 7 pays about £1.01.",
        "generic": "Not quite right. Compare $0.80 \\times 1.04^{n-1}$ with 1.00 year by year.",
        "byKey": {
          "y6": "Year 6 pays $0.80 \\times 1.04^5 \\approx 0.97$. Year 6 is only five rises after year 1.",
          "simple": "You added 3.2p a year, 4% of £0.80. Each rise is 4% of the latest dividend, so it gets there sooner."
        }
      },
      "explain": {
        "text": "Year $n$ pays $0.80 \\times 1.04^{n-1}$. Year 6 gives about £0.97 and year 7 about £1.01. So year 7 is the first above £1.00."
      }
    }
  ]
}
