  "summary": {
    "ideas": [
      "An arithmetic sequence adds the same common difference $d$ every step.",
      "Term $n$ is the first term plus $n - 1$ steps: $u_n = a + (n - 1)d$.",
      "A number is a term only when solving for $n$ gives a whole number."
    ],
    "formula": {
      "name": "nth term of an arithmetic sequence",
      "tex": "u_n = a + (n - 1)d",
      "note": "Test it at $n = 1$: it must give $a$."
    },
    "trap": "$a + nd$ is one step too far: it gives $u_{n+1}$, not $u_n$."
  },
