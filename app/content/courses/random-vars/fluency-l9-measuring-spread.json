{
  "id": "fluency-l9-measuring-spread",
  "lesson": "l9-measuring-spread",
  "title": "Fluency: measuring spread",
  "n": 20,
  "pass": 0.9,
  "minutes": 12,
  "families": [
    {
      "id": "two-outcome-variance",
      "weight": 1,
      "skill": "variance of a two-outcome P&L",
      "vars": {
        "p": { "pick": [0.1, 0.2, 0.25, 0.3, 0.4, 0.5, 0.6, 0.75, 0.8, 0.9] },
        "a": { "int": [1, 9] },
        "b": { "int": [1, 9] }
      },
      "let": {
        "q": "1 - p",
        "mu": "p*a - (1 - p)*b",
        "ex2": "p*a^2 + (1 - p)*b^2",
        "key": "p*a^2 + (1 - p)*b^2 - (p*a - (1 - p)*b)^2",
        "nosq": "p*a^2 + (1 - p)*b^2 - (p*a - (1 - p)*b)",
        "pa": "p*a",
        "qb": "(1 - p)*b",
        "a2": "a^2",
        "b2": "b^2"
      },
      "prompt": "A trade makes £{a} with chance {p} and loses £{b} otherwise. What is the variance of its P&L $X$, in £²?",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0 }, "placeholder": "An exact decimal", "accept": "${key}$ exactly" },
      "wrong": [
        { "id": "no-mean", "value": "{ex2}", "line": "That is $E[X^2]$. Subtract $\\mu^2 = {mu*mu}$ to get the variance.", "when": "mu != 0" },
        { "id": "mean-not-squared", "value": "{nosq}", "line": "You subtracted $\\mu = {mu}$. The formula subtracts its square, $\\mu^2 = {mu*mu}$.", "when": "mu != 0 and mu != 1" }
      ],
      "solution": [
        "$\\mu = {pa} - {qb} = {mu}$.",
        "$E[X^2] = {p} \\times {a2} + {q} \\times {b2} = {ex2}$.",
        "$\\operatorname{{Var}}(X) = E[X^2] - \\mu^2 = {ex2} - {mu*mu} = {key}$."
      ]
    },
    {
      "id": "three-value-variance",
      "weight": 2,
      "skill": "variance from a table of chances",
      "vars": {
        "pr": { "pick": [[0.2, 0.5, 0.3], [0.25, 0.5, 0.25], [0.1, 0.6, 0.3], [0.5, 0.3, 0.2], [0.4, 0.4, 0.2], [0.3, 0.3, 0.4], [0.1, 0.2, 0.7], [0.25, 0.25, 0.5], [0.2, 0.2, 0.6], [0.3, 0.6, 0.1]], "as": ["p1", "p2", "p3"] },
        "x1": { "int": [-4, -1] },
        "x2": { "int": [0, 3] },
        "x3": { "int": [4, 8] }
      },
      "let": {
        "mu": "p1*x1 + p2*x2 + p3*x3",
        "ex2": "p1*x1^2 + p2*x2^2 + p3*x3^2",
        "key": "p1*x1^2 + p2*x2^2 + p3*x3^2 - (p1*x1 + p2*x2 + p3*x3)^2",
        "nosq": "p1*x1^2 + p2*x2^2 + p3*x3^2 - (p1*x1 + p2*x2 + p3*x3)",
        "s1": "x1^2",
        "s2": "x2^2",
        "s3": "x3^2"
      },
      "prompt": "$X$ takes the values ${x1}$, ${x2}$ and ${x3}$ with chances {p1}, {p2} and {p3}. What is $\\operatorname{{Var}}(X)$?",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0 }, "placeholder": "An exact decimal", "accept": "${key}$ exactly" },
      "wrong": [
        { "id": "no-mean", "value": "{ex2}", "line": "That is $E[X^2]$. Subtract $\\mu^2 = {mu*mu}$ to get the variance.", "when": "mu != 0" },
        { "id": "mean-not-squared", "value": "{nosq}", "line": "You subtracted $\\mu = {mu}$. The formula subtracts its square, $\\mu^2 = {mu*mu}$.", "when": "mu != 0 and mu != 1" }
      ],
      "solution": [
        "$\\mu = {p1} \\times {x1:()} + {p2} \\times {x2} + {p3} \\times {x3} = {mu}$.",
        "$E[X^2] = {p1} \\times {s1} + {p2} \\times {s2} + {p3} \\times {s3} = {ex2}$.",
        "$\\operatorname{{Var}}(X) = {ex2} - {mu:()}^2 = {key}$."
      ]
    },
    {
      "id": "standard-deviation",
      "weight": 1,
      "skill": "standard deviation of a two-outcome P&L",
      "vars": {
        "pq": { "pick": [[0.5, 0.5], [0.2, 0.8], [0.8, 0.2], [0.1, 0.9], [0.9, 0.1]], "as": ["p", "q"] },
        "a": { "int": [1, 12] },
        "b": { "int": [1, 12] }
      },
      "let": {
        "mu": "p*a - q*b",
        "ex2": "p*a^2 + q*b^2",
        "var": "p*a^2 + q*b^2 - (p*a - q*b)^2",
        "key": "sqrt(p*q)*(a + b)",
        "rootex2": "sqrt(p*a^2 + q*b^2)",
        "a2": "a^2",
        "b2": "b^2"
      },
      "where": ["a + b >= 3"],
      "prompt": "A trade makes £{a} with chance {p} and loses £{b} with chance {q}. What is the standard deviation of its P&L, in £?",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0 }, "placeholder": "An exact decimal", "accept": "${key}$ exactly" },
      "wrong": [
        { "id": "gave-variance", "value": "{var}", "line": "That is the variance, in £². Take its square root to get back to £.", "when": "var != key" },
        { "id": "no-mean", "value": "{rootex2}", "tol": { "abs": 0.005 }, "line": "That is $\\sqrt{{E[X^2]}}$. Subtract $\\mu^2 = {mu*mu}$ before you take the root.", "when": "mu != 0 and abs(rootex2 - key) > 0.01" }
      ],
      "solution": [
        "$\\mu = {p} \\times {a} - {q} \\times {b} = {mu}$ and $E[X^2] = {p} \\times {a2} + {q} \\times {b2} = {ex2}$.",
        "$\\operatorname{{Var}}(X) = {ex2} - {mu:()}^2 = {var}$.",
        "The standard deviation is $\\sqrt{{{var}}} = {key}$."
      ]
    }
  ]
}
