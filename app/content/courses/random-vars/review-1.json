{
  "id": "review-1",
  "course": "random-vars",
  "level": 1,
  "items": [
    {
      "id": "r-heads-event",
      "difficulty": 2,
      "skills": [
        "rv-dist"
      ],
      "prose": "A coin is tossed three times. $N$ is the number of heads.",
      "question": "Which set is the event $\\{N = 1\\}$?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "right",
            "text": "$\\{HTT, THT, TTH\\}$",
            "correct": true
          },
          {
            "id": "first",
            "text": "$\\{HTT\\}$",
            "why": "You kept one order. The head can come on any of the three tosses."
          },
          {
            "id": "value",
            "text": "$\\{1\\}$",
            "why": "That is the value. The event is the set of outcomes that give it."
          },
          {
            "id": "le",
            "text": "$\\{TTT, HTT, THT, TTH\\}$",
            "why": "That is $\\{N \\le 1\\}$. TTT has no heads."
          }
        ]
      },
      "feedback": {
        "correct": "Three outcomes have exactly one head.",
        "generic": "List every outcome with exactly one H."
      },
      "explain": {
        "text": "$\\{N = 1\\}$ collects the outcomes where $N$ gives 1: HTT, THT and TTH. Its chance is $\\tfrac{3}{8}$."
      }
    },
    {
      "id": "r-find-c",
      "difficulty": 2,
      "skills": [
        "rv-dist"
      ],
      "prose": "$X$ takes the values 1, 2, 3 and 4, with $p(x) = cx$ for a constant $c$.",
      "question": "What is $c$?",
      "widget": {
        "kind": "numeric",
        "answer": 0.1,
        "tol": {
          "abs": 0.0005
        },
        "placeholder": "a decimal",
        "label": "The constant c",
        "accept": "0.1: $c(1 + 2 + 3 + 4) = 1$.",
        "wrong": [
          {
            "id": "equal",
            "value": 0.25,
            "tol": {
              "abs": 0.0005
            }
          },
          {
            "id": "last",
            "value": 0.4,
            "tol": {
              "abs": 0.0005
            }
          }
        ]
      },
      "feedback": {
        "correct": "$10c = 1$.",
        "generic": "A pmf adds to 1. Add $c + 2c + 3c + 4c$.",
        "byKey": {
          "equal": "You made the four values equally likely. Here $p(x)$ grows with $x$.",
          "last": "That is $p(4) = 4c$, not $c$."
        }
      },
      "explain": {
        "text": "The pmf adds to 1: $c + 2c + 3c + 4c = 10c = 1$, so $c = 0.1$. The chances are 0.1, 0.2, 0.3 and 0.4."
      }
    },
    {
      "id": "r-cdf-interval",
      "difficulty": 3,
      "skills": [
        "rv-dist"
      ],
      "prose": "$X$ takes the values 0, 1, 2 and 3, with $F(0) = 0.1$, $F(1) = 0.4$, $F(2) = 0.8$ and $F(3) = 1$.",
      "question": "What is $P(1 \\le X \\le 2)$?",
      "widget": {
        "kind": "numeric",
        "answer": 0.7,
        "tol": {
          "abs": 0.0005
        },
        "placeholder": "a decimal",
        "label": "Chance X is 1 or 2",
        "accept": "0.7: $F(2) - F(0)$.",
        "wrong": [
          {
            "id": "minus-a",
            "value": 0.4,
            "tol": {
              "abs": 0.0005
            }
          },
          {
            "id": "height",
            "value": 0.8,
            "tol": {
              "abs": 0.0005
            }
          }
        ]
      },
      "feedback": {
        "correct": "$F(2) - F(0) = 0.8 - 0.1$.",
        "generic": "Keep $X = 1$ and $X = 2$: subtract the height just below 1.",
        "byKey": {
          "minus-a": "You computed $F(2) - F(1)$, which drops $X = 1$. Subtract $F(0)$ instead.",
          "height": "That is $F(2)$. It still includes $X = 0$."
        }
      },
      "explain": {
        "text": "$P(1 \\le X \\le 2) = F(2) - F(0) = 0.7$. Check: $p(1) + p(2) = 0.3 + 0.4$."
      }
    },
    {
      "id": "r-square",
      "difficulty": 3,
      "skills": [
        "rv-dist"
      ],
      "prose": "$X$ has $p(-2) = 0.1$, $p(-1) = 0.2$, $p(0) = 0.3$, $p(1) = 0.25$ and $p(2) = 0.15$. Let $Y = X^2$.",
      "question": "What is $P(Y = 1)$?",
      "widget": {
        "kind": "numeric",
        "answer": 0.45,
        "tol": {
          "abs": 0.0005
        },
        "placeholder": "a decimal",
        "label": "Chance Y is 1",
        "accept": "0.45: $p(-1) + p(1)$.",
        "wrong": [
          {
            "id": "pos",
            "value": 0.25,
            "tol": {
              "abs": 0.0005
            }
          },
          {
            "id": "neg",
            "value": 0.2,
            "tol": {
              "abs": 0.0005
            }
          },
          {
            "id": "sq",
            "value": 0.0625,
            "tol": {
              "abs": 0.0005
            }
          }
        ]
      },
      "feedback": {
        "correct": "$-1$ and $1$ merge: $0.2 + 0.25$.",
        "generic": "Add the chances of every $x$ with $x^2 = 1$.",
        "byKey": {
          "pos": "You kept only $x = 1$. $x = -1$ squares to 1 too.",
          "neg": "You kept only $x = -1$. $x = 1$ squares to 1 too.",
          "sq": "You squared a probability. Square the values, not the chances."
        }
      },
      "explain": {
        "text": "$x = -1$ and $x = 1$ both give $Y = 1$, so $P(Y = 1) = 0.2 + 0.25 = 0.45$. Likewise $P(Y = 4) = 0.25$ and $P(Y = 0) = 0.3$."
      }
    },
    {
      "id": "r-fills",
      "difficulty": 3,
      "skills": [
        "rv-dist"
      ],
      "prose": "You send three orders. Each fills with chance 0.6, independently. $N$ is the number that fill.",
      "question": "What is $P(N = 2)$?",
      "widget": {
        "kind": "numeric",
        "answer": 0.432,
        "tol": {
          "abs": 0.0005
        },
        "placeholder": "a decimal",
        "label": "Chance exactly two fill",
        "accept": "0.432: three paths, each $0.6^2 \\times 0.4 = 0.144$.",
        "wrong": [
          {
            "id": "one-path",
            "value": 0.144,
            "tol": {
              "abs": 0.0005
            }
          },
          {
            "id": "no-miss",
            "value": 0.36,
            "tol": {
              "abs": 0.0005
            }
          },
          {
            "id": "at-least",
            "value": 0.648,
            "tol": {
              "abs": 0.0005
            }
          }
        ]
      },
      "feedback": {
        "correct": "FFM, FMF and MFF, each 0.144.",
        "generic": "Find the chance of one path with two fills, then count the paths.",
        "byKey": {
          "one-path": "That is one path, such as FFM. The miss can be any of the three orders.",
          "no-miss": "You left out the third order. It must miss, with chance 0.4.",
          "at-least": "That is $P(N \\ge 2)$: it includes FFF."
        }
      },
      "explain": {
        "text": "Each path with two fills and one miss has chance $0.6 \\times 0.6 \\times 0.4 = 0.144$. Three such paths add to $0.432$."
      }
    },
    {
      "id": "r-max-tail",
      "difficulty": 3,
      "skills": [
        "rv-dist"
      ],
      "prose": "Two fair dice are rolled. $Y$ is the larger number, with CDF $F(y) = \\tfrac{y^2}{36}$ for $y = 1, \\dots, 6$.",
      "question": "What is $P(Y \\ge 5)$?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "right",
            "text": "$\\dfrac{20}{36}$",
            "correct": true
          },
          {
            "id": "strict",
            "text": "$\\dfrac{11}{36}$",
            "why": "You used $1 - F(5)$, which is $P(Y > 5)$. $Y \\ge 5$ needs $1 - F(4)$."
          },
          {
            "id": "values",
            "text": "$\\dfrac{1}{3}$",
            "why": "You treated the six values as equally likely: 2 of 6."
          },
          {
            "id": "five",
            "text": "$\\dfrac{9}{36}$",
            "why": "That is $P(Y = 5)$ only. $Y = 6$ also counts."
          }
        ]
      },
      "feedback": {
        "correct": "$1 - F(4) = 1 - \\tfrac{16}{36}$.",
        "generic": "Take the chance of $Y \\le 4$ away from 1."
      },
      "explain": {
        "text": "$Y \\ge 5$ is the complement of $Y \\le 4$, so $P(Y \\ge 5) = 1 - \\tfrac{16}{36} = \\tfrac{20}{36}$. Check: $p(5) + p(6) = \\tfrac{9 + 11}{36}$."
      }
    },
    {
      "id": "r-dice-payout",
      "difficulty": 4,
      "skills": [
        "rv-dist"
      ],
      "prose": "Two fair dice, with $X$ the total. A bet pays $C = \\max(X - 9, 0)$ pounds.",
      "question": "What is $P(C \\ge 2)$? Give a fraction or a decimal.",
      "widget": {
        "kind": "numeric",
        "answer": 0.08333,
        "tol": {
          "abs": 0.0006
        },
        "placeholder": "fraction or decimal",
        "label": "Chance the bet pays at least £2",
        "accept": "any form equal to $\\tfrac{3}{36} = \\tfrac{1}{12}$.",
        "wrong": [
          {
            "id": "eleven",
            "value": 0.05556,
            "tol": {
              "abs": 0.0006
            }
          },
          {
            "id": "pays",
            "value": 0.16667,
            "tol": {
              "abs": 0.0006
            }
          },
          {
            "id": "twelve",
            "value": 0.02778,
            "tol": {
              "abs": 0.0006
            }
          }
        ]
      },
      "feedback": {
        "correct": "$C \\ge 2$ means a total of 11 or 12: 3 cells.",
        "generic": "Find the totals that pay at least £2, then add their chances.",
        "byKey": {
          "eleven": "That is $P(C = 2)$ only. A total of 12 pays £3, which is also at least £2.",
          "pays": "That is $P(C \\ge 1)$: a total of 10 pays only £1.",
          "twelve": "That is $P(C = 3)$ only. A total of 11 pays £2."
        }
      },
      "explain": {
        "text": "$C$ is 0 up to a total of 9, then 1, 2 and 3 for totals 10, 11 and 12. $C \\ge 2$ merges totals 11 and 12: $\\tfrac{2 + 1}{36} = \\tfrac{1}{12}$."
      }
    },
    {
      "id": "r-var",
      "difficulty": 4,
      "skills": [
        "rv-dist"
      ],
      "prose": "A desk's daily loss $L$ in £ thousands has this pmf and CDF. The 95% VaR is the smallest $x$ with $F(x) \\ge 0.95$.",
      "canvas": {
        "kind": "table",
        "params": {
          "columns": [
            "Loss $\\ell$ (£k)",
            "$p(\\ell)$",
            "$F(\\ell)$"
          ],
          "rows": [
            [
              "0",
              "0.60",
              "0.60"
            ],
            [
              "1",
              "0.20",
              "0.80"
            ],
            [
              "3",
              "0.12",
              "0.92"
            ],
            [
              "6",
              "0.05",
              "0.97"
            ],
            [
              "12",
              "0.03",
              "1.00"
            ]
          ]
        },
        "state": {}
      },
      "question": "What is the 95% VaR, in £ thousands?",
      "widget": {
        "kind": "numeric",
        "answer": 6,
        "tol": {
          "abs": 0
        },
        "unit": "£k",
        "label": "95% VaR in thousands of pounds",
        "accept": "6: $F(3) = 0.92 < 0.95 \\le F(6) = 0.97$.",
        "wrong": [
          {
            "id": "below",
            "value": 3
          },
          {
            "id": "worst",
            "value": 12
          }
        ]
      },
      "feedback": {
        "correct": "$F$ first reaches 0.95 at £6k.",
        "generic": "Go down the $F$ column to the first value of at least 0.95.",
        "byKey": {
          "below": "$F(3) = 0.92$ is short of 0.95.",
          "worst": "That is the worst loss. $F(6) = 0.97$ already reaches 0.95."
        }
      },
      "explain": {
        "text": "$F(3) = 0.92$ falls short of 0.95 and $F(6) = 0.97$ clears it, so the 95% VaR is £6k."
      }
    }
  ]
}
