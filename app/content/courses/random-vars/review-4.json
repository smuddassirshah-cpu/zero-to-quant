    {
      "id": "r-marginal",
      "difficulty": 2,
      "skills": [
        "rv-joint"
      ],
      "prose": "A signal is weak or strong each morning. The table gives the joint chances of its strength and the next day's return.",
      "canvas": {
        "kind": "grid",
        "params": {
          "rows": 3,
          "cols": 4,
          "rowLabel": "Signal X",
          "colLabel": "Next-day return Y",
          "rowHeads": [
            "Weak",
            "Strong",
            "Total"
          ],
          "colHeads": [
            "−1%",
            "0%",
            "+1%",
            "Total"
          ],
          "cells": [
            [
              "0.15",
              "0.25",
              "0.20",
              "0.60"
            ],
            [
              "0.05",
              "0.10",
              "0.25",
              "0.40"
            ],
            [
              "0.20",
              "0.35",
              "0.45",
              "1"
            ]
          ]
        },
        "state": {}
      },
      "question": "What is $P(Y = 1)$, the chance of a +1% day?",
      "widget": {
        "kind": "numeric",
        "answer": 0.45,
        "tol": {
          "abs": 0.001
        },
        "accept": "0.45: $0.20 + 0.25$",
        "placeholder": "decimal",
        "wrong": [
          {
            "id": "cell",
            "value": 0.25,
            "tol": {
              "abs": 0.001
            }
          },
          {
            "id": "row",
            "value": 0.4,
            "tol": {
              "abs": 0.001
            }
          }
        ]
      },
      "feedback": {
        "correct": "The +1% column adds to 0.45.",
        "generic": "Not quite right. Add the whole column for +1%.",
        "byKey": {
          "cell": "0.25 is only the strong-signal cell. Add the weak-signal cell too.",
          "row": "0.40 is $P(\\text{strong})$, a row total."
        }
      },
      "explain": {
        "text": "A +1% day comes with a weak or a strong signal. Those cells add: $0.20 + 0.25 = 0.45$.",
        "canvas": {
          "highlight": [
            "r3c3"
          ]
        }
      }
    },
    {
