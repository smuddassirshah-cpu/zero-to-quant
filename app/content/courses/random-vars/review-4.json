        "kind": "grid",
        "params": {
          "rows": 3,
          "cols": 4,
          "rowLabel": "Signal X",
          "colLabel": "Next-day return Y",
          "rowHeads": [
            "Weak",
            "Strong",
            "Total"
          ],
          "colHeads": [
            "−1%",
            "0%",
            "+1%",
            "Total"
          ],
          "cells": [
            [
              "0.15",
              "0.25",
              "0.20",
              "0.60"
            ],
            [
              "0.05",
              "0.10",
              "0.25",
              "0.40"
