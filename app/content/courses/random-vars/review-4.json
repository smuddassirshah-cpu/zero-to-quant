    {
      "id": "r-tail-wait",
      "difficulty": 3,
      "skills": [
        "rv-condexp"
      ],
      "prose": "A biased coin shows tails with chance 0.4 on each toss.",
      "question": "What is the expected number of tosses up to and including the first tail?",
      "widget": {
        "kind": "numeric",
        "answer": 2.5,
        "tol": {
          "abs": 0.001
        },
        "accept": "2.5: $1/0.4$",
        "placeholder": "number",
        "wrong": [
          {
            "id": "fail",
            "value": 1.5,
            "tol": {
              "abs": 0.001
            }
          },
          {
            "id": "prob",
            "value": 0.4,
            "tol": {
              "abs": 0.001
            }
          },
          {
            "id": "heads",
            "value": 1.6667,
            "tol": {
              "abs": 0.001
            }
          }
        ]
      },
      "feedback": {
        "correct": "$1/0.4 = 2.5$.",
        "generic": "Not quite right. Condition on the first toss: $E = 0.4 \\cdot 1 + 0.6(1 + E)$.",
        "byKey": {
          "fail": "1.5 counts only the heads before the tail. Count the tail too.",
          "prob": "0.4 is a chance per toss, not a number of tosses.",
          "heads": "That is the wait for the first head, $1/0.6$."
        }
      },
      "explain": {
        "text": "$E = 0.4 \\cdot 1 + 0.6(1 + E) = 1 + 0.6E$, so $0.4E = 1$ and $E = 2.5$ tosses."
      }
