    {
      "id": "r-total",
      "difficulty": 3,
      "skills": [
        "rv-condexp"
      ],
      "prose": "From the same table, $E[Y \\mid \\text{weak}] = \\tfrac{1}{12} \\approx 0.083$ and $E[Y \\mid \\text{strong}] = 0.5$. The signal is weak 60% of the time.",
