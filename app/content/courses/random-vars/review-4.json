        "state": {}
      },
      "question": "The signal is strong. What is the chance of a +1% day?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "right",
            "text": "$0.625$",
            "correct": true
          },
          {
            "id": "cell",
            "text": "$0.25$",
            "why": "You read the joint cell. Divide it by the strong row's total, 0.40."
          },
          {
            "id": "rev",
            "text": "$0.556$",
            "why": "You divided by the +1% column total. That is $P(\\text{strong} \\mid Y = 1)$."
          },
          {
            "id": "marg",
            "text": "$0.45$",
            "why": "That is $P(Y = 1)$ over all days. It ignores the signal."
          }
        ],
        "shuffle": true
      },
      "feedback": {
        "correct": "$0.25 / 0.40 = 0.625$.",
        "generic": "Not quite right. Keep the strong row and divide by its total."
      },
      "explain": {
        "text": "The strong row totals 0.40, and 0.25 of it is a +1% day. So $P(Y = 1 \\mid \\text{strong}) = 0.625$, against 0.45 overall.",
        "canvas": {
          "outline": "row2"
        }
      }
