      "feedback": {
        "correct": "$0.05 + 0.20 = 0.25$.",
        "generic": "Not quite right. Weight each conditional average by the chance of its signal.",
        "byKey": {
          "plain": "You averaged the two conditional means equally. Weak signals happen 60% of the time.",
