    {
      "id": "r-zero-cov",
      "difficulty": 3,
      "skills": [
        "rv-joint",
        "rv-variance"
      ],
      "prose": "$X$ is $-2$, $-1$, $1$ or $2$, each with chance $\\tfrac14$, and $Y = X^2$.",
      "question": "Which is true?",
      "widget": {
        "kind": "choice",
        "layout": "stack",
        "options": [
          {
            "id": "right",
            "text": "$\\operatorname{Cov}(X, Y) = 0$, and $X$ and $Y$ are dependent",
            "correct": true
          },
          {
            "id": "indep",
            "text": "$\\operatorname{Cov}(X, Y) = 0$, so $X$ and $Y$ are independent",
            "why": "Zero covariance does not give independence. $P(X = 1, Y = 4) = 0$, but $P(X = 1)P(Y = 4) = \\tfrac18$."
          },
          {
            "id": "pos",
            "text": "$\\operatorname{Cov}(X, Y) > 0$, because $Y$ grows with $X$",
            "why": "$Y$ grows with $|X|$, not with $X$. $E[XY] = E[X^3] = 0$."
          },
          {
            "id": "neg",
            "text": "$\\operatorname{Cov}(X, Y) < 0$",
            "why": "$E[XY] = E[X^3]$, and the values $-8, -1, 1, 8$ cancel, so $E[XY] = 0$."
          }
        ],
        "shuffle": true
      },
      "feedback": {
        "correct": "Covariance 0, yet $Y$ is fixed by $X$.",
        "generic": "Not quite right. Compute $E[XY] - E[X]E[Y]$, then test one cell."
      },
      "explain": {
        "text": "$E[XY] = E[X^3] = \\tfrac14(-8 - 1 + 1 + 8) = 0$ and $E[X] = 0$, so the covariance is 0. But $P(X = 1, Y = 4) = 0 \\ne \\tfrac14 \\cdot \\tfrac12$, so they are dependent."
      }
    },
