    {
      "id": "r-best-guess",
      "difficulty": 4,
      "skills": [
        "rv-condexp"
      ],
      "prose": "Given a strong signal, the next-day return is $-1\\%$, $0\\%$ or $+1\\%$ with chances 0.125, 0.25 and 0.625.",
      "question": "You forecast the return and are scored by squared error. Which forecast is best?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "right",
            "text": "$0.5\\%$",
            "correct": true
          },
          {
            "id": "mode",
            "text": "$1\\%$",
            "why": "+1% is the most likely return. Squared error is smallest at the mean, not the mode."
          },
          {
            "id": "all",
            "text": "$0.25\\%$",
            "why": "0.25% is the average over all days. You know the signal is strong."
          },
          {
            "id": "zero",
            "text": "$0\\%$",
            "why": "0% is the middle value, not the average. The chances lean to +1%."
          }
        ],
        "shuffle": true
      },
      "feedback": {
        "correct": "The conditional mean minimises squared error.",
        "generic": "Not quite right. Find $E[Y \\mid \\text{strong}]$."
      },
      "explain": {
        "text": "The best forecast under squared error is $E[Y \\mid \\text{strong}] = -0.125 + 0.625 = 0.5\\%$. The regression function gives it for each signal."
      }
    }
