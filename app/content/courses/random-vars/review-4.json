      "explain": {
        "text": "$E[Y] = 0.6 \\cdot \\tfrac{1}{12} + 0.4 \\cdot 0.5 = 0.05 + 0.20 = 0.25$. Check from the margin: $-0.20 + 0.45 = 0.25$."
      }
