  "items": [
    {
      "id": "r-primes-180",
      "difficulty": 2,
      "skills": [
        "ns-powers"
      ],
      "question": "Which is 180 written as a product of primes?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "right",
            "text": "$2^2 \\times 3^2 \\times 5$",
            "correct": true
          },
          {
            "id": "swap",
            "text": "$2^3 \\times 3 \\times 5$",
            "why": "That is $8 \\times 15 = 120$. Count the 3s in 180 again."
          },
          {
            "id": "not-prime",
            "text": "$4 \\times 9 \\times 5$",
            "why": "That equals 180, but 4 and 9 are not prime."
          },
          {
            "id": "missing",
            "text": "$2 \\times 3^2 \\times 5$",
            "why": "That is 90. 180 has two 2s."
          }
        ]
      },
      "feedback": {
        "correct": "$180 = 4 \\times 45 = 2^2 \\times 3^2 \\times 5$.",
        "generic": "Not quite right. Split 180 until every end is prime."
      },
      "explain": {
        "text": "$180 = 4 \\times 45$, $4 = 2 \\times 2$ and $45 = 3 \\times 3 \\times 5$. So $180 = 2^2 \\times 3^2 \\times 5$."
      }
    },
    {
      "id": "r-count-180",
      "difficulty": 3,
      "skills": [
        "ns-powers"
      ],
      "prose": "$180 = 2^2 \\times 3^2 \\times 5$.",
      "question": "How many factors does 180 have?",
      "widget": {
        "kind": "numeric",
        "answer": 18,
        "tol": {
          "abs": 0
        },
        "label": "Number of factors",
        "accept": "18: $(2 + 1)(2 + 1)(1 + 1)$.",
        "wrong": [
          {
            "id": "no-plus-one",
            "value": 4
          },
          {
            "id": "added",
            "value": 8
          }
        ]
      },
      "feedback": {
        "correct": "$(2 + 1)(2 + 1)(1 + 1) = 18$.",
        "generic": "Not quite right. Add 1 to each index, then multiply.",
        "byKey": {
          "no-plus-one": "You multiplied the indices, $2 \\times 2 \\times 1$. Add 1 to each first.",
          "added": "You added the choices. Multiply them."
        }
      },
      "explain": {
        "text": "The power of 2 has 3 choices: 1, 2, 4. The power of 3 has 3 and the 5 has 2. So 180 has $3 \\times 3 \\times 2 = 18$ factors."
      }
    },
    {
      "id": "r-lcm-36-60",
      "difficulty": 3,
      "skills": [
        "ns-powers",
        "ns-fractions"
      ],
      "prose": "$36 = 2^2 \\times 3^2$ and $60 = 2^2 \\times 3 \\times 5$.",
      "canvas": {
        "kind": "venn",
        "params": {
          "sets": [
            "A",
            "B"
          ],
          "labels": {
            "A": "36",
            "B": "60"
          },
          "values": {
            "A": "3",
            "AB": "2, 2, 3",
            "B": "5"
          }
        },
        "state": {}
      },
      "question": "What is the LCM of 36 and 60?",
      "widget": {
        "kind": "numeric",
        "answer": 180,
        "tol": {
          "abs": 0
        },
        "label": "LCM",
        "accept": "180: $2^2 \\times 3^2 \\times 5$.",
        "wrong": [
          {
            "id": "product",
            "value": 2160
          },
          {
            "id": "hcf",
            "value": 12
          },
          {
            "id": "big-only",
            "value": 360
          }
        ]
      },
      "feedback": {
        "correct": "$2^2 \\times 3^2 \\times 5 = 180$.",
        "generic": "Not quite right. Take each prime as often as either number needs it.",
        "byKey": {
          "product": "$36 \\times 60$ counts the shared $2^2 \\times 3$ twice.",
          "hcf": "12 is the HCF, the shared part only.",
          "big-only": "You took three 2s. Neither number has more than two."
        }
      },
      "explain": {
        "text": "The HCF is the shared part, $2^2 \\times 3 = 12$. The LCM takes every prime as often as needed: $2^2 \\times 3^2 \\times 5 = 180$. Check: $12 \\times 180 = 2{,}160 = 36 \\times 60$."
      }
    },
    {
      "id": "r-cancel",
      "difficulty": 2,
      "skills": [
        "ns-fractions"
      ],
      "question": "What is $\\dfrac{30}{42}$ in lowest terms?",
      "widget": {
        "kind": "choice",
        "layout": "grid",
        "options": [
          {
            "id": "right",
            "text": "$\\dfrac{5}{7}$",
            "correct": true
          },
          {
            "id": "half",
            "text": "$\\dfrac{15}{21}$",
            "why": "You divided by 2. Both still divide by 3."
          },
          {
            "id": "third",
            "text": "$\\dfrac{10}{14}$",
            "why": "You divided by 3. Both still divide by 2."
          },
          {
            "id": "sub",
            "text": "$\\dfrac{1}{7}$",
            "why": "You divided the bottom by 6 but the top by 30. Divide both by 6."
          }
        ]
      },
      "feedback": {
        "correct": "The HCF is 6: $\\dfrac{30 \\div 6}{42 \\div 6} = \\dfrac{5}{7}$.",
        "generic": "Not quite right. Divide top and bottom by their HCF."
      },
      "explain": {
        "text": "$30 = 2 \\times 3 \\times 5$ and $42 = 2 \\times 3 \\times 7$ share $2 \\times 3 = 6$. Dividing both by 6 gives $\\dfrac{5}{7}$."
      }
    },
