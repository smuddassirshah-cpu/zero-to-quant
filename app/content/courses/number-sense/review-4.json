      ],
      "prose": "A round table top is 14 cm across.",
      "question": "What is the area of the table top, to 2 decimal places?",
      "widget": {
        "kind": "numeric",
        "answer": 153.94,
        "tol": {
          "abs": 0.1
        },
        "unit": "cm²",
        "label": "Area",
        "accept": "153.94 cm²: $49\\pi$. 153.86 from $\\pi \\approx 3.14$ and 154 from $\\tfrac{22}{7}$ are accepted.",
        "wrong": [
          {
            "id": "diameter",
            "value": 615.75,
            "tol": {
              "abs": 0.35
            }
          },
          {
            "id": "circ",
            "value": 43.98,
            "tol": {
              "abs": 0.05
            }
          }
        ]
      },
      "feedback": {
        "correct": "$\\pi \\times 7^2 = 49\\pi \\approx 153.94$ cm².",
        "generic": "Not quite right. Halve the diameter, square it, multiply by $\\pi$.",
        "byKey": {
          "diameter": "You squared the diameter. The radius is 7.",
          "circ": "That is the circumference, $14\\pi$. An area squares a length."
        }
      },
      "explain": {
        "text": "The radius is 7 cm, so the area is $49\\pi \\approx 153.94$ cm². Estimate: $3 \\times 49 = 147$."
      }
    },
