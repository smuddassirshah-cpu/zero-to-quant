{
  "id": "fluency-l9-negative-times-negative",
  "course": "number-sense",
  "lesson": "l9-negative-times-negative",
  "title": "Fluency: multiplying and dividing negatives",
  "n": 20,
  "pass": 0.9,
  "minutes": 8,
  "families": [
    {
      "id": "multiply-two",
      "weight": 2,
      "skill": "multiply two signed numbers",
      "vars": {
        "a": { "int": [-12, 12], "not": [-1, 0, 1] },
        "b": { "int": [-9, 9], "not": [-1, 0, 1] }
      },
      "where": ["a < 0 or b < 0"],
      "let": { "key": "a*b", "size": "abs(a*b)", "neg": "-(a*b)", "sum": "a + b" },
      "prompt": "Work out ${a:()} \\times {b:()}$.",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0 }, "placeholder": "use − for below zero" },
      "wrong": [
        { "id": "sign-flipped", "value": "{neg}", "line": "The size is right but the sign is not: two negatives give a positive, one negative gives a negative." },
        { "id": "added", "value": "{sum}", "line": "You added the two numbers. The question multiplies them.", "when": "a < 0 and b < 0 and a + b != -(a*b)" }
      ],
      "solution": [
        "Size first: ${abs(a)} \\times {abs(b)} = {size}$.",
        "Then the sign: ${a:()} \\times {b:()} = {key}$."
      ]
    },
    {
      "id": "divide-two",
      "weight": 1,
      "skill": "divide signed numbers",
      "vars": {
        "q": { "int": [-12, 12], "not": [-1, 0, 1] },
        "b": { "int": [-9, 9], "not": [-1, 0, 1] }
      },
      "where": ["q*b < 0 or b < 0"],
      "let": { "a": "q*b", "neg": "-q", "inv": "1/q" },
      "prompt": "Work out ${a:()} \\div {b:()}$.",
      "widget": { "kind": "numeric", "answer": "{q}", "tol": { "abs": 0 }, "placeholder": "use − for below zero" },
      "wrong": [
        { "id": "sign-flipped", "value": "{neg}", "line": "The size is right but the sign is not: division follows the same sign rules as multiplication." },
        { "id": "upside-down", "value": "{inv}", "tol": { "abs": 0.005 }, "line": "You divided ${b}$ by ${a}$. Divide the first number by the second." }
      ],
      "solution": [
        "Size first: ${abs(q*b)} \\div {abs(b)} = {abs(q)}$.",
        "Then the sign: ${a:()} \\div {b:()} = {q}$, and ${q:()} \\times {b:()} = {a}$ checks it."
      ]
    },
    {
      "id": "multiply-three",
      "weight": 1,
      "skill": "multiply three signed numbers",
      "vars": {
        "a": { "int": [-6, 6], "not": [-1, 0, 1] },
        "b": { "int": [-5, 5], "not": [-1, 0, 1] },
        "c": { "int": [-5, 5], "not": [-1, 0, 1] }
      },
      "where": ["a < 0 or b < 0 or c < 0"],
      "let": { "ab": "a*b", "key": "a*b*c", "neg": "-(a*b*c)", "size": "abs(a*b*c)" },
      "prompt": "Work out ${a:()} \\times {b:()} \\times {c:()}$.",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0 }, "placeholder": "use − for below zero" },
      "wrong": [
        { "id": "sign-flipped", "value": "{neg}", "line": "The size is right but the sign is not. Multiply two at a time and track the sign." },
        { "id": "first-pair-only", "value": "{ab}", "line": "You stopped after the first pair. Multiply ${ab}$ by ${c:()}$ as well." }
      ],
      "solution": [
        "Two at a time: ${a:()} \\times {b:()} = {ab}$.",
        "Then ${ab:()} \\times {c:()} = {key}$."
      ]
    }
  ]
}
