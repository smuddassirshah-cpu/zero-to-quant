{
  "id": "fluency-l8-below-zero",
  "course": "number-sense",
  "lesson": "l8-below-zero",
  "title": "Fluency: going below zero",
  "n": 20,
  "pass": 0.9,
  "minutes": 8,
  "families": [
    {
      "id": "add-signed",
      "weight": 1,
      "skill": "add a signed number",
      "vars": {
        "a": { "int": [-15, 15], "not": [0] },
        "m": { "int": [1, 15] },
        "sg": { "pick": [["left", "right", -1], ["right", "left", 1]], "as": ["dir", "opp", "s"] }
      },
      "let": { "b": "s*m", "key": "a + s*m", "back": "a - s*m", "sizes": "abs(a) + m" },
      "where": ["a < 0 or s < 0"],
      "prompt": "Work out ${a} + {b:()}$.",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0 }, "placeholder": "use − for below zero" },
      "wrong": [
        { "id": "wrong-way", "value": "{back}", "line": "You moved the wrong way: adding ${b}$ moves {dir} along the line." },
        { "id": "dropped-signs", "value": "{sizes}", "line": "You added the sizes and dropped the signs. Start at ${a}$ and move ${m}$ to the {dir}.", "when": "abs(a) + m != a - s*m and abs(a) + m != a + s*m" }
      ],
      "solution": [
        "Start at ${a}$. Adding ${b}$ moves ${m}$ to the {dir}.",
        "So ${a} + {b:()} = {key}$."
      ]
    },
    {
      "id": "subtract-signed",
      "weight": 1,
      "skill": "subtract a signed number",
      "vars": {
        "a": { "int": [-15, 15], "not": [0] },
        "m": { "int": [1, 15] },
        "sg": { "pick": [["right", "left", -1], ["left", "right", 1]], "as": ["dir", "opp", "s"] }
      },
      "let": { "b": "s*m", "key": "a - s*m", "added": "a + s*m", "flip": "s*m - a" },
      "where": ["a < 0 or s < 0 or a < m", "a != s*m"],
      "prompt": "Work out ${a} - {b:()}$.",
      "widget": { "kind": "numeric", "answer": "{key}", "tol": { "abs": 0 }, "placeholder": "use − for below zero" },
      "wrong": [
        { "id": "added", "value": "{added}", "line": "You added ${b}$. Subtracting undoes adding, so it moves the other way, to the {dir}." },
        { "id": "reversed", "value": "{flip}", "line": "You took ${a}$ from ${b}$. The first number is where you start." }
      ],
      "solution": [
        "Start at ${a}$. Subtracting ${b:()}$ undoes adding it, so it moves ${m}$ to the {dir}.",
        "So ${a} - {b:()} = {key}$."
      ]
    }
  ]
}
