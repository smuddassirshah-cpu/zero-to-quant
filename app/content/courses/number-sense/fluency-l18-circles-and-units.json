{
  "id": "fluency-l18-circles-and-units",
  "course": "number-sense",
  "lesson": "l18-circles-and-units",
  "title": "Fluency: circles and changing units",
  "n": 20,
  "pass": 0.9,
  "minutes": 12,
  "families": [
    {
      "id": "circumference",
      "weight": 1,
      "skill": "circumference of a circle",
      "vars": {
        "ob": {
          "pick": [
            [
              "plate",
              "cm"
            ],
            [
              "pond",
              "m"
            ],
            [
              "wheel",
              "cm"
            ],
            [
              "rug",
              "m"
            ],
            [
              "clock face",
              "cm"
            ],
            [
              "flower bed",
              "m"
            ]
          ],
          "as": [
            "obj",
            "u"
          ]
        },
        "kk": {
          "pick": [
            [
              "radius",
              1
            ],
            [
              "diameter",
              2
            ]
          ],
          "as": [
            "word",
            "k"
          ]
        },
        "m": {
          "int": [
            3,
            15
          ]
        }
      },
      "let": {
        "d": "if(k == 1, 2*m, m)",
        "r": "if(k == 1, m, m/2)",
        "circ": "pi*if(k == 1, 2*m, m)",
        "area": "pi*if(k == 1, m, m/2)^2",
        "swap": "pi*if(k == 1, m, 2*m)"
      },
      "prompt": "A round {obj} has {word} ${m}$ {u}. Work out its circumference in {u}, to 1 decimal place.",
      "widget": {
        "kind": "numeric",
        "answer": "{circ}",
        "tol": {
          "abs": 0.15
        },
        "unit": "{u}",
        "accept": "{circ:dp1}"
      },
      "wrong": [
        {
          "id": "area-rule",
          "value": "{area}",
          "tol": {
            "abs": 0.15
          },
          "line": "You used $\\pi r^2$, the area. The distance round is $\\pi$ times the diameter.",
          "when": "abs(area - circ) > 1 and abs(area - swap) > 1"
        },
        {
          "id": "radius-diameter",
          "value": "{swap}",
          "tol": {
            "abs": 0.15
          },
          "line": "You mixed up the radius and the diameter. The diameter is twice the radius: ${d}$ {u} here."
        }
      ],
      "solution": [
        "The diameter is ${d}$ {u}.",
        "Circumference $= \\pi \\times {d} \\approx {circ:dp1}$ {u}."
      ]
    },
    {
      "id": "circle-area",
      "weight": 1,
      "skill": "area of a circle",
      "vars": {
        "ob": {
          "pick": [
            [
              "plate",
              "cm"
            ],
            [
              "pond",
              "m"
            ],
            [
              "wheel",
              "cm"
            ],
            [
              "rug",
              "m"
            ],
            [
              "clock face",
              "cm"
            ],
            [
              "flower bed",
              "m"
            ]
          ],
          "as": [
            "obj",
            "u"
          ]
        },
        "kk": {
          "pick": [
            [
              "radius",
              1
            ],
            [
              "diameter",
              2
            ]
          ],
          "as": [
            "word",
            "k"
          ]
        },
        "m": {
          "int": [
            3,
            16
          ]
        }
      },
      "let": {
        "r": "if(k == 1, m, m/2)",
        "rr": "if(k == 1, m, m/2)^2",
        "area": "pi*if(k == 1, m, m/2)^2",
        "circ": "pi*2*if(k == 1, m, m/2)",
        "dsq": "pi*m^2"
      },
      "where": [
        "k == 2 or m <= 8"
      ],
      "prompt": "A round {obj} has {word} ${m}$ {u}. Work out its area in {u}², to 1 decimal place.",
      "widget": {
        "kind": "numeric",
        "answer": "{area}",
        "tol": {
          "abs": 0.2
        },
        "unit": "{u}²",
        "accept": "{area:dp1}"
      },
      "wrong": [
        {
          "id": "diameter-squared",
          "value": "{dsq}",
          "tol": {
            "abs": 0.8
          },
          "line": "You squared the diameter. $\\pi r^2$ takes the radius: halve ${m}$ first.",
          "when": "k == 2"
        },
        {
          "id": "circumference",
          "value": "{circ}",
          "tol": {
            "abs": 0.2
          },
          "line": "That is the distance round, $2\\pi r$. The area is $\\pi r^2$.",
          "when": "abs(area - circ) > 1"
        }
      ],
      "solution": [
        "The radius is ${r}$ {u}, and ${r}^2 = {rr}$.",
        "Area $= \\pi \\times {rr} \\approx {area:dp1}$ {u}²."
      ]
    },
    {
      "id": "speed-units",
      "weight": 1,
      "skill": "change units of speed",
      "vars": {
        "dd": {
          "pick": [
            [
              "km an hour",
              "metres a second",
              1,
              "\\times 1{,}000 \\div 3{,}600"
            ],
            [
              "metres a second",
              "km an hour",
              2,
              "\\times 3{,}600 \\div 1{,}000"
            ]
          ],
          "as": [
            "from",
            "to",
            "dir",
            "op"
          ]
        },
        "x": {
          "int": [
            5,
            150
          ]
        }
      },
      "let": {
        "key": "if(dir == 1, x*1000/3600, x*3600/1000)",
        "back": "if(dir == 1, x*3600/1000, x*1000/3600)",
        "mins": "if(dir == 1, x*1000/60, x*60/1000)"
      },
      "where": [
        "dir == 1 or x <= 50",
        "dir == 2 or x >= 10"
      ],
      "prompt": "Change ${x}$ {from} into {to}, to 1 decimal place.",
      "widget": {
        "kind": "numeric",
        "answer": "{key}",
        "tol": {
          "abs": 0.05
        },
        "accept": "{key:dp1}"
      },
      "wrong": [
        {
          "id": "wrong-way",
          "value": "{back}",
          "tol": {
            "abs": 0.05
          },
          "line": "You turned the fractions the wrong way round. Pick the ones that cancel the units you have."
        },
        {
          "id": "minutes",
          "value": "{mins}",
          "tol": {
            "abs": 0.05
          },
          "line": "An hour is 3,600 seconds, not 60. You changed hours into minutes only."
        }
      ],
      "solution": [
        "An hour is 3,600 seconds and a km is 1,000 m.",
        "${x} {op} \\approx {key:dp1}$, so ${x}$ {from} is about ${key:dp1}$ {to}."
      ]
    },
    {
      "id": "area-units",
      "weight": 1,
      "skill": "change square metres into square centimetres",
      "vars": {
        "n": {
          "int": [
            2,
            99
          ]
        },
        "ob": {
          "pick": [
            "table top",
            "window",
            "rug",
            "wall panel",
            "notice board"
          ]
        }
      },
      "let": {
        "a": "n/10",
        "key": "n*1000",
        "once": "n*10",
        "down": "n/100000"
      },
      "where": [
        "n % 10 != 0 or n <= 30"
      ],
      "prompt": "A {ob} has an area of ${a}$ m². What is its area in cm²?",
      "widget": {
        "kind": "numeric",
        "answer": "{key}",
        "tol": {
          "abs": 0
        },
        "unit": "cm²"
      },
      "wrong": [
        {
          "id": "length-only",
          "value": "{once}",
          "line": "You multiplied by 100, as for a length. A square metre is 100 cm by 100 cm, so multiply by 10,000."
        },
        {
          "id": "divided",
          "value": "{down}",
          "line": "You divided. A square centimetre is far smaller than a square metre, so there are more of them: multiply by 10,000."
        }
      ],
      "solution": [
        "1 m² is $100 \\times 100 = 10{{,}}000$ cm².",
        "So ${a}$ m² is ${n}{{,}}000$ cm²."
      ]
    }
  ]
}
