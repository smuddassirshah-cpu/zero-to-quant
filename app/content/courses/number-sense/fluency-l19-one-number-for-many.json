        },
        {
          "id": "sign-lost",
          "value": "{lost}",
          "line": "Taking away ${s1}$ adds ${-s1}$: ${s5} - {s1:()} = {key}$.",
          "when": "s5 + s1 != g1 + g2 + g3 + g4"
        }
      ],
      "solution": [
        "The largest is ${s5}$ and the smallest is ${s1}$.",
        "Range $= {s5} - {s1:()} = {key}$."
      ]
