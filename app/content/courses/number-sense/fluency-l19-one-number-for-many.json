    {
      "id": "table-mean",
      "weight": 1,
      "skill": "find the mean from a frequency table",
      "vars": {
        "f0": {
          "int": [
            2,
            6
          ]
        },
        "f1": {
          "int": [
            1,
            9
          ]
        },
        "f2": {
          "int": [
            1,
            9
          ]
        },
        "f3": {
          "int": [
            1,
            8
          ]
        },
        "f4": {
          "int": [
            1,
            5
          ]
        },
        "ww": {
          "pick": [
            [
              "Goals",
              "goals",
              "matches",
              "a match"
            ],
            [
              "Calls",
              "calls",
              "hours",
              "an hour"
            ],
            [
              "Parcels",
              "parcels",
              "days",
              "a day"
            ],
            [
              "Buses",
              "buses",
              "hours",
              "an hour"
            ]
          ],
          "as": [
            "tcap",
            "thing",
            "unit",
            "one"
          ]
        }
      },
      "let": {
        "n": "f0 + f1 + f2 + f3 + f4",
        "tot": "f1 + 2*f2 + 3*f3 + 4*f4",
        "key": "(f1 + 2*f2 + 3*f3 + 4*f4)/(f0 + f1 + f2 + f3 + f4)",
        "rows": "(f1 + 2*f2 + 3*f3 + 4*f4)/5",
        "plain": "2"
      },
      "where": [
        "abs((f1 + 2*f2 + 3*f3 + 4*f4)/(f0 + f1 + f2 + f3 + f4) - 2) > 0.03",
        "abs((f1 + 2*f2 + 3*f3 + 4*f4)/(f0 + f1 + f2 + f3 + f4) - (f1 + 2*f2 + 3*f3 + 4*f4)/5) > 0.03"
      ],
      "prompt": "{tcap} {one}, counted over ${n}$ {unit}: ${f0}$ {unit} had 0, ${f1}$ had 1, ${f2}$ had 2, ${f3}$ had 3 and ${f4}$ had 4. Find the mean number of {thing} {one}, to 2 decimal places.",
      "widget": {
        "kind": "numeric",
        "answer": "{key}",
        "tol": {
          "abs": 0.01
        },
        "accept": "{key:dp2}"
      },
      "wrong": [
        {
          "id": "values-only",
          "value": "{plain}",
          "tol": {
            "abs": 0.01
          },
          "line": "You took the mean of 0, 1, 2, 3 and 4 without their counts. Weight each value by how often it came."
        },
        {
          "id": "rows",
          "value": "{rows}",
          "tol": {
            "abs": 0.01
          },
          "line": "You divided the total by the 5 rows. Divide by the {n} {unit}."
        }
      ],
      "solution": [
        "The total is $1 \\times {f1} + 2 \\times {f2} + 3 \\times {f3} + 4 \\times {f4} = {tot}$ over ${n}$ {unit}.",
        "The mean is ${tot} \\div {n} \\approx {key:dp2}$."
      ]
    }
