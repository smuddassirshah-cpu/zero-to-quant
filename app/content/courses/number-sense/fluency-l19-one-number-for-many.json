      "let": {
        "s2": "s1 + g1",
        "s3": "s1 + g1 + g2",
        "s4": "s1 + g1 + g2 + g3",
        "s5": "s1 + g1 + g2 + g3 + g4",
        "d1": "if(o1 == 1, s1, if(o1 == 2, s2, if(o1 == 3, s3, if(o1 == 4, s4, s5))))",
        "d2": "if(o2 == 1, s1, if(o2 == 2, s2, if(o2 == 3, s3, if(o2 == 4, s4, s5))))",
        "d3": "if(o3 == 1, s1, if(o3 == 2, s2, if(o3 == 3, s3, if(o3 == 4, s4, s5))))",
        "d4": "if(o4 == 1, s1, if(o4 == 2, s2, if(o4 == 3, s3, if(o4 == 4, s4, s5))))",
        "d5": "if(o5 == 1, s1, if(o5 == 2, s2, if(o5 == 3, s3, if(o5 == 4, s4, s5))))",
        "mean": "(5*s1 + 4*g1 + 3*g2 + 2*g3 + g4)/5"
      },
      "prompt": "Five readings, in the order they came, are ${d1}$, ${d2}$, ${d3}$, ${d4}$ and ${d5}$. What is the median?",
      "widget": {
        "kind": "numeric",
        "answer": "{s3}",
        "tol": {
          "abs": 0
        },
        "placeholder": "use − for below zero"
      },
      "wrong": [
        {
          "id": "unsorted",
          "value": "{d3}",
          "line": "${d3}$ is the middle of the list as written. Sort the values first.",
          "when": "o3 != 3"
        },
        {
          "id": "mean",
          "value": "{mean}",
          "line": "That is the mean. The median is the middle value once the list is sorted.",
          "when": "mean != s3 and mean != d3"
        }
      ],
      "solution": [
        "Sorted: ${s1}$, ${s2}$, ${s3}$, ${s4}$, ${s5}$.",
        "The middle one is ${s3}$."
      ]
    },
