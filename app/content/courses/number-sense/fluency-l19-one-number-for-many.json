{
  "id": "fluency-l19-one-number-for-many",
  "course": "number-sense",
  "lesson": "l19-one-number-for-many",
  "title": "Fluency: mean, median, mode and range",
  "n": 20,
  "pass": 0.9,
  "minutes": 12,
  "families": [
    {
      "id": "mean",
      "weight": 1,
      "skill": "find the mean",
      "vars": {
        "a": {
          "int": [
            -30,
            -2
          ]
        },
        "b": {
          "int": [
            0,
            90
          ]
        },
        "c": {
          "int": [
            0,
            90
          ]
        },
        "d": {
          "int": [
            5,
            90
          ]
        },
        "m": {
          "int": [
            8,
            40
          ]
        }
      },
      "let": {
        "e": "5*m - a - b - c - d",
        "tot": "5*m",
        "four": "5*m/4",
        "pos": "(5*m - 2*a)/5"
      },
      "where": [
        "5*m - a - b - c - d >= -30",
        "5*m - a - b - c - d <= 120"
      ],
      "prompt": "Five daily profits, in pounds, are ${b}$, ${a}$, ${c}$, ${e}$ and ${d}$. What is the mean daily profit?",
      "widget": {
        "kind": "numeric",
        "answer": "{m}",
        "tol": {
          "abs": 0
        },
        "unit": "£",
        "placeholder": "use − for a loss"
      },
      "wrong": [
        {
          "id": "divided-by-four",
          "value": "{four}",
          "line": "You divided by 4. There are five days, so share the total of ${tot}$ by 5."
        },
        {
          "id": "loss-added",
          "value": "{pos}",
          "line": "You added the loss of ${a}$ as a profit. A loss takes away from the total.",
          "when": "5*m/4 != (5*m - 2*a)/5"
        }
      ],
      "solution": [
        "The total is ${b} + {a:()} + {c} + {e:()} + {d:()} = {tot}$.",
        "The mean is ${tot} \\div 5 = {m}$ pounds."
      ]
    },
