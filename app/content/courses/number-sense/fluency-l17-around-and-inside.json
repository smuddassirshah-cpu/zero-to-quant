{
  "id": "fluency-l17-around-and-inside",
  "course": "number-sense",
  "lesson": "l17-around-and-inside",
  "title": "Fluency: perimeter and area",
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "triangle-area",
      "weight": 1,
      "skill": "area of a triangle",
      "vars": {
        "b": {
          "int": [
            4,
            20
          ]
        },
        "h": {
          "int": [
            3,
            14
          ]
        },
        "k": {
          "int": [
            1,
            6
          ]
        }
      },
      "let": {
        "s": "h + k",
        "key": "b*h/2",
        "bh": "b*h",
        "bs": "b*(h + k)/2"
      },
      "where": [
        "b*h % 2 == 0",
        "b != h"
      ],
      "prompt": "A triangle has base ${b}$ cm, a sloping side of ${s}$ cm and height ${h}$ cm. Work out its area in cm².",
      "widget": {
        "kind": "numeric",
        "answer": "{key}",
        "tol": {
          "abs": 0
        },
        "unit": "cm²"
      },
      "wrong": [
        {
          "id": "no-half",
          "value": "{bh}",
          "line": "${b} \\times {h} = {bh}$ is the rectangle round the triangle. The triangle is half of it."
        },
        {
          "id": "sloping-side",
          "value": "{bs}",
          "line": "You used the sloping side. The height is the one that meets the base at a right angle: ${h}$ cm.",
          "when": "s != 2*h"
        }
      ],
      "solution": [
        "Area $= \\tfrac{{1}}{{2}} \\times$ base $\\times$ height, with the height at right angles to the base.",
        "$\\tfrac{{1}}{{2}} \\times {b} \\times {h} = {key}$ cm²."
      ]
    },
    {
      "id": "parallelogram-area",
      "weight": 1,
      "skill": "area of a parallelogram",
      "vars": {
        "b": {
          "int": [
            4,
            16
          ]
        },
        "h": {
          "int": [
            3,
            12
          ]
        },
        "k": {
          "int": [
            1,
            5
          ]
        }
      },
      "let": {
        "s": "h + k",
        "key": "b*h",
        "bs": "b*(h + k)",
        "half": "b*h/2"
      },
      "where": [
        "b != h",
        "b != h + k"
      ],
      "prompt": "A parallelogram has base ${b}$ cm, slant side ${s}$ cm and height ${h}$ cm. Work out its area in cm².",
      "widget": {
        "kind": "numeric",
        "answer": "{key}",
        "tol": {
          "abs": 0
        },
        "unit": "cm²"
      },
      "wrong": [
        {
          "id": "slant-side",
          "value": "{bs}",
          "line": "You multiplied by the slant side. Sliding the end triangle across makes a rectangle as tall as the height, ${h}$ cm."
        },
        {
          "id": "halved",
          "value": "{half}",
          "line": "You halved, as for a triangle. A parallelogram slides into a whole rectangle, base times height."
        }
      ],
      "solution": [
        "Slide the triangle off one end to the other: a rectangle ${b}$ cm by ${h}$ cm.",
        "Area $= {b} \\times {h} = {key}$ cm²."
      ]
    },
    {
      "id": "trapezium-area",
      "weight": 1,
      "skill": "area of a trapezium",
      "vars": {
        "a": {
          "int": [
            2,
            12
          ]
        },
        "d": {
          "int": [
            1,
            9
          ]
        },
        "h": {
          "int": [
            2,
            10
          ]
        }
      },
      "let": {
        "c": "a + d",
        "sum": "2*a + d",
        "key": "(2*a + d)*h/2",
        "full": "(2*a + d)*h",
        "long": "(a + d)*h"
      },
      "where": [
        "(2*a + d)*h % 2 == 0"
      ],
      "prompt": "A trapezium has parallel sides of ${a}$ m and ${c}$ m, and height ${h}$ m. Work out its area in m².",
      "widget": {
        "kind": "numeric",
        "answer": "{key}",
        "tol": {
          "abs": 0
        },
        "unit": "m²"
      },
      "wrong": [
        {
          "id": "no-half",
          "value": "{full}",
          "line": "${full}$ is two copies of the trapezium, which make a parallelogram. Halve it."
        },
        {
          "id": "longer-side",
          "value": "{long}",
          "line": "You used only the longer parallel side. Use the average of the two: $\\tfrac{{{a} + {c}}}{{2}}$.",
          "when": "(a + d)*h != (2*a + d)*h/2"
        }
      ],
      "solution": [
        "The average of the parallel sides is $\\tfrac{{{a} + {c}}}{{2}} = {sum/2}$ m.",
        "Area $= {sum/2} \\times {h} = {key}$ m²."
      ]
    },
    {
      "id": "l-shape-area",
      "weight": 1,
      "skill": "area of a shape built from rectangles",
      "vars": {
        "w": {
          "int": [
            6,
            15
          ]
        },
        "t": {
          "int": [
            5,
            12
          ]
        },
        "p": {
          "int": [
            2,
            6
          ]
        },
        "q": {
          "int": [
            2,
            6
          ]
        }
      },
      "let": {
        "whole": "w*t",
        "cut": "p*q",
        "key": "w*t - p*q",
        "added": "w*t + p*q"
      },
      "where": [
        "p < w - 1",
        "q < t - 1",
        "w != t"
      ],
      "prompt": "An L-shaped floor is a ${w}$ m by ${t}$ m rectangle with a ${p}$ m by ${q}$ m corner cut away. Work out its area in m².",
      "widget": {
        "kind": "numeric",
        "answer": "{key}",
        "tol": {
          "abs": 0
        },
        "unit": "m²"
      },
      "wrong": [
        {
          "id": "corner-kept",
          "value": "{whole}",
          "line": "${whole}$ m² is the full rectangle. Take away the corner that was cut out."
        },
        {
          "id": "corner-added",
          "value": "{added}",
          "line": "You added the corner. It was cut away, so take ${cut}$ off."
        }
      ],
      "solution": [
        "The full rectangle is ${w} \\times {t} = {whole}$ m², and the corner is ${p} \\times {q} = {cut}$ m².",
        "So the L-shape is ${whole} - {cut} = {key}$ m²."
      ]
    }
  ]
}
