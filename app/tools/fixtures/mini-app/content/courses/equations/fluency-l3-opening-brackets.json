{
  "id": "fluency-l3-opening-brackets",
  "course": "equations",
  "lesson": "l3-opening-brackets",
  "title": "Fluency: opening up brackets",
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "expand-one-bracket",
      "weight": 2,
      "skill": "expand a single bracket",
      "vars": {
        "a": { "int": [-9, 9], "not": [-1, 0, 1] },
        "p": { "int": [1, 5] },
        "b": { "int": [-9, 9], "not": [0] },
        "v": { "pick": ["x", "n", "y", "t", "m"] }
      },
      "let": { "ap": "a*p", "ab": "a*b" },
      "prompt": "Expand ${a}({p:c}{v}{b:+})$.",
      "widget": { "kind": "expression", "answer": "{poly(v; ap, ab)}", "form": "expanded", "keyboard": "algebra" },
      "wrong": [
        { "id": "first-term-only", "tex": "{poly(v; ap, b)}", "line": "You multiplied only the first term by ${a}$; it multiplies ${b}$ too." },
        { "id": "sign-slip", "tex": "{poly(v; ap, -ab)}", "line": "Check the sign: ${a} \\times {b:()} = {ab}$." }
      ],
      "solution": [
        "${a} \\times {p:c}{v} = {poly(v; ap, 0)}$ and ${a} \\times {b:()} = {ab}$.",
        "So ${a}({p:c}{v}{b:+}) = {poly(v; ap, ab)}$."
      ]
    },
    {
      "id": "expand-two-and-collect",
      "weight": 1,
      "skill": "expand two brackets and collect",
      "vars": {
        "a": { "int": [2, 6] },
        "b": { "int": [-6, 6], "not": [0] },
        "c": { "int": [-6, 6], "not": [-1, 0, 1] },
        "d": { "int": [-6, 6], "not": [0] },
        "v": { "pick": ["x", "n", "y", "t"] }
      },
      "let": { "k": "a + c", "ab": "a*b", "cd": "c*d", "r": "a*b + c*d" },
      "where": ["k != 0", "r != 0"],
      "prompt": "Expand and simplify ${a}({v}{b:+}){c:+}({v}{d:+})$.",
      "widget": { "kind": "expression", "answer": "{poly(v; k, r)}", "form": "simplified", "keyboard": "algebra" },
      "wrong": [
        { "id": "second-constant-kept", "tex": "{poly(v; k, ab + d)}", "line": "The ${c}$ multiplies everything in its bracket, so ${c} \\times {d:()} = {cd}$." },
        { "id": "second-sign-slip", "tex": "{poly(v; k, ab - cd)}", "line": "Keep the sign with the ${c}$: ${c} \\times {d:()} = {cd}$." }
      ],
      "solution": [
        "${a}({v}{b:+}) = {poly(v; a, ab)}$ and ${c}({v}{d:+}) = {poly(v; c, cd)}$.",
        "Collect the ${v}$ terms, ${a} {c:+} = {k}$, and the numbers, ${ab} {cd:+} = {r}$.",
        "So the answer is ${poly(v; k, r)}$."
      ]
    }
  ]
}
