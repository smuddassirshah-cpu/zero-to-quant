{
  "id": "fluency-l1-letters-for-numbers",
  "course": "equations",
  "lesson": "l1-letters-for-numbers",
  "title": "Fluency: authoring reach",
  "sample": true,
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "fraction-lowest",
      "weight": 1,
      "skill": "write a quotient as a fraction in lowest terms",
      "vars": {
        "g": {
          "int": [
            2,
            6
          ]
        },
        "p": {
          "int": [
            1,
            11
          ]
        },
        "q": {
          "int": [
            2,
            11
          ]
        }
      },
      "let": {
        "a": "p * g",
        "c": "q * g"
      },
      "where": [
        "gcd(p, q) == 1"
      ],
      "prompt": "Write $\\frac{{{a}}}{{{c}}}$ as a fraction in lowest terms.",
      "widget": {
        "kind": "expression",
        "answer": "\\frac{{{p}}}{{{q}}}",
        "form": "fraction"
      },
      "wrong": [
        {
          "id": "wrong-divisor",
          "tex": "\\frac{{{p}}}{{{c}}}",
          "line": "You divided the top by {g} but not the bottom."
        }
      ],
      "solution": [
        "Both {a} and {c} divide by {g}.",
        "So $\\frac{{{a}}}{{{c}}} = \\frac{{{p}}}{{{q}}}$."
      ]
    },
    {
      "id": "exact-angle",
      "weight": 1,
      "skill": "write a degree angle in radians, exactly",
      "vars": {
        "d": {
          "int": [
            1,
            179
          ]
        }
      },
      "let": {
        "g": "gcd(d, 180)",
        "p": "d / g",
        "q": "180 / g"
      },
      "prompt": "Write ${d}^\\circ$ in radians, exactly.",
      "widget": {
        "kind": "expression",
        "answer": "\\frac{{{p:c}\\pi}}{{{q}}}",
        "form": "exact-angle"
      },
      "wrong": [
        {
          "id": "inverted",
          "tex": "\\frac{{{q:c}\\pi}}{{{p}}}",
          "line": "Multiply by $\\frac{{\\pi}}{{180}}$, not by its inverse.",
          "when": "p != q"
        }
      ],
      "solution": [
        "${d}^\\circ = {d} \\times \\frac{{\\pi}}{{180}}$, cancelled to lowest terms.",
        "So ${d}^\\circ = \\frac{{{p:c}\\pi}}{{{q}}}$ radians."
      ]
    },
    {
      "id": "mono-derivative",
      "weight": 1,
      "skill": "differentiate a power of a letter",
      "vars": {
        "c": {
          "int": [
            -4,
            4
          ],
          "not": [
            0
          ]
        },
        "n": {
          "int": [
            1,
            5
          ]
        },
        "v": {
          "pick": [
            "x",
            "y",
            "t"
          ]
        }
      },
      "let": {
        "d": "c * n"
      },
      "prompt": "Differentiate ${mono(v; c, n)}$ with respect to ${v}$.",
      "widget": {
        "kind": "expression",
        "answer": "{mono(v; d, n - 1)}"
      },
      "wrong": [
        {
          "id": "forgot-power",
          "tex": "{mono(v; c, n - 1)}",
          "line": "You lowered the power but did not multiply by it.",
          "when": "n > 1"
        },
        {
          "id": "kept-power",
          "tex": "{mono(v; d, n)}",
          "line": "You multiplied by the power but did not lower it."
        }
      ],
      "solution": [
        "Multiply by the power {n}: ${c} \\times {n} = {d}$.",
        "Lower the power by one: ${mono(v; d, n - 1)}$."
      ]
    },
    {
      "id": "log-significant",
      "weight": 1,
      "skill": "solve a power equation with logarithms",
      "vars": {
        "a": {
          "int": [
            2,
            9
          ]
        },
        "b": {
          "int": [
            10,
            400
          ]
        }
      },
      "let": {
        "x": "ln(b) / ln(a)"
      },
      "where": [
        "x >= 1",
        "x < 10"
      ],
      "prompt": "Solve ${a}^x = {b}$. Give $x$ to 3 significant figures.",
      "widget": {
        "kind": "numeric",
        "answer": "{x:sf3}",
        "tol": {
          "abs": 0.0051
        }
      },
      "wrong": [
        {
          "id": "divided",
          "value": "{b / a:sf3}",
          "tol": {
            "abs": 0.0051
          },
          "line": "You divided {b} by {a} instead of using logarithms.",
          "when": "abs(b / a - x) > 0.05"
        }
      ],
      "solution": [
        "Take logarithms: $x = \\frac{{\\ln {b}}}{{\\ln {a}}}$.",
        "So $x = {x:sf3}$ to 3 significant figures."
      ]
    },
    {
      "id": "height-with-sine",
      "weight": 1,
      "skill": "find a height from an angle",
      "vars": {
        "h": {
          "int": [
            5,
            40
          ]
        },
        "t": {
          "int": [
            10,
            80
          ]
        },
        "wk": {
          "pick": [
            [
              "ground",
              0
            ],
            [
              "wall",
              1
            ]
          ],
          "as": [
            "w",
            "k"
          ]
        }
      },
      "let": {
        "ang": "if(k == 1, 90 - t, t)",
        "rad": "ang * pi / 180",
        "ht": "h * sin(rad)"
      },
      "prompt": "A ladder of length {h} metres makes an angle of ${t}^\\circ$ with the {w}. How high does it reach, to 2 decimal places?",
      "widget": {
        "kind": "numeric",
        "answer": "{ht:dp2}",
        "tol": {
          "abs": 0.0051
        },
        "unit": "m"
      },
      "wrong": [
        {
          "id": "used-cosine",
          "value": "{h * cos(rad):dp2}",
          "tol": {
            "abs": 0.0051
          },
          "line": "You used cosine, which gives the distance along the ground.",
          "when": "abs(ht - h * cos(rad)) > 0.02"
        }
      ],
      "solution": [
        "The height is opposite an angle of ${ang}^\\circ$, so use sine.",
        "${h} \\times \\sin {ang}^\\circ = {ht:dp2}$ metres."
      ]
    },
    {
      "id": "divide-reject",
      "weight": 1,
      "skill": "divide one whole number by another",
      "vars": {
        "a": {
          "int": [
            1,
            30
          ]
        },
        "b": {
          "int": [
            0,
            9
          ]
        }
      },
      "let": {
        "r": "a / b"
      },
      "prompt": "Work out ${a} \\div {b}$ to 3 decimal places.",
      "widget": {
        "kind": "numeric",
        "answer": "{r:dp3}",
        "tol": {
          "abs": 0.0005
        }
      },
      "wrong": [
        {
          "id": "flipped",
          "value": "{b / a:dp3}",
          "tol": {
            "abs": 0.0005
          },
          "line": "You divided {b} by {a}.",
          "when": "a != b"
        }
      ],
      "solution": [
        "${a} \\div {b} = {r:dp3}$ to 3 decimal places."
      ]
    },
    {
      "id": "falling-product",
      "weight": 1,
      "skill": "evaluate a count of ordered choices",
      "vars": {
        "n": {
          "int": [
            5,
            20
          ]
        },
        "r": {
          "int": [
            2,
            5
          ]
        }
      },
      "prompt": "How many ways can {r} people be chosen in order from {n}?",
      "widget": {
        "kind": "numeric",
        "answer": "{fact(n) / fact(n - r)}",
        "tol": {
          "abs": 0
        }
      },
      "wrong": [
        {
          "id": "unordered",
          "value": "{comb(n, r)}",
          "tol": {
            "abs": 0
          },
          "line": "That counts groups, but the order matters here."
        }
      ],
      "solution": [
        "Multiply down from {n} for {r} factors: ${falling(n; r)}$.",
        "That is {fact(n) / fact(n - r)}."
      ]
    },
    {
      "id": "fractional-coefficient",
      "weight": 1,
      "skill": "solve an equation with a fractional coefficient",
      "vars": {
        "m": {
          "pick": [
            1,
            -1,
            2,
            -2,
            0.5,
            -0.5,
            3,
            -3,
            0.25,
            1.5
          ]
        },
        "r": {
          "int": [
            1,
            15
          ]
        },
        "v": {
          "pick": [
            "x",
            "y",
            "t"
          ]
        }
      },
      "prompt": "Solve ${m:cfrac}{v} = {r}$.",
      "widget": {
        "kind": "numeric",
        "answer": "{r / m}",
        "tol": {
          "abs": 0.0005
        }
      },
      "wrong": [
        {
          "id": "multiplied",
          "value": "{r * m}",
          "tol": {
            "abs": 0.0005
          },
          "line": "You multiplied by {m} instead of dividing.",
          "when": "abs(r * m - r / m) > 0.01"
        }
      ],
      "solution": [
        "Divide both sides by ${m:(frac)}$.",
        "${v} = {r} \\div {m:(frac)} = {r / m:frac}$."
      ]
    },
    {
      "id": "vector-sum",
      "weight": 1,
      "skill": "add two vectors",
      "vars": {
        "a": {
          "int": [
            1,
            9
          ]
        },
        "b": {
          "int": [
            1,
            9
          ]
        },
        "c": {
          "int": [
            1,
            9
          ]
        },
        "e": {
          "int": [
            1,
            9
          ]
        }
      },
      "where": [
        "a != c",
        "b != e"
      ],
      "prompt": "Work out $({a}, {b}) + ({c}, {e})$ as a vector.",
      "widget": {
        "kind": "expression",
        "answer": "({a + c}, {b + e})"
      },
      "wrong": [
        {
          "id": "subtracted",
          "tex": "({a - c}, {b - e})",
          "line": "You subtracted the vectors instead of adding them."
        }
      ],
      "solution": [
        "Add the first entries: ${a} + {c} = {a + c}$.",
        "Add the second entries: ${b} + {e} = {b + e}$."
      ]
    }
  ]
}