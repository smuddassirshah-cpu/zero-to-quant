{
  "id": "fluency-l3-opening-brackets",
  "course": "equations",
  "lesson": "l3-opening-brackets",
  "title": "Fluency: opening brackets",
  "sample": true,
  "n": 20,
  "pass": 0.9,
  "minutes": 10,
  "families": [
    {
      "id": "expand-single",
      "weight": 2,
      "skill": "expand a single bracket",
      "vars": {
        "a": { "int": [2, 9] },
        "b": { "int": [-9, 9], "not": [0] },
        "v": { "pick": ["x", "y", "t"] }
      },
      "let": { "p": "a*b" },
      "prompt": "Expand ${a}({v}{b:+})$.",
      "widget": { "kind": "expression", "answer": "{a}{v}{p:+}", "form": "expanded" },
      "wrong": [
        { "id": "first-term-only", "tex": "{a}{v}{b:+}", "line": "You multiplied only the first term by {a}." }
      ],
      "solution": [
        "${a} \\times {v} = {a}{v}$ and ${a} \\times {b:()} = {p}$.",
        "So ${a}({v}{b:+}) = {a}{v}{p:+}$."
      ]
    },
    {
      "id": "factorise-common",
      "weight": 2,
      "skill": "factorise by a common factor",
      "vars": {
        "a": { "int": [2, 9] },
        "b": { "int": [-9, 9], "not": [0] },
        "v": { "pick": ["x", "y", "t"] }
      },
      "let": { "p": "a*b" },
      "prompt": "Factorise ${a}{v}{p:+}$.",
      "widget": { "kind": "expression", "answer": "{a}({v}{b:+})", "form": "factorised" },
      "wrong": [
        { "id": "constant-unchanged", "tex": "{a}({v}{p:+})", "line": "You took {a} out of the first term but left {p:()} as it was." }
      ],
      "solution": [
        "Both terms share the factor {a}: ${a}{v} = {a} \\times {v}$ and ${p} = {a} \\times {b:()}$.",
        "So ${a}{v}{p:+} = {a}({v}{b:+})$."
      ]
    },
    {
      "id": "antiderivative-power",
      "weight": 1,
      "skill": "integrate a power",
      "vars": {
        "k": { "int": [2, 9] },
        "m": { "int": [1, 9] }
      },
      "let": { "c": "m*(k+1)", "k1": "k+1" },
      "prompt": "Find an antiderivative of ${c}x^{{{k}}}$.",
      "widget": { "kind": "expression", "answer": "{m:c}x^{{{k1}}}", "upToConstant": true },
      "wrong": [
        { "id": "power-not-raised", "tex": "{c}x^{{{k1}}}", "line": "You raised the power but did not divide by {k1}." }
      ],
      "solution": [
        "Raise the power to {k1} and divide by {k1}: ${c}x^{{{k1}}} \\div {k1} = {m:c}x^{{{k1}}}$."
      ]
    },
    {
      "id": "evaluate-linear",
      "weight": 1,
      "skill": "substitute into a linear expression",
      "vars": {
        "a": { "int": [2, 9] },
        "b": { "int": [-6, 6], "not": [0] },
        "x": { "int": [-5, 5], "not": [0, 1] }
      },
      "let": { "r": "a + b*x" },
      "where": ["a + b*x != (a + b)*x", "a + b*x != a - b*x"],
      "prompt": "Work out ${a}{b:+c}x$ when $x = {x}$.",
      "widget": { "kind": "numeric", "answer": "{r}", "tol": { "abs": 0 } },
      "wrong": [
        { "id": "added-first", "value": "{(a + b)*x}", "line": "Multiply {b:()} by {x:()} before you add {a}." },
        { "id": "sign-slip", "value": "{a - b*x}", "line": "Check the sign of the second term." }
      ],
      "solution": [
        "${b:()} \\times {x:()} = {b*x}$.",
        "${a} + {b*x:()} = {r}$."
      ]
    },
    {
      "id": "add-fractions",
      "weight": 1,
      "skill": "add two fractions",
      "vars": {
        "p": { "int": [1, 5] },
        "q": { "int": [2, 7] },
        "r": { "int": [1, 5] },
        "s": { "int": [2, 7] }
      },
      "let": { "total": "p/q + r/s" },
      "where": ["q != s", "p < q", "r < s", "total != (p + r)/(q + s)"],
      "prompt": "Work out $\\frac{{{p}}}{{{q}}} + \\frac{{{r}}}{{{s}}}$. Give a fraction or a decimal.",
      "widget": { "kind": "numeric", "answer": "{total}", "tol": { "abs": 0.0005 }, "accept": "${total:frac}$, or a decimal within 0.0005" },
      "wrong": [
        { "id": "added-tops-and-bottoms", "value": "{(p + r)/(q + s)}", "tol": { "abs": 0.0005 }, "line": "Do not add the tops and the bottoms: give both fractions the same bottom first." }
      ],
      "solution": [
        "A common bottom is ${q*s}$: $\\frac{{{p*s}}}{{{q*s}}} + \\frac{{{r*q}}}{{{q*s}}}$.",
        "That is ${total:frac}$."
      ]
    }
  ]
}
